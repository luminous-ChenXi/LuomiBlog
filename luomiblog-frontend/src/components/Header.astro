---
import ThemeSwitcher from './ThemeSwitcher.vue';
import UserAuth from './UserAuth.vue';

// 获取当前页面路径
const currentPath = Astro.url.pathname;

// 导航项配置
const navItems = [
  { href: '/', label: '首页' },
  { href: '/archive', label: '归档' },
  { href: '/timeline', label: '时间线' },
  { href: '/gallery', label: '相册' },
  { href: '/project', label: '项目' },
  { href: '/skill', label: '技能' },
  { href: '/equipment', label: '设备' },
  { href: '/anime', label: '番剧' },
  { href: '/diary', label: '日记' },
  { href: '/about', label: '关于' },
  { href: '/friends', label: '友链' },
];

// 判断是否为当前页面
const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === '/';
  }
  // 精确匹配路径，避免 /a 匹配 /archive
  return currentPath === href || currentPath.startsWith(href + '/');
};
---

<header class="navbar" id="navbar">
  <div class="navbar-container">
    <!-- 移动端汉堡菜单按钮 -->
    <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="打开菜单">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <!-- 左侧：网站名 -->
    <div class="navbar-brand">
      <a href="/" class="brand-link">辰汐小站</a>
    </div>

    <!-- 中间：导航菜单 (桌面端) -->
    <nav class="navbar-nav desktop-nav">
      {navItems.slice(0, 7).map((item) => (
        <a 
          href={item.href} 
          class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
        >
          {item.label}
        </a>
      ))}
      <div class="nav-more-dropdown">
        <button class="nav-link more-btn" aria-label="更多">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="1"/>
            <circle cx="19" cy="12" r="1"/>
            <circle cx="5" cy="12" r="1"/>
          </svg>
        </button>
        <div class="dropdown-menu">
          {navItems.slice(7).map((item) => (
            <a 
              href={item.href} 
              class={`dropdown-link ${isActive(item.href) ? 'active' : ''}`}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- 右侧：操作区 -->
    <div class="navbar-actions">
      <button class="action-btn search-btn" aria-label="搜索">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
      </button>
      <ThemeSwitcher client:load />
      
      <!-- 用户认证区域 -->
      <UserAuth client:load />
    </div>
  </div>
</header>

<!-- 移动端侧边栏菜单 -->
<div class="mobile-sidebar" id="mobile-sidebar">
  <div class="mobile-sidebar-overlay" id="mobile-sidebar-overlay"></div>
  <div class="mobile-sidebar-content">
    <div class="mobile-sidebar-header">
      <a href="/" class="mobile-brand-link">辰汐小站</a>
      <button class="mobile-close-btn" id="mobile-close-btn" aria-label="关闭菜单">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <nav class="mobile-nav">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`mobile-nav-link ${isActive(item.href) ? 'active' : ''}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</div>

<style>
  /* 导航栏基础样式 */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 16px 24px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 暗色主题：渐变背景 */
  [data-theme="dark"] .navbar {
    background: linear-gradient(to bottom,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.3) 50%,
      transparent 100%);
  }

  /* 明亮主题：透明背景 */
  [data-theme="light"] .navbar {
    background: transparent;
  }

  /* 滚动后状态 */
  .navbar.scrolled {
    padding: 12px 24px;
    background: transparent;
  }

  .navbar.scrolled .navbar-container {
    background: color-mix(in srgb, var(--color-bg) 95%, transparent);
    backdrop-filter: blur(20px);
    border-radius: 50px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    padding: 8px 24px;
  }

  [data-theme="dark"] .navbar.scrolled .navbar-container {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  /* 容器 */
  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 移动端菜单按钮 - 始终显示 */
  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    cursor: pointer;
    gap: 5px;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .mobile-menu-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .hamburger-bar {
    display: block;
    width: 20px;
    height: 2.5px;
    border-radius: 2px;
    transition: all 0.3s ease;
    background: white;
  }

  /* 滚动后样式 */
  .navbar.scrolled .mobile-menu-btn {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.1);
  }

  .navbar.scrolled .mobile-menu-btn:hover {
    background: rgba(255, 107, 157, 0.1);
    border-color: rgba(255, 107, 157, 0.2);
  }

  .navbar.scrolled .hamburger-bar {
    background: var(--color-text);
  }

  /* 品牌名 */
  .navbar-brand {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .brand-link {
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 700;
    transition: color 0.3s ease;
  }

  /* 未滚动时 - 暗色主题：白色文字 */
  [data-theme="dark"] .brand-link {
    color: white;
  }

  /* 未滚动时 - 明亮主题：深色文字 */
  [data-theme="light"] .brand-link {
    color: var(--color-text);
  }

  /* 滚动后：使用主题文字颜色 */
  .navbar.scrolled .brand-link {
    color: var(--color-text);
  }

  /* 导航菜单 */
  .navbar-nav {
    flex: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 16px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 20px;
    transition: all 0.3s ease;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  /* 未滚动时 - 暗色主题：白色文字 */
  [data-theme="dark"] .nav-link {
    color: rgba(255, 255, 255, 0.9);
  }

  [data-theme="dark"] .nav-link:hover {
    color: white;
    background: rgba(255, 255, 255, 0.1);
  }

  [data-theme="dark"] .nav-link.active {
    color: white;
    background: rgba(255, 255, 255, 0.2);
    font-weight: 600;
  }

  /* 未滚动时 - 明亮主题：深色文字 */
  [data-theme="light"] .nav-link {
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  [data-theme="light"] .nav-link:hover {
    color: var(--color-brand-primary);
    background: rgba(255, 107, 157, 0.1);
  }

  [data-theme="light"] .nav-link.active {
    color: var(--color-brand-primary);
    background: rgba(255, 107, 157, 0.15);
    font-weight: 600;
  }

  /* 滚动后 - 使用主题颜色 */
  .navbar.scrolled .nav-link {
    color: var(--color-text-secondary);
  }

  .navbar.scrolled .nav-link:hover {
    color: var(--color-brand-primary);
    background: rgba(255, 107, 157, 0.08);
  }

  .navbar.scrolled .nav-link.active {
    color: var(--color-brand-primary);
    background: rgba(255, 107, 157, 0.12);
  }

  /* 操作区 */
  .navbar-actions {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  /* 未滚动时 - 暗色主题 */
  [data-theme="dark"] .action-btn {
    color: rgba(255, 255, 255, 0.9);
  }

  [data-theme="dark"] .action-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  /* 未滚动时 - 明亮主题 */
  [data-theme="light"] .action-btn {
    color: var(--color-text-secondary);
  }

  [data-theme="light"] .action-btn:hover {
    background: rgba(255, 107, 157, 0.1);
    color: var(--color-brand-primary);
  }

  /* 滚动后 */
  .navbar.scrolled .action-btn {
    color: var(--color-text-secondary);
  }

  .navbar.scrolled .action-btn:hover {
    background: rgba(255, 107, 157, 0.08);
    color: var(--color-brand-primary);
  }

  /* 下拉菜单 */
  .nav-more-dropdown {
    position: relative;
  }

  .more-btn {
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 8px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 8px;
    min-width: 120px;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    z-index: 1001;
  }

  .nav-more-dropdown:hover .dropdown-menu,
  .nav-more-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 8px 16px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
  }

  .dropdown-link:hover,
  .dropdown-link.active {
    background: rgba(255, 107, 157, 0.1);
    color: var(--color-brand-primary);
  }

  /* 移动端侧边栏 */
  .mobile-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0.3s ease;
  }

  .mobile-sidebar.open {
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-sidebar-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mobile-sidebar.open .mobile-sidebar-overlay {
    opacity: 1;
  }

  .mobile-sidebar-content {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 280px;
    max-width: 80vw;
    background: var(--color-card);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .mobile-sidebar.open .mobile-sidebar-content {
    transform: translateX(0);
  }

  .mobile-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-brand-link {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }

  .mobile-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mobile-close-btn:hover {
    background: rgba(255, 107, 157, 0.1);
    color: var(--color-brand-primary);
  }

  .mobile-nav {
    flex: 1;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow-y: auto;
  }

  .mobile-nav-link {
    display: block;
    padding: 12px 16px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
  }

  .mobile-nav-link:hover {
    background: rgba(255, 107, 157, 0.08);
    color: var(--color-brand-primary);
  }

  .mobile-nav-link.active {
    background: rgba(255, 107, 157, 0.12);
    color: var(--color-brand-primary);
    font-weight: 600;
  }

  /* 响应式 - 移动端 */
  @media (max-width: 768px) {
    .navbar {
      padding: 12px 16px;
    }

    .navbar.scrolled {
      padding: 8px 16px;
    }

    .navbar-container {
      padding: 0;
    }

    .navbar.scrolled .navbar-container {
      border-radius: 12px;
      padding: 8px 16px;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .navbar-brand {
      flex: 1;
      justify-content: flex-start;
      padding-left: 12px;
    }

    .navbar-actions {
      flex: 0 0 auto;
      gap: 4px;
    }

    .action-btn {
      width: 36px;
      height: 36px;
    }
  }

  @media (max-width: 480px) {
    .brand-link {
      font-size: 1.1rem;
    }

    .navbar-actions {
      gap: 2px;
    }

    .action-btn {
      width: 32px;
      height: 32px;
    }

    .action-btn svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

<script>
  // 导航栏滚动效果
  const navbar = document.getElementById('navbar');
  
  if (navbar) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        navbar.classList.add('scrolled');
      } else {
        navbar.classList.remove('scrolled');
      }
    });
  }

  // 移动端侧边栏控制
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileSidebar = document.getElementById('mobile-sidebar');
  const mobileCloseBtn = document.getElementById('mobile-close-btn');
  const mobileOverlay = document.getElementById('mobile-sidebar-overlay');

  function openMobileSidebar() {
    if (mobileSidebar) {
      mobileSidebar.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeMobileSidebar() {
    if (mobileSidebar) {
      mobileSidebar.classList.remove('open');
      document.body.style.overflow = '';
    }
  }

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('click', openMobileSidebar);
  }

  if (mobileCloseBtn) {
    mobileCloseBtn.addEventListener('click', closeMobileSidebar);
  }

  if (mobileOverlay) {
    mobileOverlay.addEventListener('click', closeMobileSidebar);
  }

  // 点击移动端导航链接后自动关闭侧边栏
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
  mobileNavLinks.forEach(link => {
    link.addEventListener('click', closeMobileSidebar);
  });

  // ESC 键关闭侧边栏
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileSidebar?.classList.contains('open')) {
      closeMobileSidebar();
    }
  });

  // 登录弹窗控制 - 使用全局函数
  const loginBtn = document.getElementById('login-btn');

  if (loginBtn) {
    loginBtn.addEventListener('click', (e) => {
      e.preventDefault();
      // 调用全局函数打开登录弹窗
      const w = window as any;
      if (typeof w.openLoginModal === 'function') {
        w.openLoginModal();
      } else {
        // 如果函数还未加载，触发自定义事件
        window.dispatchEvent(new CustomEvent('open-login-modal'));
      }
    });
  }
</script>
