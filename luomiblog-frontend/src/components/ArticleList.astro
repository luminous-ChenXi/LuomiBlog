---
import ArticleCard from './ArticleCard.astro';
import ViewModeSwitcher from './ViewModeSwitcher.vue';
import { getCollection } from 'astro:content';

// 获取所有文章
const allPosts = await getCollection('blog');

// 按日期排序（最新的在前）
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});

// 转换为 ArticleCard 需要的格式
const articles = sortedPosts.map(post => ({
  title: post.data.title,
  summary: post.data.description,
  date: new Date(post.data.pubDate).toISOString().split('T')[0],
  category: post.data.category || '未分类',
  tags: post.data.tags || [],
  slug: post.slug,
  views: post.data.views || 0,
  comments: post.data.comments || 0,
  likes: post.data.likes || 0,
  cover: post.data.cover,
  author: post.data.author || '辰汐',
}));
---

<section class="article-section" id="article-section">
  <div class="section-container">
    <div class="section-header">
      <div class="section-title-wrapper">
        <div class="section-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
        </div>
        <h2 class="section-title">最新文章</h2>
      </div>
      <div class="section-actions">
        <ViewModeSwitcher client:load modelValue="grid" />
        <a href="/articles" class="view-all">
          <span>查看全部</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
    <div class="article-grid" id="article-grid">
      {articles.length > 0 ? (
        articles.map(article => (
          <ArticleCard {...article} />
        ))
      ) : (
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          <p>暂无文章</p>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  // 从本地存储读取视图模式
  const savedMode = localStorage.getItem('articleViewMode') || 'grid';
  const articleGrid = document.getElementById('article-grid');
  
  if (articleGrid) {
    articleGrid.setAttribute('data-view-mode', savedMode);
  }

  // 监听视图模式变化
  window.addEventListener('viewModeChange', ((e: Event) => {
    const customEvent = e as CustomEvent;
    const mode = customEvent.detail;
    if (articleGrid) {
      articleGrid.setAttribute('data-view-mode', mode);
    }
  }) as EventListener);
</script>

<style>
  .article-section {
    padding: 40px 0 80px;
    position: relative;
  }

  .section-container {
    width: 100%;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .section-title-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-icon {
    width: 40px;
    height: 40px;
    background: var(--gradient-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: var(--shadow-brand);
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    position: relative;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 40px;
    height: 3px;
    background: var(--gradient-primary);
    border-radius: 2px;
  }

  .section-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--color-card);
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .view-all:hover {
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }

  .view-all svg {
    transition: transform var(--transition-base);
  }

  .view-all:hover svg {
    transform: translateX(4px);
  }

  .article-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 文章卡片动画 */
  .article-grid :global(.article-card) {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    animation: cardFadeIn 0.5s ease-out;
  }

  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 网格视图模式 - 两列 */
  .article-grid[data-view-mode="grid"] {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    animation: gridLayoutIn 0.4s ease-out;
  }

  @keyframes gridLayoutIn {
    from {
      gap: 40px;
      opacity: 0.8;
    }
    to {
      gap: 24px;
      opacity: 1;
    }
  }

  /* 列表视图模式 - 单列 */
  .article-grid[data-view-mode="list"] {
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: listLayoutIn 0.4s ease-out;
  }

  @keyframes listLayoutIn {
    from {
      gap: 40px;
      opacity: 0.8;
    }
    to {
      gap: 20px;
      opacity: 1;
    }
  }

  .empty-state {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    color: var(--color-text-tertiary);
    gap: 16px;
  }

  .empty-state svg {
    opacity: 0.5;
  }

  @media (max-width: 1200px) {
    .article-grid {
      gap: 20px;
    }
  }

  @media (max-width: 968px) {
    .article-section {
      padding: 32px 0 60px;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 32px;
    }

    .section-title {
      font-size: 1.5rem;
    }

    .article-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
