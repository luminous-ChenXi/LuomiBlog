---
---

<section class="banner-wrapper">
  <!-- 背景图片 -->
  <div class="banner-image">
    <img 
      src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&q=80" 
      alt="Banner Background"
      class="banner-bg-img"
    />
    <!-- 暗色遮罩 -->
    <div class="banner-overlay"></div>
  </div>
  
  <!-- 文字覆盖层 -->
  <div class="banner-text-overlay">
    <div class="banner-content">
      <div class="banner-text-container">
        <!-- 主标题 -->
        <h1 class="banner-title">
          Hello！欢迎来到辰汐小站！
        </h1>
        <!-- 副标题 -->
        <p class="banner-subtitle">
          没有比脚更长的路，没有比人更高的山。
        </p>
        <!-- 装饰线 -->
        <div class="banner-divider">
          <span class="divider-line"></span>
          <span class="divider-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
          </span>
          <span class="divider-line"></span>
        </div>
      </div>
    </div>
  </div>
  
  <!-- 水波纹 - 参考 lolimeow-master 实现 -->
  <div class="banner-waves">
    <svg class="waves" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
      <defs>
        <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"></path>
      </defs>
      <g class="parallax">
        <use xlink:href="#gentle-wave" x="48" y="0"></use>
        <use xlink:href="#gentle-wave" x="48" y="3"></use>
        <use xlink:href="#gentle-wave" x="48" y="5"></use>
        <use xlink:href="#gentle-wave" x="48" y="7"></use>
      </g>
    </svg>
  </div>
</section>

<style>
  /* Banner 容器 */
  .banner-wrapper {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
  }

  /* 背景图片 */
  .banner-image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .banner-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    animation: slowZoom 20s ease-in-out infinite alternate;
  }

  @keyframes slowZoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.1); }
  }

  /* 暗色遮罩 */
  .banner-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    z-index: 1;
  }

  /* 文字覆盖层 */
  .banner-text-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .banner-content {
    width: 100%;
    max-width: 1200px;
    padding: 0 24px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .banner-text-container {
    text-align: center;
    max-width: 800px;
    animation: fadeInUp 1s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 主标题 */
  .banner-title {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 700;
    color: white;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
    margin-bottom: 1rem;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  /* 副标题 */
  .banner-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  /* 装饰分割线 */
  .banner-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .divider-line {
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
  }

  .divider-icon {
    color: rgba(255, 255, 255, 0.7);
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  /* 水波纹 - 参考 lolimeow-master 实现 */
  .banner-waves {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 10;
    line-height: 0;
  }

  .banner-waves .waves {
    position: relative;
    width: 100%;
    height: 100px;
    margin-bottom: -7px;
  }

  .banner-waves .parallax > use {
    fill: var(--color-bg, #ffffff);
    animation: move-forever 25s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
    transition: fill 0.4s cubic-bezier(0.345, 0.045, 0.345, 1);
  }

  .banner-waves .parallax > use:nth-child(1) {
    animation-delay: -2s;
    animation-duration: 7s;
    opacity: 0.7;
  }

  .banner-waves .parallax > use:nth-child(2) {
    animation-delay: -3s;
    animation-duration: 10s;
    opacity: 0.5;
  }

  .banner-waves .parallax > use:nth-child(3) {
    animation-delay: -4s;
    animation-duration: 13s;
    opacity: 0.3;
  }

  .banner-waves .parallax > use:nth-child(4) {
    animation-delay: -5s;
    animation-duration: 20s;
  }

  @keyframes move-forever {
    0% { transform: translate3d(-90px, 0, 0); }
    100% { transform: translate3d(85px, 0, 0); }
  }

  /* 暗色主题适配 */
  [data-theme="dark"] .banner-waves .parallax > use {
    fill: var(--color-bg, #0f0f1a);
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .banner-wrapper {
      min-height: 500px;
    }

    .banner-content {
      padding: 0 16px;
    }

    .banner-divider {
      gap: 0.5rem;
    }

    .divider-line {
      width: 40px;
    }

    .banner-waves .waves {
      height: 60px;
    }
  }
</style>
