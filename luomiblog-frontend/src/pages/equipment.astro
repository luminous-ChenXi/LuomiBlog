---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 设备数据
const equipmentCategories = [
  {
    name: '主力设备',
    items: [
      {
        name: 'MacBook Pro 14"',
        spec: 'M3 Pro / 18GB / 512GB',
        description: '主力开发机，性能强劲，续航优秀',
        icon: 'laptop'
      },
      {
        name: 'Dell U2723QX',
        spec: '27英寸 4K IPS',
        description: '外接显示器，色彩准确，适合设计工作',
        icon: 'monitor'
      }
    ]
  },
  {
    name: '输入设备',
    items: [
      {
        name: 'Keychron K3',
        spec: '矮轴机械键盘 / 红轴',
        description: '便携机械键盘，手感舒适，支持多设备切换',
        icon: 'keyboard'
      },
      {
        name: 'Logitech MX Master 3S',
        spec: '无线鼠标',
        description: '人体工学设计，滚轮顺滑，适合长时间使用',
        icon: 'mouse'
      }
    ]
  },
  {
    name: '音频设备',
    items: [
      {
        name: 'AirPods Pro 2',
        spec: '主动降噪耳机',
        description: '日常通勤必备，降噪效果出色',
        icon: 'headphones'
      },
      {
        name: 'Sony WH-1000XM5',
        spec: '头戴式降噪耳机',
        description: '专注工作时的首选，音质优秀',
        icon: 'headphones'
      }
    ]
  },
  {
    name: '其他设备',
    items: [
      {
        name: 'iPhone 15 Pro',
        spec: '256GB / 原色钛金属',
        description: '日常主力手机，拍照效果出色',
        icon: 'smartphone'
      },
      {
        name: 'iPad Air 5',
        spec: 'M1 / 256GB',
        description: '阅读、笔记、轻办公',
        icon: 'tablet'
      }
    ]
  }
];

const getIconSvg = (icon: string) => {
  const icons: Record<string, string> = {
    'laptop': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/></svg>',
    'monitor': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>',
    'keyboard': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V9z"/><path d="M2 13h2"/><path d="M20 13h2"/><path d="M10 13h4"/></svg>',
    'mouse': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="12" height="18" rx="6"/><line x1="12" x2="12" y1="7" y2="13"/></svg>',
    'headphones': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14v3a2 2 0 0 0 2 2h2v-5H3z"/><path d="M17 14v5h2a2 2 0 0 0 2-2v-3h-4z"/><path d="M21 12c0-4.97-4.03-9-9-9s-9 4.03-9 9"/></svg>',
    'smartphone': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/></svg>',
    'tablet': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="12" x2="12" y1="18" y2="18.01"/></svg>'
  };
  return icons[icon] || icons['laptop'];
};
---

<Layout title="我的设备 - LuomiBlog">
  <Header />
  <main class="equipment-page">
    <!-- 页面标题 -->
    <section class="page-header">
      <h1 class="page-title">我的设备</h1>
      <p class="page-subtitle">工欲善其事，必先利其器</p>
    </section>

    <!-- 设备列表 -->
    <section class="page-content">
      {equipmentCategories.map((category) => (
        <div class="equipment-category">
          <h2 class="equipment-category-title">{category.name}</h2>
          <div class="equipment-grid">
            {category.items.map((item) => (
              <div class="equipment-card">
                <div class="equipment-icon" set:html={getIconSvg(item.icon)} />
                <h3 class="equipment-name">{item.name}</h3>
                <p class="equipment-spec">{item.spec}</p>
                <p class="equipment-desc">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .equipment-page {
    min-height: calc(100vh - 200px);
    background: var(--color-bg);
  }

  .equipment-category {
    margin-bottom: 48px;
  }

  .equipment-category-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 24px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-brand-primary);
    display: inline-block;
  }

  .equipment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .equipment-card {
    background: var(--color-card);
    border-radius: var(--radius-lg);
    padding: 24px;
    border: 1px solid var(--color-border-soft);
    transition: all var(--transition-base);
  }

  .equipment-card:hover {
    border-color: var(--color-brand-primary);
    transform: translateY(-4px);
  }

  .equipment-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-md);
    margin-bottom: 16px;
    color: var(--color-brand-primary);
  }

  .equipment-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .equipment-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 8px 0;
  }

  .equipment-spec {
    font-size: 14px;
    color: var(--color-brand-primary);
    font-weight: 500;
    margin: 0 0 12px 0;
  }

  .equipment-desc {
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }
</style>
