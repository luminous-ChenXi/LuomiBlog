---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const skills = [
  { name: '前端开发', level: 90 },
  { name: 'Vue.js', level: 85 },
  { name: 'React', level: 80 },
  { name: 'Node.js', level: 75 },
  { name: 'UI/UX 设计', level: 70 }
];

const timeline = [
  {
    year: '2024',
    title: '辰汐博客上线',
    description: '基于 Astro + Vue 技术栈打造的个人博客正式上线，致力于分享技术文章和生活感悟。'
  },
  {
    year: '2023',
    title: '全栈开发转型',
    description: '从前端开发转向全栈开发，深入学习 Node.js 和后端技术，独立完成多个项目。'
  },
  {
    year: '2022',
    title: '前端开发工程师',
    description: '加入互联网公司，担任前端开发工程师，参与多个大型项目的前端架构设计。'
  },
  {
    year: '2021',
    title: '编程之旅开始',
    description: '大学期间开始接触编程，对 Web 开发产生浓厚兴趣，自学 HTML、CSS、JavaScript。'
  }
];
---

<Layout>
  <Header />
  <main class="about-page">
    <!-- Hero 区域 - 与首页一致 -->
    <section class="banner-wrapper">
      <!-- 背景图片 -->
      <div class="banner-image">
        <img 
          src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&q=80" 
          alt="Banner Background"
          class="banner-bg-img"
        />
        <div class="banner-overlay"></div>
      </div>
      
      <!-- 文字覆盖层 -->
      <div class="banner-text-overlay">
        <div class="banner-content">
          <div class="banner-text-container">
            <h1 class="banner-title">关于我</h1>
            <p class="banner-subtitle">一名热爱技术与设计的全栈开发者</p>
            <div class="banner-divider">
              <span class="divider-line"></span>
              <span class="divider-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                  <path d="M2 17l10 5 10-5"/>
                  <path d="M2 12l10 5 10-5"/>
                </svg>
              </span>
              <span class="divider-line"></span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- 水波纹 -->
      <div class="banner-waves">
        <svg class="waves" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
          <defs>
            <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"></path>
          </defs>
          <g class="parallax">
            <use xlink:href="#gentle-wave" x="48" y="0"></use>
            <use xlink:href="#gentle-wave" x="48" y="3"></use>
            <use xlink:href="#gentle-wave" x="48" y="5"></use>
            <use xlink:href="#gentle-wave" x="48" y="7"></use>
          </g>
        </svg>
      </div>
    </section>

    <!-- 个人介绍 -->
    <section class="about-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">Introduction</span>
          <h2 class="section-title">个人简介</h2>
        </div>
        <div class="intro-content">
          <p class="intro-text">
            大家好，我是辰汐（Chenxi），一名热爱技术与设计的全栈开发者。目前专注于前端开发领域，
            擅长使用 Vue.js、React 等现代前端框架构建用户界面。
          </p>
          <p class="intro-text">
            除了编程，我还对 UI/UX 设计、摄影和写作充满热情。创建这个博客的初衷是记录学习过程中的点滴，
            分享技术心得，同时也希望能结识更多志同道合的朋友。
          </p>
          <p class="intro-text">
            我相信技术应该服务于人，好的代码不仅要能运行，更要易于维护和理解。
            在日常工作中，我注重代码质量和团队协作，追求极致的用户体验。
          </p>
        </div>
      </div>
    </section>

    <!-- 技能展示 -->
    <section class="about-section skills-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">Skills</span>
          <h2 class="section-title">技术栈</h2>
        </div>
        <div class="skills-grid">
          {skills.map((skill) => (
            <div class="skill-item">
              <div class="skill-header">
                <span class="skill-name">{skill.name}</span>
                <span class="skill-level">{skill.level}%</span>
              </div>
              <div class="skill-bar">
                <div class="skill-progress" style={`width: ${skill.level}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 时间线 -->
    <section class="about-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">Timeline</span>
          <h2 class="section-title">成长历程</h2>
        </div>
        <div class="timeline">
          {timeline.map((item, index) => (
            <div class="timeline-item">
              <div class="timeline-marker">
                <span class="timeline-dot"></span>
                {index !== timeline.length - 1 && <span class="timeline-line"></span>}
              </div>
              <div class="timeline-content">
                <span class="timeline-year">{item.year}</span>
                <h3 class="timeline-title">{item.title}</h3>
                <p class="timeline-desc">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 联系方式 -->
    <section class="about-section contact-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">Contact</span>
          <h2 class="section-title">联系我</h2>
        </div>
        <div class="contact-grid">
          <a href="mailto:chenxi@example.com" class="contact-card">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </div>
            <span class="contact-label">电子邮箱</span>
            <span class="contact-value">chenxi@example.com</span>
          </a>
          <a href="#" class="contact-card">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                <path d="M9 18c-4.51 2-5-2-7-2"/>
              </svg>
            </div>
            <span class="contact-label">GitHub</span>
            <span class="contact-value">@chenxi</span>
          </a>
          <a href="#" class="contact-card">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>
              </svg>
            </div>
            <span class="contact-label">Twitter</span>
            <span class="contact-value">@chenxi_dev</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .about-page {
    min-height: calc(100vh - 200px);
    background: var(--color-bg);
  }

  /* Hero Banner - 与首页一致 */
  .banner-wrapper {
    position: relative;
    width: 100%;
    height: 60vh;
    min-height: 400px;
    overflow: hidden;
  }

  .banner-image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .banner-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    animation: slowZoom 20s ease-in-out infinite alternate;
  }

  @keyframes slowZoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.1); }
  }

  .banner-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    z-index: 1;
  }

  .banner-text-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .banner-content {
    width: 100%;
    max-width: 1200px;
    padding: 0 24px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .banner-text-container {
    text-align: center;
    max-width: 800px;
    animation: fadeInUp 1s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .banner-title {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 700;
    color: white;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
    margin-bottom: 1rem;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .banner-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .banner-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .divider-line {
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
  }

  .divider-icon {
    color: rgba(255, 255, 255, 0.7);
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  /* 水波纹 */
  .banner-waves {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 10;
    line-height: 0;
  }

  .banner-waves .waves {
    position: relative;
    width: 100%;
    height: 100px;
    margin-bottom: -7px;
  }

  .banner-waves .parallax > use {
    fill: var(--color-bg, #ffffff);
    animation: move-forever 25s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
    transition: fill 0.4s cubic-bezier(0.345, 0.045, 0.345, 1);
  }

  .banner-waves .parallax > use:nth-child(1) {
    animation-delay: -2s;
    animation-duration: 7s;
    opacity: 0.7;
  }

  .banner-waves .parallax > use:nth-child(2) {
    animation-delay: -3s;
    animation-duration: 10s;
    opacity: 0.5;
  }

  .banner-waves .parallax > use:nth-child(3) {
    animation-delay: -4s;
    animation-duration: 13s;
    opacity: 0.3;
  }

  .banner-waves .parallax > use:nth-child(4) {
    animation-delay: -5s;
    animation-duration: 20s;
  }

  @keyframes move-forever {
    0% { transform: translate3d(-90px, 0, 0); }
    100% { transform: translate3d(85px, 0, 0); }
  }

  [data-theme="dark"] .banner-waves .parallax > use {
    fill: var(--color-bg, #0f0f1a);
  }

  /* 通用区块样式 */
  .about-section {
    padding: 80px 24px;
  }

  .section-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ff6b9d;
    margin-bottom: 8px;
  }

  .section-title {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  /* 个人介绍 */
  .intro-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .intro-text {
    font-size: 16px;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin: 0 0 20px 0;
  }

  .intro-text:last-child {
    margin-bottom: 0;
  }

  /* 技能展示 */
  .skills-section {
    background: var(--color-bg-secondary);
  }

  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 600px;
    margin: 0 auto;
  }

  .skill-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .skill-name {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
  }

  .skill-level {
    font-size: 14px;
    color: #ff6b9d;
    font-weight: 600;
  }

  .skill-bar {
    height: 8px;
    background: var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }

  .skill-progress {
    height: 100%;
    background: linear-gradient(90deg, #ff6b9d 0%, #e87a9f 100%);
    border-radius: 4px;
    transition: width 1s ease;
  }

  /* 时间线 */
  .timeline {
    max-width: 700px;
    margin: 0 auto;
  }

  .timeline-item {
    display: flex;
    gap: 24px;
    padding-bottom: 40px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .timeline-dot {
    width: 16px;
    height: 16px;
    background: #ff6b9d;
    border-radius: 50%;
    border: 4px solid var(--color-bg);
    box-shadow: 0 0 0 2px #ff6b9d;
  }

  .timeline-line {
    width: 2px;
    flex: 1;
    background: var(--color-border);
    margin-top: 8px;
  }

  .timeline-content {
    flex: 1;
    padding-top: 2px;
  }

  .timeline-year {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(255, 107, 157, 0.1);
    color: #ff6b9d;
    font-size: 12px;
    font-weight: 600;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .timeline-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 8px 0;
  }

  .timeline-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* 联系方式 */
  .contact-section {
    background: var(--color-bg-secondary);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 32px 24px;
    background: var(--color-card);
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .contact-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .contact-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #ff6b9d 0%, #e87a9f 100%);
    border-radius: 12px;
    color: white;
  }

  .contact-icon svg {
    width: 24px;
    height: 24px;
  }

  .contact-label {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .contact-value {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
  }

  /* 响应式 */
  @media (max-width: 968px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .banner-wrapper {
      min-height: 350px;
    }

    .banner-content {
      padding: 0 16px;
    }

    .banner-divider {
      gap: 0.5rem;
    }

    .divider-line {
      width: 40px;
    }

    .banner-waves .waves {
      height: 60px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .about-section {
      padding: 60px 16px;
    }

    .section-title {
      font-size: 24px;
    }
  }
</style>