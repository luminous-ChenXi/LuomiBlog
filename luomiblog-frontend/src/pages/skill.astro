---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 技能数据
const skillCategories = [
  {
    name: '前端开发',
    skills: [
      { name: 'Vue.js', level: 90 },
      { name: 'React', level: 75 },
      { name: 'TypeScript', level: 85 },
      { name: 'Astro', level: 80 },
      { name: 'Tailwind CSS', level: 90 }
    ]
  },
  {
    name: '后端开发',
    skills: [
      { name: 'Spring Boot', level: 85 },
      { name: 'Java', level: 80 },
      { name: 'Node.js', level: 70 },
      { name: 'Python', level: 65 }
    ]
  },
  {
    name: '数据库',
    skills: [
      { name: 'MySQL', level: 85 },
      { name: 'Redis', level: 75 },
      { name: 'MongoDB', level: 60 }
    ]
  },
  {
    name: 'DevOps',
    skills: [
      { name: 'Docker', level: 75 },
      { name: 'Git', level: 85 },
      { name: 'Linux', level: 70 },
      { name: 'Nginx', level: 65 }
    ]
  }
];

const tools = [
  { name: 'VS Code', abbr: 'VS', category: '编辑器' },
  { name: 'IntelliJ IDEA', abbr: 'IJ', category: '编辑器' },
  { name: 'Figma', abbr: 'FG', category: '设计' },
  { name: 'Postman', abbr: 'PM', category: '工具' },
  { name: 'GitHub', abbr: 'GH', category: '协作' },
  { name: 'Notion', abbr: 'NT', category: '笔记' },
  { name: 'Docker Desktop', abbr: 'DK', category: '工具' },
  { name: 'TablePlus', abbr: 'TP', category: '数据库' }
];
---

<Layout title="技能栈 - LuomiBlog">
  <Header />
  <main class="skill-page">
    <!-- 页面标题 -->
    <section class="page-header">
      <h1 class="page-title">技能栈</h1>
      <p class="page-subtitle">持续学习，不断进步</p>
    </section>

    <!-- 技能图表 -->
    <section class="page-content">
      {skillCategories.map((category) => (
        <div class="skill-category">
          <h2 class="skill-category-title">{category.name}</h2>
          <div class="skill-list">
            {category.skills.map((skill) => (
              <div class="skill-item">
                <div class="skill-header">
                  <span class="skill-name">{skill.name}</span>
                  <span class="skill-level">{skill.level}%</span>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" style={`width: ${skill.level}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- 常用工具 -->
    <section class="page-content" style="padding-top: 0;">
      <div class="section-header">
        <span class="section-eyebrow">Tools</span>
        <h2 class="section-title">常用工具</h2>
      </div>
      
      <div class="tools-grid">
        {tools.map((tool) => (
          <div class="tool-card">
            <span class="tool-icon">{tool.abbr}</span>
            <span class="tool-name">{tool.name}</span>
            <span class="tool-category">{tool.category}</span>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .skill-page {
    min-height: calc(100vh - 200px);
    background: var(--color-bg);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 20px;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px;
    background: var(--color-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-soft);
    transition: all var(--transition-base);
  }

  .tool-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-brand-primary);
  }

  /* 工具缩写字徽(原 emoji 图标已撤):品牌色浅底徽章 */
  .tool-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--color-brand-primary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
  }

  .tool-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 4px;
  }

  .tool-category {
    font-size: 12px;
    color: var(--color-text-muted);
  }
</style>
