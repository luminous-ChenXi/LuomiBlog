---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.vue';
import ArticleTOC from '../../components/ArticleTOC.vue';
import { getCollection, getEntry } from 'astro:content';
import { API_BASE_URL } from '../../config/api';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getEntry('blog', slug as string);

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await post.render();

const allPosts = await getCollection('blog');
const relatedArticles = allPosts
  .filter(p => p.slug !== slug)
  .filter(p => p.data.tags.some(tag => post.data.tags.includes(tag)))
  .slice(0, 3)
  .map(p => ({
    title: p.data.title,
    slug: p.slug,
    date: new Date(p.data.pubDate).toISOString().split('T')[0],
  }));

const wordCount = post.body?.split(/\s+/).length || 0;
const readTime = Math.ceil(wordCount / 300);

let dbArticle = null;
try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 5000);
  const response = await fetch(`${API_BASE_URL}/api/articles/${slug}`, {
    signal: controller.signal
  });
  clearTimeout(timeoutId);
  if (response.ok) {
    const result = await response.json();
    if (result.code === 200 && result.data) {
      dbArticle = result.data;
    }
  }
} catch (e) {
  console.info('[Article] 后端不可用，使用文件系统数据');
}

const articleData = {
  title: post.data.title,
  description: post.data.description,
  content: post.body,
  pubDate: post.data.pubDate,
  tags: post.data.tags || [],
  cover: post.data.cover,
  author: post.data.author || dbArticle?.authorName || '管理员',
  views: dbArticle?.viewCount || post.data.views || 0,
  likes: dbArticle?.likeCount || post.data.likes || 0,
  comments: dbArticle?.commentCount || post.data.comments || 0,
  category: dbArticle?.categoryName || post.data.category || '未分类',
  isSynced: !!dbArticle,
  articleId: dbArticle?.id,
};
---

<Layout
  title={`${articleData.title} - LuomiBlog`}
  description={articleData.description}
  image={articleData.cover}
  article={{
    title: articleData.title,
    description: articleData.description,
    pubDate: new Date(articleData.pubDate).toISOString(),
    author: articleData.author,
    tags: articleData.tags,
    slug: slug as string,
    category: articleData.category,
  }}
>
  <Header />
  <main class="article-page">
    <div class="article-layout">
      <!-- 左侧目录 (桌面端) -->
      <aside class="article-sidebar">
        <ArticleTOC client:visible contentSelector=".article-content" />
      </aside>

      <!-- 主内容区 -->
      <article class="article-container" data-article-id={articleData.articleId} data-is-synced={articleData.isSynced}>
        <!-- 面包屑 -->
        <nav class="breadcrumb">
          <a href="/">首页</a>
          <span class="breadcrumb-separator">/</span>
          <a href="/articles">文章</a>
          <span class="breadcrumb-separator">/</span>
          <span class="breadcrumb-current">{articleData.title}</span>
        </nav>

        <!-- 同步状态提示 -->
        <div id="sync-notice" class="sync-notice hidden">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
          <span>此文章尚未同步到数据库，部分功能（如评论、点赞统计）可能不可用</span>
        </div>

        <!-- 文章头部 -->
        <header class="article-header">
          <div class="header-category">
            <a href={`/category/${articleData.category}`} class="category-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
              {articleData.category}
            </a>
          </div>

          <h1 class="article-title">{articleData.title}</h1>
          <p class="article-excerpt">{articleData.description}</p>

          <hr class="header-divider" />

          <div class="article-meta">
            <div class="meta-left">
              <img src="/default-avatar.svg" alt={articleData.author} class="author-avatar" />
              <div class="author-info">
                <span class="author-name">{articleData.author}</span>
                <div class="meta-row">
                  <span class="meta-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                    {new Date(articleData.pubDate).toISOString().split('T')[0]}
                  </span>
                  <span class="meta-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {readTime} 分钟阅读
                  </span>
                  <span class="meta-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    {articleData.views} 阅读
                  </span>
                </div>
              </div>
            </div>

            <div class="meta-right">
              <span class="comment-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                {articleData.comments} 评论
              </span>
            </div>
          </div>

          <div class="article-tags">
            {articleData.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </header>

        <!-- 文章封面 -->
        {articleData.cover && (
          <div class="article-cover">
            <img src={articleData.cover} alt={articleData.title} />
          </div>
        )}

        <!-- 文章内容 -->
        <div class="article-content prose">
          <Content />
        </div>

        <!-- 文章底部 -->
        <footer class="article-footer">
          <div class="article-actions">
            <button class="action-btn like-btn" id="like-btn" onclick="handleLike()" data-article-id={articleData.articleId} data-synced={articleData.isSynced} data-has-liked="false">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              <span class="like-count">{articleData.likes}</span>
            </button>
            <button class="action-btn comment-btn" onclick="scrollToComments()" data-synced={articleData.isSynced}>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <span>{articleData.comments}</span>
            </button>
            <button class="action-btn favorite-btn" id="favorite-btn" onclick="handleFavorite()" data-article-id={articleData.articleId} data-synced={articleData.isSynced} data-has-favorited="false">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
              <span class="favorite-text">收藏</span>
            </button>
            <button class="action-btn share-btn" onclick="handleShare()">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
              分享
            </button>
          </div>

          <!-- 文章导航 -->
          <nav class="article-nav">
            <a href="/" class="article-nav-item">
              <div class="article-nav-label">返回文章列表</div>
              <div class="article-nav-title">查看更多文章</div>
            </a>
          </nav>

          <!-- AI 助手 -->
          <div class="article-ai-section">
            <div class="ai-section-header">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
              <h3>AI 助手</h3>
            </div>
            <p class="ai-section-desc">对这篇文章有疑问？让 AI 助手为您解答</p>
            <AIAssistant client:visible articleTitle={articleData.title} />
          </div>

          <!-- 相关文章 -->
          {relatedArticles.length > 0 && (
            <div class="related-articles">
              <h3 class="related-title">相关文章</h3>
              <div class="related-list">
                {relatedArticles.map((related) => (
                  <a href={`/article/${related.slug}`} class="related-item">
                    <span class="related-item-title">{related.title}</span>
                    <span class="related-item-date">{related.date}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </footer>
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .article-page {
    min-height: calc(100vh - 200px);
    background: var(--color-bg);
    padding: 100px 0 80px;
  }

  .article-layout {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
    padding: 0 24px;
  }

  .article-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .article-sidebar {
      display: block;
      padding-top: 32px;
    }
  }

  .article-container {
    max-width: 860px;
  }

  /* 面包屑 */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 32px;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-brand-primary);
  }

  .breadcrumb-separator {
    color: var(--color-text-muted);
  }

  .breadcrumb-current {
    color: var(--color-text);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 300px;
  }

  /* 文章头部 */
  .article-header {
    margin-bottom: 40px;
  }

  .header-category {
    margin-bottom: 1rem;
  }

  .category-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(255, 107, 157, 0.1);
    color: var(--color-brand-primary);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease-in-out;
  }

  .category-link:hover {
    background: var(--color-brand-primary);
    color: white;
  }

  .article-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.4;
    margin: 0 0 16px 0;
  }

  .article-excerpt {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 24px 0;
  }

  .header-divider {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-border), transparent);
    margin-bottom: 24px;
  }

  .article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 20px;
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .author-name {
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .comment-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: rgba(255, 107, 157, 0.1);
    color: var(--color-brand-primary);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    transition: all 0.3s ease-in-out;
  }

  .comment-link:hover {
    background: var(--color-brand-primary);
    color: white;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    background: rgba(255, 107, 157, 0.1);
    color: var(--color-brand-primary);
    font-size: 13px;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .tag:hover {
    background: var(--color-brand-primary);
    color: white;
  }

  /* 文章封面 */
  .article-cover {
    margin-bottom: 40px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
  }

  /* Prose 排版样式 */
  .prose {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text);
    max-width: 100%;
  }

  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--color-text);
    font-weight: 600;
    scroll-margin-top: 100px;
  }

  .prose :global(h2) {
    font-size: 1.75rem;
    margin: 48px 0 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .prose :global(h3) {
    font-size: 1.375rem;
    margin: 32px 0 16px;
  }

  .prose :global(h4) {
    font-size: 1.125rem;
    margin: 24px 0 12px;
  }

  .prose :global(p) {
    margin: 0 0 20px 0;
  }

  .prose :global(a) {
    color: var(--color-brand-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .prose :global(a:hover) {
    text-decoration: underline;
  }

  .prose :global(pre) {
    background: #1e1e2e;
    padding: 20px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 20px 0;
    position: relative;
  }

  .prose :global(code) {
    font-family: 'Fira Code', 'Consolas', monospace;
    font-size: 0.9em;
  }

  .prose :global(:not(pre) > code) {
    background: var(--color-bg-tertiary);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--color-brand-primary);
  }

  .prose :global(pre code) {
    background: transparent;
    color: #cdd6f4;
    padding: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 20px 0;
    padding-left: 24px;
  }

  .prose :global(li) {
    margin: 8px 0;
  }

  .prose :global(blockquote) {
    margin: 20px 0;
    padding: 16px 20px;
    border-left: 4px solid var(--color-brand-primary);
    background: var(--color-bg-tertiary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    display: block;
    overflow-x: auto;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .prose :global(th) {
    background: var(--color-bg-tertiary);
    font-weight: 600;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    display: block;
    margin: 24px auto;
  }

  .prose :global(hr) {
    border: none;
    height: 1px;
    background: var(--color-border);
    margin: 40px 0;
  }

  .prose :global(.katex-display) {
    margin: 24px 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 8px 0;
  }

  .prose :global(.math) {
    overflow-x: auto;
    overflow-y: hidden;
  }

  .prose :global(.math-block) {
    margin: 24px 0;
  }

  .prose :global(details) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    margin: 20px 0;
  }

  .prose :global(summary) {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text);
    padding: 4px 0;
  }

  .prose :global(sup) {
    font-size: 0.75em;
    vertical-align: super;
  }

  .prose :global(sub) {
    font-size: 0.75em;
    vertical-align: sub;
  }

  .prose :global(del) {
    color: var(--color-text-muted);
  }

  .prose :global(.rehype-code-title) {
    padding: 8px 16px;
    background: #313244;
    color: #cdd6f4;
    font-size: 0.85rem;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    margin-bottom: -20px;
    font-family: 'Fira Code', 'Consolas', monospace;
  }

  /* 文章底部 */
  .article-footer {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }

  .article-actions {
    display: flex;
    gap: 12px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-text-secondary);
    font-size: 14px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .action-btn:hover {
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }

  .like-btn:hover svg {
    fill: var(--color-brand-primary);
  }

  .action-btn.liked {
    color: var(--color-danger, #ff4d4f);
    background: rgba(255, 77, 79, 0.08);
    border-color: var(--color-danger, #ff4d4f);
  }

  .action-btn.liked svg {
    fill: var(--color-danger, #ff4d4f);
  }

  .action-btn.favorited {
    color: var(--color-warning, #faad14);
    background: rgba(250, 173, 20, 0.08);
    border-color: var(--color-warning, #faad14);
  }

  .action-btn.favorited svg {
    fill: var(--color-warning, #faad14);
  }

  /* 文章导航 */
  .article-nav {
    display: flex;
    gap: 20px;
    margin-bottom: 40px;
  }

  .article-nav-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    padding: 20px;
    background: var(--color-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-soft);
    transition: all var(--transition-base);
    flex: 1;
  }

  .article-nav-item:hover {
    border-color: var(--color-brand-primary);
  }

  .article-nav-label {
    font-size: 12px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .article-nav-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
  }

  .article-nav-item:hover .article-nav-title {
    color: var(--color-brand-primary);
  }

  /* AI 助手 */
  .article-ai-section {
    margin: 40px 0;
    padding: 24px;
    background: linear-gradient(135deg, rgba(255, 107, 157, 0.05) 0%, rgba(78, 205, 196, 0.05) 100%);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-soft);
  }

  .ai-section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    color: var(--color-brand-primary);
  }

  .ai-section-header h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  .ai-section-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0 0 16px 0;
  }

  /* 相关文章 */
  .related-articles {
    margin-top: 40px;
  }

  .related-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 20px 0;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .related-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    background: var(--color-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-soft);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .related-item:hover {
    border-color: var(--color-brand-primary);
    transform: translateX(4px);
  }

  .related-item-title {
    font-size: 15px;
    color: var(--color-text);
    font-weight: 500;
  }

  .related-item:hover .related-item-title {
    color: var(--color-brand-primary);
  }

  .related-item-date {
    font-size: 13px;
    color: var(--color-text-muted);
    white-space: nowrap;
    margin-left: 16px;
  }

  /* 同步状态提示 */
  .sync-notice {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    margin-bottom: 24px;
    background: rgba(250, 173, 20, 0.08);
    border: 1px solid rgba(250, 173, 20, 0.3);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: 14px;
  }

  .sync-notice svg {
    flex-shrink: 0;
    color: #faad14;
  }

  .hidden {
    display: none !important;
  }

  /* 响应式 */
  @media (max-width: 1023px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .article-container {
      padding: 0 16px;
    }

    .article-title {
      font-size: 1.75rem;
    }

    .article-meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .meta-row {
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .article-nav {
      flex-direction: column;
    }

    .related-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .related-item-date {
      margin-left: 0;
    }
  }
</style>

<script>
  const API_BASE = (() => {
    const base = document.querySelector('meta[name="api-base-url"]');
    return base?.getAttribute('content') || '';
  })();

  function getApiUrl(path: string): string {
    if (API_BASE) return `${API_BASE}${path}`;
    return path;
  }

  function isBackendReachable(): boolean {
    return !document.querySelector('[data-backend-down]');
  }

  async function safeFetch(url: string, options: RequestInit = {}): Promise<Response | null> {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 8000);
      const response = await fetch(url, {
        ...options,
        signal: controller.signal
      });
      clearTimeout(timeoutId);
      return response;
    } catch {
      return null;
    }
  }

  function showFeatureDisabled(element: HTMLElement | null, message: string) {
    if (!element) return;
    element.style.opacity = '0.5';
    element.style.cursor = 'not-allowed';
    element.title = message;
  }

  async function handleLike() {
    const likeBtn = document.getElementById('like-btn');
    const isSynced = likeBtn?.getAttribute('data-synced') === 'true';
    const articleId = likeBtn?.getAttribute('data-article-id');

    if (!isSynced || !articleId) {
      showFeatureDisabled(likeBtn, '后端服务不可用，点赞功能暂不可用');
      return;
    }

    const visitorId = getVisitorId();
    const userId = getUserId();

    const response = await safeFetch(getApiUrl(`/api/articles/${articleId}/like`), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId, visitorId })
    });

    if (response && response.ok) {
      const result = await response.json();
      if (result.code === 200) {
        const data = result.data;
        const countEl = likeBtn?.querySelector('.like-count');
        if (countEl) countEl.textContent = data.likeCount;
        if (data.action === 'like') {
          likeBtn?.classList.add('liked');
        } else {
          likeBtn?.classList.remove('liked');
        }
      }
    }
  }

  function handleShare() {
    if (navigator.share) {
      navigator.share({ title: document.title, url: window.location.href });
    } else {
      navigator.clipboard.writeText(window.location.href);
    }
  }

  function scrollToComments() {
    const commentsSection = document.getElementById('comments');
    if (commentsSection) {
      commentsSection.scrollIntoView({ behavior: 'smooth' });
    }
  }

  function getVisitorId() {
    let visitorId = localStorage.getItem('lm_visitor_id');
    if (!visitorId) {
      visitorId = 'v_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now();
      localStorage.setItem('lm_visitor_id', visitorId);
    }
    return visitorId;
  }

  function getUserToken() {
    return localStorage.getItem('token') || sessionStorage.getItem('token');
  }

  function getUserId() {
    const token = getUserToken();
    if (!token) return null;
    try {
      const payload = JSON.parse(atob(token.split('.')[1]));
      return payload.userId || payload.sub || null;
    } catch {
      return null;
    }
  }

  async function handleFavorite() {
    const favoriteBtn = document.getElementById('favorite-btn');
    const articleId = favoriteBtn?.getAttribute('data-article-id');
    const isSynced = favoriteBtn?.getAttribute('data-synced') === 'true';

    if (!isSynced || !articleId) {
      showFeatureDisabled(favoriteBtn, '后端服务不可用，收藏功能暂不可用');
      return;
    }

    const token = getUserToken();
    if (!token) return;

    const response = await safeFetch(getApiUrl(`/api/articles/${articleId}/favorite`), {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      }
    });

    if (response && response.ok) {
      const result = await response.json();
      if (result.code === 200) {
        const data = result.data;
        const textEl = favoriteBtn?.querySelector('.favorite-text');
        if (data.action === 'favorite') {
          favoriteBtn?.classList.add('favorited');
          if (textEl) textEl.textContent = '已收藏';
        } else {
          favoriteBtn?.classList.remove('favorited');
          if (textEl) textEl.textContent = '收藏';
        }
      }
    }
  }

  document.addEventListener('DOMContentLoaded', async () => {
    const articleContainer = document.querySelector('.article-container');
    const articleId = articleContainer?.getAttribute('data-article-id');
    const slug = window.location.pathname.split('/').pop() || '';
    const syncNotice = document.getElementById('sync-notice');

    if (slug) {
      const response = await safeFetch(getApiUrl(`/api/articles/${slug}`));

      if (response && response.ok) {
        const result = await response.json();
        if (result.code === 200 && result.data) {
          syncNotice?.classList.add('hidden');
          if (articleContainer) {
            articleContainer.setAttribute('data-article-id', result.data.id);
            articleContainer.setAttribute('data-is-synced', 'true');
          }
          const likeBtn = document.getElementById('like-btn');
          const favoriteBtn = document.getElementById('favorite-btn');
          likeBtn?.setAttribute('data-article-id', result.data.id);
          likeBtn?.setAttribute('data-synced', 'true');
          favoriteBtn?.setAttribute('data-article-id', result.data.id);
          favoriteBtn?.setAttribute('data-synced', 'true');
        } else {
          syncNotice?.classList.remove('hidden');
        }
      } else {
        syncNotice?.classList.remove('hidden');
        document.body.setAttribute('data-backend-down', 'true');

        const likeBtn = document.getElementById('like-btn');
        const favoriteBtn = document.getElementById('favorite-btn');
        const commentBtn = document.querySelector('.comment-btn');
        showFeatureDisabled(likeBtn, '后端服务不可用，点赞功能暂不可用');
        showFeatureDisabled(favoriteBtn, '后端服务不可用，收藏功能暂不可用');
        showFeatureDisabled(commentBtn as HTMLElement, '后端服务不可用，评论功能暂不可用');
      }
    }

    if (articleId) {
      setTimeout(() => {
        safeFetch(getApiUrl(`/api/articles/${articleId}/view`), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId: getUserId(),
            visitorId: getVisitorId(),
            userAgent: navigator.userAgent
          })
        });
      }, 3000);
    }

    const mermaidBlocks = document.querySelectorAll('.language-mermaid');
    if (mermaidBlocks.length > 0) {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
      script.onload = () => {
        (window as any).mermaid.initialize({
          startOnLoad: false,
          theme: document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'default',
          securityLevel: 'loose'
        });
        mermaidBlocks.forEach(async (block, index) => {
          const pre = block.parentElement;
          if (!pre) return;
          const code = block.textContent || '';
          try {
            const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js');
            const id = `mermaid-${index}`;
            const { svg } = await (window as any).mermaid.render(id, code);
            const container = document.createElement('div');
            container.className = 'mermaid-container';
            container.innerHTML = svg;
            container.style.overflowX = 'auto';
            container.style.margin = '20px 0';
            container.style.textAlign = 'center';
            pre.replaceWith(container);
          } catch (err) {
            console.error('Mermaid render error:', err);
          }
        });
      };
      document.head.appendChild(script);
    }
  });
</script>
