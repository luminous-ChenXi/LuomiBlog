---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.vue';

// 定义动态路由参数
export function getStaticPaths() {
  return [
    { params: { slug: 'spring-boot-3-2-features' } },
    { params: { slug: 'astro-performance-optimization' } }
  ];
}

// 模拟文章数据
const articles: Record<string, any> = {
  'spring-boot-3-2-features': {
    title: 'Spring Boot 3.2 新特性探索',
    excerpt: 'Spring Boot 3.2 带来了许多令人兴奋的新特性，包括虚拟线程支持、RestClient、JdbcClient 等。本文将详细介绍这些新特性并给出实战示例。',
    cover: 'https://picsum.photos/seed/springboot/1200/600',
    author: '辰汐',
    avatar: '/default-avatar.svg',
    date: '2026-02-28',
    readTime: '15 分钟',
    views: 1234,
    likes: 89,
    tags: ['Spring Boot', 'Java', '后端'],
    content: `
      <p>Spring Boot 3.2 是 Spring Boot 3.x 系列的一个重要版本，带来了许多令人期待的新特性。本文将深入探讨这些新特性，帮助开发者更好地理解和使用它们。</p>

      <h2>虚拟线程支持</h2>
      <p>Spring Boot 3.2 正式支持 Java 21 的虚拟线程（Virtual Threads）。虚拟线程是 Java 21 中引入的轻量级线程，可以显著提高高并发应用的性能。</p>
      <pre><code class="language-java">@Configuration
public class VirtualThreadConfig {
    @Bean
    public TomcatProtocolHandlerCustomizer<?> protocolHandlerVirtualThreadExecutorCustomizer() {
        return protocolHandler -> {
            protocolHandler.setExecutor(Executors.newVirtualThreadPerTaskExecutor());
        };
    }
}</code></pre>

      <h2>RestClient</h2>
      <p>Spring 6.1 引入了新的 RestClient API，它提供了更现代化的 HTTP 客户端接口，相比 RestTemplate 更加简洁易用。</p>
      <pre><code class="language-java">@Service
public class UserService {
    private final RestClient restClient;

    public UserService(RestClient.Builder restClientBuilder) {
        this.restClient = restClientBuilder
            .baseUrl("https://api.example.com")
            .build();
    }

    public User getUser(Long id) {
        return restClient.get()
            .uri("/users/{id}", id)
            .retrieve()
            .body(User.class);
    }
}</code></pre>

      <h2>JdbcClient</h2>
      <p>JdbcClient 是 Spring Framework 6.1 中引入的新特性，它提供了更简洁的 JDBC 操作方式。</p>

      <h2>总结</h2>
      <p>Spring Boot 3.2 的这些新特性让开发更加高效，特别是虚拟线程的支持，为构建高并发应用提供了更好的解决方案。建议开发者尽快升级到最新版本，体验这些新特性带来的便利。</p>
    `
  },
  'astro-performance-optimization': {
    title: '基于 Astro 的静态博客性能优化实践',
    excerpt: 'Astro 是一个现代化的静态站点生成器，本文将分享在使用 Astro 构建博客时的性能优化经验。',
    cover: 'https://picsum.photos/seed/astro/1200/600',
    author: '辰汐',
    avatar: '/default-avatar.svg',
    date: '2026-03-05',
    readTime: '12 分钟',
    views: 892,
    likes: 56,
    tags: ['Astro', '性能优化', '前端'],
    content: `
      <p>Astro 是一个现代化的静态站点生成器，以其独特的 Islands 架构而闻名。本文将分享在使用 Astro 构建博客时的一些性能优化经验。</p>

      <h2>Islands 架构的优势</h2>
      <p>Astro 的 Islands 架构允许我们在页面中按需加载 JavaScript，这意味着大部分内容都是纯静态 HTML，只有需要交互的部分才会加载 JS。</p>

      <h2>图片优化</h2>
      <p>Astro 提供了内置的图片优化功能，可以自动处理图片的格式转换、尺寸调整等。</p>

      <h2>总结</h2>
      <p>通过合理使用 Astro 的特性，我们可以构建出性能卓越的静态网站。希望本文的经验对你有所帮助。</p>
    `
  }
};

// 获取当前文章
const { slug } = Astro.params;
const article = articles[slug as string] || articles['spring-boot-3-2-features'];

// 相关文章
const relatedArticles = [
  { title: 'Spring Boot 3.0 新特性详解', slug: 'spring-boot-3-features', date: '2025-12-01' },
  { title: 'Java 21 虚拟线程实战指南', slug: 'java-21-virtual-threads', date: '2026-01-15' },
  { title: 'Spring Security 6 配置详解', slug: 'spring-security-6', date: '2025-11-20' }
];
---

<Layout title={`${article.title} - LuomiBlog`} description={article.excerpt}>
  <Header />
  <main class="article-page">
    <article class="article-container">
      <!-- 面包屑 -->
      <nav class="breadcrumb">
        <a href="/">首页</a>
        <span class="breadcrumb-separator">/</span>
        <a href="/archive">文章</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">{article.title}</span>
      </nav>

      <!-- 文章头部 -->
      <header class="article-header">
        <h1 class="article-title">{article.title}</h1>
        <p class="article-excerpt">{article.excerpt}</p>
        
        <div class="article-meta">
          <div class="article-meta-item">
            <img src={article.avatar} alt={article.author} class="author-avatar-small" />
            <span>{article.author}</span>
          </div>
          <div class="article-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            <span>{article.date}</span>
          </div>
          <div class="article-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{article.readTime}</span>
          </div>
          <div class="article-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>{article.views} 阅读</span>
          </div>
        </div>

        <div class="article-tags">
          {article.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </header>

      <!-- 文章封面 -->
      <div class="article-cover">
        <img src={article.cover} alt={article.title} />
      </div>

      <!-- 文章内容 -->
      <div class="article-content" set:html={article.content} />

      <!-- 文章底部 -->
      <footer class="article-footer">
        <!-- 点赞分享 -->
        <div class="article-actions">
          <button class="action-btn like-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            <span>{article.likes}</span>
          </button>
          <button class="action-btn share-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
            分享
          </button>
        </div>

        <!-- 文章导航 -->
        <nav class="article-nav">
          <a href="/article/astro-performance-optimization" class="article-nav-item prev">
            <div class="article-nav-label">上一篇</div>
            <div class="article-nav-title">基于 Astro 的静态博客性能优化实践</div>
          </a>
          <a href="/article/spring-boot-3-2-features" class="article-nav-item next">
            <div class="article-nav-label">下一篇</div>
            <div class="article-nav-title">Spring Boot 3.2 新特性探索</div>
          </a>
        </nav>

        <!-- AI 助手 -->
        <div class="article-ai-section">
          <div class="ai-section-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            <h3>AI 助手</h3>
          </div>
          <p class="ai-section-desc">对这篇文章有疑问？让 AI 助手为您解答</p>
          <AIAssistant client:visible articleTitle={article.title} />
        </div>

        <!-- 相关文章 -->
        <div class="related-articles">
          <h3 class="related-title">相关文章</h3>
          <div class="related-list">
            {relatedArticles.map((related) => (
              <a href={`/article/${related.slug}`} class="related-item">
                <span class="related-item-title">{related.title}</span>
                <span class="related-item-date">{related.date}</span>
              </a>
            ))}
          </div>
        </div>
      </footer>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .article-page {
    min-height: calc(100vh - 200px);
    background: var(--color-bg);
  }

  .author-avatar-small {
    width: 24px;
    height: 24px;
    border-radius: 50%;
  }

  .article-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--color-border);
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-text-secondary);
    font-size: 14px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .action-btn:hover {
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }

  .like-btn:hover svg {
    fill: var(--color-brand-primary);
  }

  .article-ai-section {
    margin: 40px 0;
    padding: 24px;
    background: linear-gradient(135deg, rgba(255, 107, 157, 0.05) 0%, rgba(78, 205, 196, 0.05) 100%);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-soft);
  }

  .ai-section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    color: var(--color-brand-primary);
  }

  .ai-section-header h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  .ai-section-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0 0 16px 0;
  }

  .related-articles {
    margin-top: 40px;
  }

  .related-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 20px 0;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .related-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: var(--color-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-soft);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .related-item:hover {
    border-color: var(--color-brand-primary);
  }

  .related-item-title {
    font-size: 15px;
    color: var(--color-text);
  }

  .related-item:hover .related-item-title {
    color: var(--color-brand-primary);
  }

  .related-item-date {
    font-size: 13px;
    color: var(--color-text-muted);
  }
</style>
