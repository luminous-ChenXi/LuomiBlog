---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.vue';
import { getCollection, getEntry } from 'astro:content';

// 获取所有文章用于生成静态路径
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
  }));
}

// 获取当前文章
const { slug } = Astro.params;
const post = await getEntry('blog', slug as string);

// 如果文章不存在，返回 404
if (!post) {
  return Astro.redirect('/404');
}

// 渲染文章内容
const { Content } = await post.render();

// 获取所有文章用于相关文章推荐
const allPosts = await getCollection('blog');
const relatedArticles = allPosts
  .filter(p => p.slug !== slug)
  .filter(p => p.data.tags.some(tag => post.data.tags.includes(tag)))
  .slice(0, 3)
  .map(p => ({
    title: p.data.title,
    slug: p.slug,
    date: new Date(p.data.pubDate).toISOString().split('T')[0],
  }));

// 计算阅读时间（按每分钟 300 字计算）
const wordCount = post.body?.split(/\s+/).length || 0;
const readTime = Math.ceil(wordCount / 300);
---

<Layout title={`${post.data.title} - LuomiBlog`} description={post.data.description}>
  <Header />
  <main class="article-page">
    <article class="article-container">
      <!-- 面包屑 -->
      <nav class="breadcrumb">
        <a href="/">首页</a>
        <span class="breadcrumb-separator">/</span>
        <a href="/articles">文章</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">{post.data.title}</span>
      </nav>

      <!-- 文章头部 -->
      <header class="article-header">
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-excerpt">{post.data.description}</p>
        
        <div class="article-meta">
          <div class="article-meta-item">
            <img src="/default-avatar.svg" alt={post.data.author} class="author-avatar-small" />
            <span>{post.data.author}</span>
          </div>
          <div class="article-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            <span>{new Date(post.data.pubDate).toISOString().split('T')[0]}</span>
          </div>
          <div class="article-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{readTime} 分钟阅读</span>
          </div>
          <div class="article-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>{post.data.views || 0} 阅读</span>
          </div>
        </div>

        <div class="article-tags">
          {post.data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </header>

      <!-- 文章封面 -->
      {post.data.cover && (
        <div class="article-cover">
          <img src={post.data.cover} alt={post.data.title} />
        </div>
      )}

      <!-- 文章内容 -->
      <div class="article-content">
        <Content />
      </div>

      <!-- 文章底部 -->
      <footer class="article-footer">
        <!-- 点赞分享收藏 -->
        <div class="article-actions">
          <button class="action-btn like-btn" onclick="handleLike()">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            <span>{post.data.likes || 0}</span>
          </button>
          <button class="action-btn favorite-btn" onclick="handleFavorite()">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
            收藏
          </button>
          <button class="action-btn share-btn" onclick="handleShare()">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
            分享
          </button>
        </div>

        <!-- 文章导航 -->
        <nav class="article-nav">
          <a href="/articles" class="article-nav-item prev">
            <div class="article-nav-label">返回文章列表</div>
            <div class="article-nav-title">查看更多文章</div>
          </a>
        </nav>

        <!-- AI 助手 -->
        <div class="article-ai-section">
          <div class="ai-section-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            <h3>AI 助手</h3>
          </div>
          <p class="ai-section-desc">对这篇文章有疑问？让 AI 助手为您解答</p>
          <AIAssistant client:visible articleTitle={post.data.title} />
        </div>

        <!-- 相关文章 -->
        {relatedArticles.length > 0 && (
          <div class="related-articles">
            <h3 class="related-title">相关文章</h3>
            <div class="related-list">
              {relatedArticles.map((related) => (
                <a href={`/article/${related.slug}`} class="related-item">
                  <span class="related-item-title">{related.title}</span>
                  <span class="related-item-date">{related.date}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </footer>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .article-page {
    min-height: calc(100vh - 200px);
    background: var(--color-bg);
    padding: 100px 0 80px; /* 增加顶部间距，为固定导航栏留空间 */
  }

  .article-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* 面包屑 */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 32px;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-brand-primary);
  }

  .breadcrumb-separator {
    color: var(--color-text-muted);
  }

  .breadcrumb-current {
    color: var(--color-text);
    font-weight: 500;
  }

  /* 文章头部 */
  .article-header {
    margin-bottom: 40px;
  }

  .article-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    margin: 0 0 16px 0;
  }

  .article-excerpt {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 24px 0;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .article-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .author-avatar-small {
    width: 24px;
    height: 24px;
    border-radius: 50%;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    background: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
    font-size: 13px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-soft);
  }

  /* 文章封面 */
  .article-cover {
    margin-bottom: 40px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* 文章内容 */
  .article-content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    color: var(--color-text);
    margin: 40px 0 20px;
    font-weight: 600;
  }

  .article-content :global(h2) {
    font-size: 1.75rem;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .article-content :global(h3) {
    font-size: 1.375rem;
  }

  .article-content :global(p) {
    margin: 0 0 20px 0;
  }

  .article-content :global(a) {
    color: var(--color-brand-primary);
    text-decoration: none;
  }

  .article-content :global(a:hover) {
    text-decoration: underline;
  }

  .article-content :global(pre) {
    background: var(--color-code-bg);
    padding: 20px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 20px 0;
  }

  .article-content :global(code) {
    font-family: 'Fira Code', 'Consolas', monospace;
    font-size: 0.9em;
  }

  .article-content :global(:not(pre) > code) {
    background: var(--color-code-bg);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--color-brand-primary);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 20px 0;
    padding-left: 24px;
  }

  .article-content :global(li) {
    margin: 8px 0;
  }

  .article-content :global(blockquote) {
    margin: 20px 0;
    padding: 16px 20px;
    border-left: 4px solid var(--color-brand-primary);
    background: var(--color-bg-tertiary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .article-content :global(blockquote p) {
    margin: 0;
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: 12px;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .article-content :global(th) {
    background: var(--color-bg-tertiary);
    font-weight: 600;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  /* 文章底部 */
  .article-footer {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }

  .article-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 40px;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-text-secondary);
    font-size: 14px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .action-btn:hover {
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }

  .like-btn:hover svg {
    fill: var(--color-brand-primary);
  }

  /* 文章导航 */
  .article-nav {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
    padding: 24px;
    background: var(--color-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .article-nav-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    flex: 1;
  }

  .article-nav-item.next {
    align-items: flex-end;
    text-align: right;
  }

  .article-nav-label {
    font-size: 12px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .article-nav-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
  }

  .article-nav-item:hover .article-nav-title {
    color: var(--color-brand-primary);
  }

  /* AI 助手 */
  .article-ai-section {
    margin: 40px 0;
    padding: 24px;
    background: linear-gradient(135deg, rgba(255, 107, 157, 0.05) 0%, rgba(78, 205, 196, 0.05) 100%);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-soft);
  }

  .ai-section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    color: var(--color-brand-primary);
  }

  .ai-section-header h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  .ai-section-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0 0 16px 0;
  }

  /* 相关文章 */
  .related-articles {
    margin-top: 40px;
  }

  .related-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 20px 0;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .related-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: var(--color-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-soft);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .related-item:hover {
    border-color: var(--color-brand-primary);
  }

  .related-item-title {
    font-size: 15px;
    color: var(--color-text);
  }

  .related-item:hover .related-item-title {
    color: var(--color-brand-primary);
  }

  .related-item-date {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .article-container {
      padding: 0 16px;
    }

    .article-title {
      font-size: 1.75rem;
    }

    .article-meta {
      gap: 12px;
    }

    .article-nav {
      flex-direction: column;
    }

    .article-nav-item.next {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
