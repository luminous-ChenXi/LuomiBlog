---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.vue';
import { getCollection, getEntry } from 'astro:content';
import { API_BASE_URL } from '../../config/api';

// 获取所有文章用于生成静态路径
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
  }));
}

// 获取当前文章
const { slug } = Astro.params;
const post = await getEntry('blog', slug as string);

// 如果文章不存在，返回 404
if (!post) {
  return Astro.redirect('/404');
}

// 渲染文章内容
const { Content } = await post.render();

// 获取所有文章用于相关文章推荐
const allPosts = await getCollection('blog');
const relatedArticles = allPosts
  .filter(p => p.slug !== slug)
  .filter(p => p.data.tags.some(tag => post.data.tags.includes(tag)))
  .slice(0, 3)
  .map(p => ({
    title: p.data.title,
    slug: p.slug,
    date: new Date(p.data.pubDate).toISOString().split('T')[0],
  }));

// 计算阅读时间（按每分钟 300 字计算）
const wordCount = post.body?.split(/\s+/).length || 0;
const readTime = Math.ceil(wordCount / 300);

// 尝试从后端获取文章数据（如果已同步到数据库）
let dbArticle = null;
try {
  const response = await fetch(`${API_BASE_URL}/api/articles/slug/${slug}`);
  if (response.ok) {
    const result = await response.json();
    if (result.code === 200 && result.data) {
      dbArticle = result.data;
    }
  }
} catch (e) {
  // 后端不可用或文章未同步，使用文件系统数据
  console.log('使用文件系统数据，后端数据不可用');
}

// 合并数据：文件系统数据优先，后端数据补充
const articleData = {
  // 基础数据来自文件系统
  title: post.data.title,
  description: post.data.description,
  content: post.body,
  pubDate: post.data.pubDate,
  tags: post.data.tags || [],
  cover: post.data.cover,
  // 作者：优先使用文件中的作者，否则使用后端作者，最后默认
  author: post.data.author || dbArticle?.authorName || '管理员',
  // 统计数据：优先使用后端数据
  views: dbArticle?.viewCount || post.data.views || 0,
  likes: dbArticle?.likeCount || post.data.likes || 0,
  comments: dbArticle?.commentCount || post.data.comments || 0,
  // 分类：优先使用后端数据
  category: dbArticle?.categoryName || post.data.category || '未分类',
  // 是否已同步到数据库
  isSynced: !!dbArticle,
  // 数据库文章ID（用于评论等功能）
  articleId: dbArticle?.id,
};
---

<Layout title={`${articleData.title} - LuomiBlog`} description={articleData.description}>
  <Header />
  <main class="article-page">
    <article class="article-container" data-article-id={articleData.articleId} data-is-synced={articleData.isSynced}>
      <!-- 面包屑 -->
      <nav class="breadcrumb">
        <a href="/">首页</a>
        <span class="breadcrumb-separator">/</span>
        <a href="/articles">文章</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">{articleData.title}</span>
      </nav>

      <!-- 同步状态提示 -->
      {!articleData.isSynced && (
        <div class="sync-notice">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
          <span>此文章尚未同步到数据库，部分功能（如评论、点赞统计）可能不可用</span>
        </div>
      )}

      <!-- 文章头部 -->
      <header class="article-header">
        <h1 class="article-title">{articleData.title}</h1>
        <p class="article-excerpt">{articleData.description}</p>
        
        <div class="article-meta">
          <div class="article-meta-item">
            <img src="/default-avatar.svg" alt={articleData.author} class="author-avatar-small" />
            <span>{articleData.author}</span>
          </div>
          <div class="article-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            <span>{new Date(articleData.pubDate).toISOString().split('T')[0]}</span>
          </div>
          <div class="article-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{readTime} 分钟阅读</span>
          </div>
          <div class="article-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>{articleData.views} 阅读</span>
          </div>
          <div class="article-meta-item category-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
            <span>{articleData.category}</span>
          </div>
        </div>

        <div class="article-tags">
          {articleData.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </header>

      <!-- 文章封面 -->
      {articleData.cover && (
        <div class="article-cover">
          <img src={articleData.cover} alt={articleData.title} />
        </div>
      )}

      <!-- 文章内容 -->
      <div class="article-content">
        <Content />
      </div>

      <!-- 文章底部 -->
      <footer class="article-footer">
        <!-- 点赞分享收藏 -->
        <div class="article-actions">
          <button class="action-btn like-btn" id="like-btn" onclick="handleLike()" data-article-id={articleData.articleId} data-synced={articleData.isSynced} data-has-liked="false">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            <span class="like-count">{articleData.likes}</span>
          </button>
          <button class="action-btn comment-btn" onclick="scrollToComments()" data-synced={articleData.isSynced}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span>{articleData.comments}</span>
          </button>
          <button class="action-btn favorite-btn" id="favorite-btn" onclick="handleFavorite()" data-article-id={articleData.articleId} data-synced={articleData.isSynced} data-has-favorited="false">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
            <span class="favorite-text">收藏</span>
          </button>
          <button class="action-btn share-btn" onclick="handleShare()">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
            分享
          </button>
        </div>

        <!-- 文章导航 -->
        <nav class="article-nav">
          <a href="/articles" class="article-nav-item prev">
            <div class="article-nav-label">返回文章列表</div>
            <div class="article-nav-title">查看更多文章</div>
          </a>
        </nav>

        <!-- AI 助手 -->
        <div class="article-ai-section">
          <div class="ai-section-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            <h3>AI 助手</h3>
          </div>
          <p class="ai-section-desc">对这篇文章有疑问？让 AI 助手为您解答</p>
          <AIAssistant client:visible articleTitle={articleData.title} />
        </div>

        <!-- 相关文章 -->
        {relatedArticles.length > 0 && (
          <div class="related-articles">
            <h3 class="related-title">相关文章</h3>
            <div class="related-list">
              {relatedArticles.map((related) => (
                <a href={`/article/${related.slug}`} class="related-item">
                  <span class="related-item-title">{related.title}</span>
                  <span class="related-item-date">{related.date}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </footer>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .article-page {
    min-height: calc(100vh - 200px);
    background: var(--color-bg);
    padding: 100px 0 80px; /* 增加顶部间距，为固定导航栏留空间 */
  }

  .article-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* 面包屑 */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 32px;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-brand-primary);
  }

  .breadcrumb-separator {
    color: var(--color-text-muted);
  }

  .breadcrumb-current {
    color: var(--color-text);
    font-weight: 500;
  }

  /* 文章头部 */
  .article-header {
    margin-bottom: 40px;
  }

  .article-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    margin: 0 0 16px 0;
  }

  .article-excerpt {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 24px 0;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .article-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .author-avatar-small {
    width: 24px;
    height: 24px;
    border-radius: 50%;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    background: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
    font-size: 13px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-soft);
  }

  /* 文章封面 */
  .article-cover {
    margin-bottom: 40px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* 文章内容 */
  .article-content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    color: var(--color-text);
    margin: 40px 0 20px;
    font-weight: 600;
  }

  .article-content :global(h2) {
    font-size: 1.75rem;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .article-content :global(h3) {
    font-size: 1.375rem;
  }

  .article-content :global(p) {
    margin: 0 0 20px 0;
  }

  .article-content :global(a) {
    color: var(--color-brand-primary);
    text-decoration: none;
  }

  .article-content :global(a:hover) {
    text-decoration: underline;
  }

  .article-content :global(pre) {
    background: var(--color-code-bg);
    padding: 20px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 20px 0;
  }

  .article-content :global(code) {
    font-family: 'Fira Code', 'Consolas', monospace;
    font-size: 0.9em;
  }

  .article-content :global(:not(pre) > code) {
    background: var(--color-code-bg);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--color-brand-primary);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 20px 0;
    padding-left: 24px;
  }

  .article-content :global(li) {
    margin: 8px 0;
  }

  .article-content :global(blockquote) {
    margin: 20px 0;
    padding: 16px 20px;
    border-left: 4px solid var(--color-brand-primary);
    background: var(--color-bg-tertiary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .article-content :global(blockquote p) {
    margin: 0;
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: 12px;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .article-content :global(th) {
    background: var(--color-bg-tertiary);
    font-weight: 600;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  /* 文章底部 */
  .article-footer {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }

  .article-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 40px;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-text-secondary);
    font-size: 14px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .action-btn:hover {
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }

  .like-btn:hover svg {
    fill: var(--color-brand-primary);
  }

  /* 文章导航 */
  .article-nav {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
    padding: 24px;
    background: var(--color-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .article-nav-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    flex: 1;
  }

  .article-nav-item.next {
    align-items: flex-end;
    text-align: right;
  }

  .article-nav-label {
    font-size: 12px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .article-nav-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
  }

  .article-nav-item:hover .article-nav-title {
    color: var(--color-brand-primary);
  }

  /* AI 助手 */
  .article-ai-section {
    margin: 40px 0;
    padding: 24px;
    background: linear-gradient(135deg, rgba(255, 107, 157, 0.05) 0%, rgba(78, 205, 196, 0.05) 100%);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-soft);
  }

  .ai-section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    color: var(--color-brand-primary);
  }

  .ai-section-header h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  .ai-section-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0 0 16px 0;
  }

  /* 相关文章 */
  .related-articles {
    margin-top: 40px;
  }

  .related-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 20px 0;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .related-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: var(--color-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-soft);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .related-item:hover {
    border-color: var(--color-brand-primary);
  }

  .related-item-title {
    font-size: 15px;
    color: var(--color-text);
  }

  .related-item:hover .related-item-title {
    color: var(--color-brand-primary);
  }

  .related-item-date {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  /* 同步状态提示 */
  .sync-notice {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    margin-bottom: 24px;
    background: var(--color-warning-bg, #fff8e6);
    border: 1px solid var(--color-warning-border, #ffd666);
    border-radius: var(--radius-md);
    color: var(--color-warning-text, #d48806);
    font-size: 14px;
  }

  .sync-notice svg {
    flex-shrink: 0;
  }

  /* 分类标签 */
  .category-item {
    color: var(--color-brand-primary);
  }

  /* 点赞按钮激活状态 */
  .action-btn.liked {
    color: var(--color-danger, #ff4d4f);
    background: var(--color-danger-bg, #fff2f0);
    border-color: var(--color-danger, #ff4d4f);
  }

  .action-btn.liked svg {
    fill: var(--color-danger, #ff4d4f);
  }

  /* 收藏按钮激活状态 */
  .action-btn.favorited {
    color: var(--color-warning, #faad14);
    background: var(--color-warning-bg, #fffbe6);
    border-color: var(--color-warning, #faad14);
  }

  .action-btn.favorited svg {
    fill: var(--color-warning, #faad14);
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .article-container {
      padding: 0 16px;
    }

    .article-title {
      font-size: 1.75rem;
    }

    .article-meta {
      gap: 12px;
    }

    .article-nav {
      flex-direction: column;
    }

    .article-nav-item.next {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>

<script>
  // 处理点赞
  async function handleLike() {
    const likeBtn = document.getElementById('like-btn');
    const isSynced = likeBtn?.getAttribute('data-synced') === 'true';
    const articleId = likeBtn?.getAttribute('data-article-id');

    if (!isSynced) {
      alert('此文章尚未同步到数据库，无法点赞');
      return;
    }

    if (!articleId) {
      alert('文章ID不存在');
      return;
    }

    const visitorId = getVisitorId();
    const userId = getUserId();

    try {
      const response = await fetch(`/api/articles/${articleId}/like`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userId: userId,
          visitorId: visitorId
        })
      });

      if (response.ok) {
        const result = await response.json();
        if (result.code === 200) {
          const data = result.data;
          const countEl = likeBtn?.querySelector('.like-count');
          if (countEl) {
            countEl.textContent = data.likeCount;
          }

          if (data.action === 'like') {
            likeBtn?.setAttribute('data-has-liked', 'true');
            likeBtn?.classList.add('liked');
          } else {
            likeBtn?.setAttribute('data-has-liked', 'false');
            likeBtn?.classList.remove('liked');
          }
        }
      }
    } catch (error) {
      console.error('点赞失败:', error);
    }
  }

  // 处理收藏（已移到下方）

  // 处理分享
  function handleShare() {
    if (navigator.share) {
      navigator.share({
        title: document.title,
        url: window.location.href
      });
    } else {
      // 复制链接到剪贴板
      navigator.clipboard.writeText(window.location.href);
      alert('链接已复制到剪贴板');
    }
  }

  // 滚动到评论区
  function scrollToComments() {
    const commentBtn = document.querySelector('.comment-btn');
    const isSynced = commentBtn?.getAttribute('data-synced') === 'true';

    if (!isSynced) {
      alert('此文章尚未同步到数据库，评论功能不可用');
      return;
    }

    // 如果有评论区，滚动到那里
    const commentsSection = document.getElementById('comments');
    if (commentsSection) {
      commentsSection.scrollIntoView({ behavior: 'smooth' });
    } else {
      alert('评论区功能开发中...');
    }
  }

  // 获取或生成访客ID
  function getVisitorId() {
    let visitorId = localStorage.getItem('lm_visitor_id');
    if (!visitorId) {
      visitorId = 'v_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now();
      localStorage.setItem('lm_visitor_id', visitorId);
    }
    return visitorId;
  }

  // 获取用户Token
  function getUserToken() {
    return localStorage.getItem('token') || sessionStorage.getItem('token');
  }

  // 获取当前用户ID（从token解析，简化处理）
  function getUserId() {
    const token = getUserToken();
    if (!token) return null;
    try {
      const payload = JSON.parse(atob(token.split('.')[1]));
      return payload.userId || payload.sub || null;
    } catch {
      return null;
    }
  }

  // 页面加载完成后初始化
  document.addEventListener('DOMContentLoaded', async () => {
    const articleId = document.querySelector('.article-container')?.getAttribute('data-article-id');
    if (!articleId) return;

    // 1. 检查点赞/收藏状态
    await checkUserStatus(articleId);

    // 2. 延迟3秒后记录浏览（有效浏览）
    setTimeout(() => {
      recordView(articleId);
    }, 3000);
  });

  // 检查用户状态（是否已点赞/收藏）
  async function checkUserStatus(articleId: string) {
    try {
      const visitorId = getVisitorId();
      const token = getUserToken();
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = `Bearer ${token}`;

      const response = await fetch(`/api/articles/${articleId}/check?visitorId=${visitorId}`, { headers });
      if (response.ok) {
        const result = await response.json();
        if (result.code === 200) {
          updateUIState(result.data);
        }
      }
    } catch (error) {
      console.error('检查用户状态失败:', error);
    }
  }

  // 更新UI状态
  function updateUIState(data: { hasLiked?: boolean; hasFavorited?: boolean }) {
    const likeBtn = document.getElementById('like-btn');
    const favoriteBtn = document.getElementById('favorite-btn');

    if (likeBtn && data.hasLiked) {
      likeBtn.setAttribute('data-has-liked', 'true');
      likeBtn.classList.add('liked');
    }

    if (favoriteBtn && data.hasFavorited) {
      favoriteBtn.setAttribute('data-has-favorited', 'true');
      favoriteBtn.classList.add('favorited');
      const textEl = favoriteBtn.querySelector('.favorite-text');
      if (textEl) textEl.textContent = '已收藏';
    }
  }

  // 记录浏览
  async function recordView(articleId: string) {
    try {
      const visitorId = getVisitorId();
      const userId = getUserId();

      const response = await fetch(`/api/articles/${articleId}/view`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userId: userId,
          visitorId: visitorId,
          userAgent: navigator.userAgent
        })
      });

      if (response.ok) {
        const result = await response.json();
        if (result.code === 200 && result.data.success) {
          console.log('浏览记录成功');
        }
      }
    } catch (error) {
      console.error('记录浏览失败:', error);
    }
  }

  // 处理收藏
  async function handleFavorite() {
    const favoriteBtn = document.getElementById('favorite-btn');
    const articleId = favoriteBtn?.getAttribute('data-article-id');
    const isSynced = favoriteBtn?.getAttribute('data-synced') === 'true';

    if (!isSynced) {
      alert('此文章尚未同步到数据库，无法收藏');
      return;
    }

    if (!articleId) {
      alert('文章ID不存在');
      return;
    }

    const token = getUserToken();
    if (!token) {
      alert('请先登录后再收藏');
      return;
    }

    try {
      const response = await fetch(`/api/articles/${articleId}/favorite`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        }
      });

      if (response.ok) {
        const result = await response.json();
        if (result.code === 200) {
          const data = result.data;
          const textEl = favoriteBtn?.querySelector('.favorite-text');

          if (data.action === 'favorite') {
            favoriteBtn?.setAttribute('data-has-favorited', 'true');
            favoriteBtn?.classList.add('favorited');
            if (textEl) textEl.textContent = '已收藏';
          } else {
            favoriteBtn?.setAttribute('data-has-favorited', 'false');
            favoriteBtn?.classList.remove('favorited');
            if (textEl) textEl.textContent = '收藏';
          }
        }
      } else if (response.status === 401) {
        alert('请先登录后再收藏');
      }
    } catch (error) {
      console.error('收藏失败:', error);
      alert('操作失败，请稍后重试');
    }
  }
</script>
