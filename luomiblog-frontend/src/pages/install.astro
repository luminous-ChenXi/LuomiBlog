---
import Layout from '../layouts/Layout.astro';
import InstallWizard from '../components/InstallWizard.vue';

// 安装页面不需要显示导航栏
---

<Layout title="LuomiBlog 安装向导">
  <div class="install-page">
    <!-- 装饰背景 -->
    <div class="decoration-bg">
      <div class="decoration-circle circle-1"></div>
      <div class="decoration-circle circle-2"></div>
      <div class="decoration-circle circle-3"></div>
    </div>
    
    <div class="install-container">
      <div class="install-header">
        <div class="logo-section">
          <div class="logo-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
            </svg>
          </div>
          <h1 class="install-title">LuomiBlog 安装向导</h1>
        </div>
        <p class="install-subtitle">欢迎使用 LuomiBlog，请按照以下步骤完成安装配置</p>
      </div>
      
      <InstallWizard client:load />
      
      <div class="install-footer">
        <p>LuomiBlog - 基于 Astro + Vue + SpringBoot 的 AI 知识库博客</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .install-page {
    min-height: 100vh;
    background: var(--color-bg);
    position: relative;
    overflow: hidden;
    padding: 2rem 1rem;
  }

  /* 装饰背景 */
  .decoration-bg {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 0;
  }

  .decoration-circle {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
  }

  .circle-1 {
    width: 400px;
    height: 400px;
    background: linear-gradient(135deg, rgba(255, 107, 157, 0.3) 0%, rgba(255, 143, 171, 0.2) 100%);
    top: -100px;
    right: -100px;
  }

  .circle-2 {
    width: 300px;
    height: 300px;
    background: linear-gradient(135deg, rgba(78, 205, 196, 0.25) 0%, rgba(168, 230, 207, 0.15) 100%);
    bottom: 10%;
    left: -100px;
  }

  .circle-3 {
    width: 250px;
    height: 250px;
    background: linear-gradient(135deg, rgba(135, 206, 235, 0.2) 0%, rgba(125, 211, 252, 0.15) 100%);
    top: 40%;
    right: 5%;
  }

  .install-container {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .install-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .logo-section {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .logo-icon {
    width: 56px;
    height: 56px;
    background: var(--gradient-primary);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: var(--shadow-brand);
  }

  .install-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    background: linear-gradient(135deg, var(--color-brand-primary) 0%, var(--color-brand-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .install-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0;
    opacity: 0.8;
  }

  .install-footer {
    text-align: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .install-footer p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 640px) {
    .install-page {
      padding: 1.5rem 1rem;
    }

    .logo-section {
      flex-direction: column;
      gap: 0.75rem;
    }

    .install-title {
      font-size: 1.5rem;
    }

    .install-subtitle {
      font-size: 0.875rem;
    }

    .decoration-circle {
      filter: blur(60px);
      opacity: 0.3;
    }

    .circle-1 {
      width: 250px;
      height: 250px;
    }

    .circle-2 {
      width: 200px;
      height: 200px;
    }

    .circle-3 {
      width: 150px;
      height: 150px;
    }
  }
</style>
