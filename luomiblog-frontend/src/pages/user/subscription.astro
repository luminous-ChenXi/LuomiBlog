---
import UserCenterLayout from '../../layouts/UserCenterLayout.astro';

const currentPlan = {
  name: 'AI 智能会员',
  status: 'active',
  expiryDate: '永久',
  features: ['AI 智能问答', '文章智能推荐', '优先客服支持', '无广告体验']
};

const plans = [
  {
    name: '免费版',
    price: 0,
    period: '永久',
    description: '基础功能免费使用',
    features: ['浏览文章', '基础评论', '收藏文章'],
    current: false,
    popular: false
  },
  {
    name: '月度会员',
    price: 29,
    period: '月',
    description: '适合短期体验',
    features: ['AI 智能问答', '文章智能推荐', '优先客服支持', '无广告体验'],
    current: false,
    popular: false
  },
  {
    name: '年度会员',
    price: 199,
    period: '年',
    description: '最受欢迎的选择',
    features: ['AI 智能问答', '文章智能推荐', '优先客服支持', '无广告体验', '专属徽章', '年度礼包'],
    current: true,
    popular: true
  },
  {
    name: '永久会员',
    price: 599,
    period: '永久',
    description: '一次付费，终身享用',
    features: ['AI 智能问答', '文章智能推荐', '优先客服支持', '无广告体验', '专属徽章', '终身特权', '新功能优先体验'],
    current: false,
    popular: false
  }
];

const history = [
  { action: '升级年度会员', date: '2026-02-28', points: -1990 },
  { action: '月度会员续费', date: '2026-01-28', points: -290 },
  { action: '开通月度会员', date: '2025-12-28', points: -290 },
];
---

<UserCenterLayout title="会员订阅 - 用户中心" activeMenu="subscription">
  <div class="page-header">
    <h1 class="page-title">会员订阅</h1>
  </div>

  <!-- 激活码兑换区域 -->
  <div class="activation-section">
    <div class="activation-card">
      <div class="activation-header">
        <svg class="activation-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <div class="activation-info">
          <h3 class="activation-title">激活码兑换</h3>
          <p class="activation-desc">通过第三方充值后，使用系统发送的激活码激活会员</p>
        </div>
      </div>
      <div class="activation-form">
        <input 
          type="text" 
          id="activationCode"
          class="activation-input" 
          placeholder="请输入激活码（如：VIP-XXXX-XXXX-XXXX）"
          maxlength="20"
        />
        <button class="btn btn-activate" onclick="handleActivate()">
          立即激活
        </button>
      </div>
      <p class="activation-tip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" x2="12" y1="16" y2="12"/>
          <line x1="12" x2="12.01" y1="8" y2="8"/>
        </svg>
        激活码将通过邮件发送，请注意查收
      </p>
    </div>
  </div>

  <!-- 当前会员状态 -->
  <div class="current-plan-card">
    <div class="plan-header">
      <div class="plan-info">
        <span class="plan-badge">当前套餐</span>
        <h2 class="plan-name">{currentPlan.name}</h2>
        <p class="plan-expiry">有效期至：{currentPlan.expiryDate}</p>
      </div>
      <div class="plan-status">
        <span class="status-badge active">生效中</span>
      </div>
    </div>
    <div class="plan-features">
      {currentPlan.features.map((feature) => (
        <div class="feature-item">
          <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>{feature}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- 会员套餐 -->
  <div class="section-title">
    <h2>升级套餐</h2>
    <p>选择适合您的会员方案</p>
  </div>

  <div class="plans-grid">
    {plans.map((plan) => (
      <div class={`plan-card ${plan.current ? 'current' : ''} ${plan.popular ? 'popular' : ''}`}>
        {plan.popular && <span class="popular-badge">最受欢迎</span>}
        <h3 class="plan-title">{plan.name}</h3>
        <p class="plan-desc">{plan.description}</p>
        <div class="plan-price">
          <span class="price-symbol">¥</span>
          <span class="price-value">{plan.price}</span>
          <span class="price-period">/{plan.period}</span>
        </div>
        <ul class="plan-feature-list">
          {plan.features.map((feature) => (
            <li class="feature-list-item">
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
        {plan.current ? (
          <button class="btn btn-current" disabled>当前套餐</button>
        ) : (
          <button class="btn btn-primary">选择套餐</button>
        )}
      </div>
    ))}
  </div>

  <!-- 订阅历史 -->
  <div class="section-title">
    <h2>订阅历史</h2>
  </div>

  <div class="history-container">
    {history.length > 0 ? (
      <div class="history-list">
        {history.map((item) => (
          <div class="history-item">
            <div class="history-info">
              <span class="history-action">{item.action}</span>
              <span class="history-date">{item.date}</span>
            </div>
            <span class={`history-points ${item.points < 0 ? 'negative' : 'positive'}`}>
              {item.points > 0 ? '+' : ''}{item.points} 积分
            </span>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>暂无订阅记录</p>
      </div>
    )}
  </div>
</UserCenterLayout>

<style>
  .page-header {
    margin-bottom: 24px;
  }

  .page-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  /* 激活码区域 */
  .activation-section {
    margin-bottom: 32px;
  }

  .activation-card {
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    border: 1px solid #bae6fd;
    border-radius: 16px;
    padding: 24px;
  }

  .activation-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .activation-icon {
    width: 48px;
    height: 48px;
    padding: 12px;
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    border-radius: 12px;
    color: white;
    flex-shrink: 0;
  }

  .activation-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 4px 0;
  }

  .activation-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .activation-form {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
  }

  .activation-input {
    flex: 1;
    padding: 12px 16px;
    border: 2px solid #e2e8f0;
    border-radius: 10px;
    font-size: 14px;
    background: white;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .activation-input:focus {
    outline: none;
    border-color: #0ea5e9;
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
  }

  .activation-input::placeholder {
    text-transform: none;
    letter-spacing: normal;
  }

  .btn-activate {
    padding: 12px 24px;
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-activate:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
  }

  .btn-activate:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .activation-tip {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 13px;
    color: #64748b;
  }

  .activation-tip svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .activation-form {
      flex-direction: column;
    }

    .btn-activate {
      width: 100%;
    }
  }

  /* 当前套餐卡片 */
  .current-plan-card {
    background: linear-gradient(135deg, #ff6b9d 0%, #e87a9f 100%);
    border-radius: 16px;
    padding: 24px;
    color: white;
    margin-bottom: 32px;
  }

  .plan-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
  }

  .plan-badge {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    font-size: 12px;
    margin-bottom: 8px;
  }

  .plan-name {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 8px 0;
  }

  .plan-expiry {
    font-size: 14px;
    opacity: 0.9;
    margin: 0;
  }

  .status-badge {
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
  }

  .status-badge.active {
    background: rgba(255, 255, 255, 0.2);
  }

  .plan-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .feature-icon {
    width: 18px;
    height: 18px;
  }

  /* 套餐选择区 */
  .section-title {
    margin-bottom: 20px;
  }

  .section-title h2 {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 4px 0;
  }

  .section-title p {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }

  .plan-card {
    background: var(--color-card);
    border-radius: 16px;
    padding: 24px;
    border: 2px solid transparent;
    position: relative;
    transition: all 0.2s ease;
  }

  .plan-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .plan-card.current {
    border-color: #ff6b9d;
  }

  .plan-card.popular {
    border-color: #fbbf24;
  }

  .popular-badge {
    position: absolute;
    top: -10px;
    right: 20px;
    padding: 4px 12px;
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    color: white;
    font-size: 12px;
    font-weight: 500;
    border-radius: 20px;
  }

  .plan-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 4px 0;
  }

  .plan-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin: 0 0 16px 0;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 2px;
    margin-bottom: 20px;
  }

  .price-symbol {
    font-size: 18px;
    color: #ff6b9d;
  }

  .price-value {
    font-size: 36px;
    font-weight: 700;
    color: #ff6b9d;
  }

  .price-period {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .plan-feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .feature-list-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--color-text);
  }

  .check-icon {
    width: 16px;
    height: 16px;
    color: #16a34a;
    flex-shrink: 0;
  }

  .btn {
    width: 100%;
    padding: 12px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #ff6b9d 0%, #e87a9f 100%);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 107, 157, 0.3);
  }

  .btn-current {
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    cursor: not-allowed;
  }

  /* 历史记录 */
  .history-container {
    background: var(--color-card);
    border-radius: 16px;
    padding: 20px;
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .history-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .history-item:last-child {
    border-bottom: none;
  }

  .history-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .history-action {
    font-size: 14px;
    color: var(--color-text);
  }

  .history-date {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .history-points {
    font-size: 14px;
    font-weight: 500;
  }

  .history-points.negative {
    color: #dc2626;
  }

  .history-points.positive {
    color: #16a34a;
  }

  .empty-state {
    text-align: center;
    padding: 40px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .plan-header {
      flex-direction: column;
      gap: 12px;
    }

    .plans-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { ElMessage } from 'element-plus';

  const API_BASE_URL = document.querySelector('meta[name="api-base-url"]')?.getAttribute('content') || '';

  // 获取 Token
  function getToken(): string | null {
    if (typeof localStorage !== 'undefined') {
      return localStorage.getItem('token');
    }
    return null;
  }

  // 发送 POST 请求
  async function post<T>(path: string, data: any): Promise<T> {
    const url = new URL(path, API_BASE_URL);
    
    const headers: Record<string, string> = {
      'Content-Type': 'application/json'
    };

    const token = getToken();
    if (token) {
      headers['Authorization'] = `Bearer ${token}`;
    }

    const response = await fetch(url.toString(), {
      method: 'POST',
      headers,
      body: JSON.stringify(data)
    });

    if (!response.ok) {
      const error = await response.json().catch(() => ({}));
      throw new Error(error.message || `HTTP ${response.status}`);
    }

    const result = await response.json();

    if (result.code !== 200) {
      throw new Error(result.message);
    }

    return result.data;
  }

  // 格式化激活码输入（自动添加横线）
  function formatActivationCode(input: HTMLInputElement) {
    let value = input.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
    
    // 每4个字符添加一个横线
    const parts = [];
    for (let i = 0; i < value.length && i < 12; i += 4) {
      parts.push(value.substring(i, i + 4));
    }
    
    input.value = parts.join('-');
  }

  // 处理激活码提交
  async function handleActivate() {
    const input = document.getElementById('activationCode') as HTMLInputElement;
    const code = input.value.trim().toUpperCase();
    
    if (!code) {
      ElMessage.warning('请输入激活码');
      return;
    }
    
    // 验证格式
    const codePattern = /^[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$/;
    if (!codePattern.test(code)) {
      ElMessage.error('激活码格式不正确，应为：XXXX-XXXX-XXXX');
      return;
    }
    
    const btn = document.querySelector('.btn-activate') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = '激活中...';
    
    try {
      // 调用后端API验证激活码
      await post('/api/user/activate', { code });
      
      ElMessage.success('激活成功！会员权益已生效');
      input.value = '';
      
      // 刷新页面以更新会员状态
      setTimeout(() => {
        window.location.reload();
      }, 1500);
    } catch (error: any) {
      const errorMsg = error.message || '激活失败';
      
      if (errorMsg.includes('无效') || errorMsg.includes('不存在')) {
        ElMessage.error('激活码无效或不存在，请检查输入');
      } else if (errorMsg.includes('已使用')) {
        ElMessage.error('该激活码已被使用');
      } else if (errorMsg.includes('过期')) {
        ElMessage.error('激活码已过期');
      } else {
        ElMessage.error(errorMsg);
      }
    } finally {
      btn.disabled = false;
      btn.textContent = '立即激活';
    }
  }

  // 绑定输入事件
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('activationCode') as HTMLInputElement;
    if (input) {
      input.addEventListener('input', () => formatActivationCode(input));
      
      // 回车提交
      input.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          handleActivate();
        }
      });
    }
  });

  // 暴露到全局
  (window as any).handleActivate = handleActivate;
</script>
