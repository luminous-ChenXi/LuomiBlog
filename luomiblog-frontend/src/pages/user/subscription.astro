---
import UserCenterLayout from '../../layouts/UserCenterLayout.astro';

const currentPlan = {
  name: 'AI 智能会员',
  status: 'active',
  expiryDate: '永久',
  features: ['AI 智能问答', '文章智能推荐', '优先客服支持', '无广告体验']
};

const plans = [
  {
    name: '免费版',
    price: 0,
    period: '永久',
    description: '基础功能免费使用',
    features: ['浏览文章', '基础评论', '收藏文章'],
    current: false,
    popular: false
  },
  {
    name: '月度会员',
    price: 29,
    period: '月',
    description: '适合短期体验',
    features: ['AI 智能问答', '文章智能推荐', '优先客服支持', '无广告体验'],
    current: false,
    popular: false
  },
  {
    name: '年度会员',
    price: 199,
    period: '年',
    description: '最受欢迎的选择',
    features: ['AI 智能问答', '文章智能推荐', '优先客服支持', '无广告体验', '专属徽章', '年度礼包'],
    current: true,
    popular: true
  },
  {
    name: '永久会员',
    price: 599,
    period: '永久',
    description: '一次付费，终身享用',
    features: ['AI 智能问答', '文章智能推荐', '优先客服支持', '无广告体验', '专属徽章', '终身特权', '新功能优先体验'],
    current: false,
    popular: false
  }
];

const history = [
  { action: '升级年度会员', date: '2026-02-28', points: -1990 },
  { action: '月度会员续费', date: '2026-01-28', points: -290 },
  { action: '开通月度会员', date: '2025-12-28', points: -290 },
];
---

<UserCenterLayout title="会员订阅 - 用户中心" activeMenu="subscription">
  <div class="page-header">
    <h1 class="page-title">会员订阅</h1>
  </div>

  <!-- 当前会员状态 -->
  <div class="current-plan-card">
    <div class="plan-header">
      <div class="plan-info">
        <span class="plan-badge">当前套餐</span>
        <h2 class="plan-name">{currentPlan.name}</h2>
        <p class="plan-expiry">有效期至：{currentPlan.expiryDate}</p>
      </div>
      <div class="plan-status">
        <span class="status-badge active">生效中</span>
      </div>
    </div>
    <div class="plan-features">
      {currentPlan.features.map((feature) => (
        <div class="feature-item">
          <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>{feature}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- 会员套餐 -->
  <div class="section-title">
    <h2>升级套餐</h2>
    <p>选择适合您的会员方案</p>
  </div>

  <div class="plans-grid">
    {plans.map((plan) => (
      <div class={`plan-card ${plan.current ? 'current' : ''} ${plan.popular ? 'popular' : ''}`}>
        {plan.popular && <span class="popular-badge">最受欢迎</span>}
        <h3 class="plan-title">{plan.name}</h3>
        <p class="plan-desc">{plan.description}</p>
        <div class="plan-price">
          <span class="price-symbol">¥</span>
          <span class="price-value">{plan.price}</span>
          <span class="price-period">/{plan.period}</span>
        </div>
        <ul class="plan-feature-list">
          {plan.features.map((feature) => (
            <li class="feature-list-item">
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
        {plan.current ? (
          <button class="btn btn-current" disabled>当前套餐</button>
        ) : (
          <button class="btn btn-primary">选择套餐</button>
        )}
      </div>
    ))}
  </div>

  <!-- 订阅历史 -->
  <div class="section-title">
    <h2>订阅历史</h2>
  </div>

  <div class="history-container">
    {history.length > 0 ? (
      <div class="history-list">
        {history.map((item) => (
          <div class="history-item">
            <div class="history-info">
              <span class="history-action">{item.action}</span>
              <span class="history-date">{item.date}</span>
            </div>
            <span class={`history-points ${item.points < 0 ? 'negative' : 'positive'}`}>
              {item.points > 0 ? '+' : ''}{item.points} 积分
            </span>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>暂无订阅记录</p>
      </div>
    )}
  </div>
</UserCenterLayout>

<style>
  .page-header {
    margin-bottom: 24px;
  }

  .page-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  /* 当前套餐卡片 */
  .current-plan-card {
    background: linear-gradient(135deg, #ff6b9d 0%, #e87a9f 100%);
    border-radius: 16px;
    padding: 24px;
    color: white;
    margin-bottom: 32px;
  }

  .plan-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
  }

  .plan-badge {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    font-size: 12px;
    margin-bottom: 8px;
  }

  .plan-name {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 8px 0;
  }

  .plan-expiry {
    font-size: 14px;
    opacity: 0.9;
    margin: 0;
  }

  .status-badge {
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
  }

  .status-badge.active {
    background: rgba(255, 255, 255, 0.2);
  }

  .plan-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .feature-icon {
    width: 18px;
    height: 18px;
  }

  /* 套餐选择区 */
  .section-title {
    margin-bottom: 20px;
  }

  .section-title h2 {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 4px 0;
  }

  .section-title p {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }

  .plan-card {
    background: var(--color-card);
    border-radius: 16px;
    padding: 24px;
    border: 2px solid transparent;
    position: relative;
    transition: all 0.2s ease;
  }

  .plan-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .plan-card.current {
    border-color: #ff6b9d;
  }

  .plan-card.popular {
    border-color: #fbbf24;
  }

  .popular-badge {
    position: absolute;
    top: -10px;
    right: 20px;
    padding: 4px 12px;
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    color: white;
    font-size: 12px;
    font-weight: 500;
    border-radius: 20px;
  }

  .plan-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 4px 0;
  }

  .plan-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin: 0 0 16px 0;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 2px;
    margin-bottom: 20px;
  }

  .price-symbol {
    font-size: 18px;
    color: #ff6b9d;
  }

  .price-value {
    font-size: 36px;
    font-weight: 700;
    color: #ff6b9d;
  }

  .price-period {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .plan-feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .feature-list-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--color-text);
  }

  .check-icon {
    width: 16px;
    height: 16px;
    color: #16a34a;
    flex-shrink: 0;
  }

  .btn {
    width: 100%;
    padding: 12px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #ff6b9d 0%, #e87a9f 100%);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 107, 157, 0.3);
  }

  .btn-current {
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    cursor: not-allowed;
  }

  /* 历史记录 */
  .history-container {
    background: var(--color-card);
    border-radius: 16px;
    padding: 20px;
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .history-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .history-item:last-child {
    border-bottom: none;
  }

  .history-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .history-action {
    font-size: 14px;
    color: var(--color-text);
  }

  .history-date {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .history-points {
    font-size: 14px;
    font-weight: 500;
  }

  .history-points.negative {
    color: #dc2626;
  }

  .history-points.positive {
    color: #16a34a;
  }

  .empty-state {
    text-align: center;
    padding: 40px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .plan-header {
      flex-direction: column;
      gap: 12px;
    }

    .plans-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
