---
import UserCenterLayout from '../../layouts/UserCenterLayout.astro';

const comments = [
  {
    id: 1,
    content: '这篇文章写得真好，对我帮助很大！特别是关于虚拟线程的部分，讲解得非常清晰。',
    article: {
      title: 'Spring Boot 3.2 新特性探索',
      slug: 'spring-boot-3-2-features',
      cover: 'https://picsum.photos/seed/springboot/100/70'
    },
    date: '2026-03-10 14:30',
    likes: 12,
    replies: 3,
    status: 'approved'
  },
  {
    id: 2,
    content: 'Astro 的 Islands 架构确实很有创意，已经在我的项目中使用了，性能提升明显。',
    article: {
      title: '基于 Astro 的静态博客性能优化实践',
      slug: 'astro-performance-optimization',
      cover: 'https://picsum.photos/seed/astro/100/70'
    },
    date: '2026-03-08 09:15',
    likes: 8,
    replies: 1,
    status: 'approved'
  },
  {
    id: 3,
    content: '请问这个配置在 Windows 环境下有什么不同吗？',
    article: {
      title: 'Vue 3 Composition API 最佳实践',
      slug: 'vue3-composition-api',
      cover: 'https://picsum.photos/seed/vue/100/70'
    },
    date: '2026-03-05 16:45',
    likes: 2,
    replies: 0,
    status: 'pending'
  },
];

const statusMap = {
  approved: { label: '已通过', class: 'status-success' },
  pending: { label: '审核中', class: 'status-warning' },
  rejected: { label: '未通过', class: 'status-danger' },
};
---

<UserCenterLayout title="评论内容 - 用户中心" activeMenu="comments">
  <div class="page-header">
    <h1 class="page-title">评论内容</h1>
    <div class="stats-summary">
      <span class="stat-item">总评论 <strong>{comments.length}</strong></span>
      <span class="stat-divider">|</span>
      <span class="stat-item">获赞 <strong>22</strong></span>
    </div>
  </div>

  <!-- 筛选标签 -->
  <div class="filter-tabs">
    <button class="tab active">全部</button>
    <button class="tab">已通过</button>
    <button class="tab">审核中</button>
  </div>

  <!-- 评论列表 -->
  <div class="comments-container">
    {comments.length > 0 ? (
      <div class="comments-list">
        {comments.map((comment) => (
          <div class="comment-card">
            <div class="comment-header">
              <a href={`/article/${comment.article.slug}`} class="article-link">
                <img src={comment.article.cover} alt={comment.article.title} class="article-thumb" />
                <span class="article-title">{comment.article.title}</span>
              </a>
              <span class={`comment-status ${statusMap[comment.status].class}`}>
                {statusMap[comment.status].label}
              </span>
            </div>
            <div class="comment-body">
              <p class="comment-content">{comment.content}</p>
            </div>
            <div class="comment-footer">
              <div class="comment-meta">
                <span class="meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                  {comment.date}
                </span>
                <span class="meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                  {comment.likes}
                </span>
                <span class="meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  </svg>
                  {comment.replies}
                </span>
              </div>
              <div class="comment-actions">
                <button class="action-btn">查看</button>
                <button class="action-btn danger">删除</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <p class="empty-text">暂无评论记录</p>
        <p class="empty-hint">参与文章讨论，发表你的观点</p>
        <a href="/" class="btn btn-primary">去浏览文章</a>
      </div>
    )}
  </div>

  <!-- 分页 -->
  {comments.length > 0 && (
    <div class="pagination">
      <button class="page-btn" disabled>上一页</button>
      <span class="page-info">第 1 页，共 1 页</span>
      <button class="page-btn" disabled>下一页</button>
    </div>
  )}
</UserCenterLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .page-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .stats-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .stat-item strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .stat-divider {
    color: var(--color-border);
  }

  /* 筛选标签 */
  .filter-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .tab {
    padding: 8px 16px;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--color-card);
    color: var(--color-text-secondary);
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab:hover {
    border-color: #ff6b9d;
    color: #ff6b9d;
  }

  .tab.active {
    background: linear-gradient(135deg, #ff6b9d 0%, #e87a9f 100%);
    border-color: transparent;
    color: white;
  }

  /* 评论列表 */
  .comments-container {
    min-height: 400px;
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .comment-card {
    background: var(--color-card);
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .comment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .article-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-text);
  }

  .article-thumb {
    width: 60px;
    height: 42px;
    border-radius: 6px;
    object-fit: cover;
  }

  .article-title {
    font-size: 14px;
    font-weight: 500;
  }

  .article-link:hover .article-title {
    color: #ff6b9d;
  }

  .comment-status {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
  }

  .status-success {
    background: #dcfce7;
    color: #16a34a;
  }

  .status-warning {
    background: #fef3c7;
    color: #d97706;
  }

  .status-danger {
    background: #fee2e2;
    color: #dc2626;
  }

  .comment-body {
    margin-bottom: 16px;
    padding: 16px;
    background: var(--color-bg);
    border-radius: 12px;
  }

  .comment-content {
    font-size: 14px;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  .comment-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .comment-meta {
    display: flex;
    gap: 16px;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .meta-item svg {
    width: 14px;
    height: 14px;
  }

  .comment-actions {
    display: flex;
    gap: 8px;
  }

  .action-btn {
    padding: 6px 12px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    border-color: #ff6b9d;
    color: #ff6b9d;
  }

  .action-btn.danger:hover {
    border-color: #dc2626;
    color: #dc2626;
  }

  /* 空状态 */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    text-align: center;
    background: var(--color-card);
    border-radius: 16px;
  }

  .empty-icon {
    width: 80px;
    height: 80px;
    color: var(--color-text-tertiary);
    margin-bottom: 16px;
  }

  .empty-text {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 8px 0;
  }

  .empty-hint {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0 0 24px 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
    text-decoration: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #ff6b9d 0%, #e87a9f 100%);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 107, 157, 0.3);
  }

  /* 分页 */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
  }

  .page-btn {
    padding: 8px 16px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-card);
    color: var(--color-text);
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .page-btn:hover:not(:disabled) {
    border-color: #ff6b9d;
    color: #ff6b9d;
  }

  .page-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .page-info {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .comment-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .comment-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .comment-meta {
      width: 100%;
    }
  }
</style>
