---
import UserCenterLayout from '../../layouts/UserCenterLayout.astro';

// 数据全部来自后端 GET /api/articles/favorites/my（登录态，客户端渲染），
// 不再使用硬编码假文章
---

<UserCenterLayout title="我的收藏 - 用户中心" activeMenu="favorites">
  <div class="page-header">
    <h1 class="page-title">我的收藏</h1>
    <span class="favorites-count" id="favorites-count">加载中…</span>
  </div>

  <!-- 收藏夹筛选（由 API folders 渲染） -->
  <div class="filter-bar">
    <div class="category-tabs" id="folder-tabs"></div>
    <div class="sort-dropdown">
      <select class="sort-select" id="page-size-select" aria-label="每页条数">
        <option value="12" selected>每页 12 条</option>
        <option value="24">每页 24 条</option>
        <option value="48">每页 48 条</option>
      </select>
    </div>
  </div>

  <!-- 收藏列表 -->
  <div class="favorites-container">
    <div class="favorites-grid" id="favorites-grid" style="display: none;"></div>

    <div class="empty-state" id="favorites-empty" style="display: none;">
      <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      <p class="empty-text">暂无收藏文章</p>
      <p class="empty-hint">看到喜欢的文章，点击收藏按钮即可保存到这里</p>
      <a href="/articles" class="btn btn-primary">去浏览文章</a>
    </div>

    <div class="empty-state" id="favorites-error" style="display: none;">
      <p class="empty-text">收藏加载失败</p>
      <p class="empty-hint" id="favorites-error-hint">请稍后重试</p>
      <button class="btn btn-primary" id="favorites-retry">重新加载</button>
    </div>
  </div>

  <!-- 分页 -->
  <div class="pagination" id="favorites-pagination" style="display: none;">
    <button class="page-btn" id="prev-page">上一页</button>
    <span class="page-info" id="page-info">第 1 页</span>
    <button class="page-btn" id="next-page">下一页</button>
  </div>
</UserCenterLayout>

<script>
  import { api } from '../../utils/api';
  import type { FavoriteItem } from '../../types/api';

  const state = {
    folder: '' as string, // '' = 全部
    page: 0,
    size: 12,
    totalPages: 1,
    totalElements: 0
  };

  const $ = (id: string) => document.getElementById(id);

  function formatDate(iso: string | null): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '';
    return d.toISOString().split('T')[0];
  }

  function escapeHtml(text: string | null): string {
    if (!text) return '';
    const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
    return text.replace(/[&<>"']/g, m => map[m]);
  }

  function renderFolders(folders: string[]) {
    const tabs = $('folder-tabs');
    if (!tabs) return;
    const all = ['全部', ...folders.filter(f => f && f !== '全部')];
    tabs.innerHTML = all.map(folder => `
      <button class="tab ${folder === state.folder || (folder === '全部' && !state.folder) ? 'active' : ''}" data-folder="${escapeHtml(folder === '全部' ? '' : folder)}">${escapeHtml(folder)}</button>
    `).join('');

    tabs.querySelectorAll('.tab').forEach(btn => {
      btn.addEventListener('click', () => {
        state.folder = (btn as HTMLElement).dataset.folder || '';
        state.page = 0;
        loadFavorites();
      });
    });
  }

  function renderGrid(items: FavoriteItem[]) {
    const grid = $('favorites-grid');
    if (!grid) return;
    grid.innerHTML = items.map(item => {
      const href = `/article/${item.slug || item.articleId}`;
      const category = item.categoryName || '未分类';
      const cover = item.title
        ? `<div class="card-image card-image-placeholder"><span>${escapeHtml(item.title.slice(0, 2))}</span><span class="category-badge">${escapeHtml(category)}</span></div>`
        : '';
      return `
      <article class="favorite-card" data-article-id="${item.articleId}">
        <a href="${href}" class="card-link">
          ${cover}
        </a>
        <div class="card-content">
          <h3 class="card-title"><a href="${href}">${escapeHtml(item.title)}</a></h3>
          <p class="card-excerpt">${escapeHtml(item.summary || '')}</p>
          <div class="card-meta">
            ${item.viewCount != null ? `<span class="meta-item">${item.viewCount} 阅读</span>` : ''}
            ${item.authorName ? `<span class="meta-item">${escapeHtml(item.authorName)}</span>` : ''}
            ${item.folderName ? `<span class="meta-item">${escapeHtml(item.folderName)}</span>` : ''}
          </div>
          <div class="card-footer">
            <span class="favorited-at">收藏于 ${formatDate(item.favoritedAt)}</span>
            <button class="btn-unfavorite" title="取消收藏" data-article-id="${item.articleId}">
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </button>
          </div>
        </div>
      </article>`;
    }).join('');

    grid.querySelectorAll('.btn-unfavorite').forEach(btn => {
      btn.addEventListener('click', () => unfavorite(Number((btn as HTMLElement).dataset.articleId)));
    });
  }

  function updatePaging() {
    const count = $('favorites-count');
    if (count) count.textContent = `共收藏 ${state.totalElements} 篇文章`;

    const pagination = $('favorites-pagination');
    if (!pagination) return;
    if (state.totalPages <= 1) {
      pagination.style.display = 'none';
      return;
    }
    pagination.style.display = '';
    const info = $('page-info');
    if (info) info.textContent = `第 ${state.page + 1} 页，共 ${state.totalPages} 页`;
    const prev = $('prev-page') as HTMLButtonElement | null;
    const next = $('next-page') as HTMLButtonElement | null;
    if (prev) prev.disabled = state.page <= 0;
    if (next) next.disabled = state.page >= state.totalPages - 1;
  }

  function showPanel(which: 'grid' | 'empty' | 'error') {
    const grid = $('favorites-grid');
    const empty = $('favorites-empty');
    const error = $('favorites-error');
    if (grid) grid.style.display = which === 'grid' ? '' : 'none';
    if (empty) empty.style.display = which === 'empty' ? '' : 'none';
    if (error) error.style.display = which === 'error' ? '' : 'none';
  }

  async function loadFavorites() {
    showPanel('grid');
    const grid = $('favorites-grid');
    if (grid) grid.innerHTML = '<p class="loading-text">加载中…</p>';

    try {
      const data = await api.articles.myFavorites(state.folder || undefined, state.page, state.size);
      state.totalPages = data.totalPages;
      state.totalElements = data.totalElements;
      renderFolders(data.folders || []);
      renderGrid(data.items || []);
      updatePaging();
      showPanel(data.items && data.items.length > 0 ? 'grid' : 'empty');
    } catch (err) {
      const message = err instanceof Error ? err.message : '加载失败';
      const hint = $('favorites-error-hint');
      if (hint) hint.textContent = message;
      showPanel('error');
    }
  }

  async function unfavorite(articleId: number) {
    try {
      await api.articles.favorite(articleId, localStorage.getItem('token') || '');
      await loadFavorites();
    } catch (err) {
      const message = err instanceof Error ? err.message : '操作失败';
      alert(`取消收藏失败：${message}`);
    }
  }

  // 初始化
  const sizeSelect = $('page-size-select') as HTMLSelectElement | null;
  if (sizeSelect) {
    sizeSelect.addEventListener('change', () => {
      state.size = Number(sizeSelect.value) || 12;
      state.page = 0;
      loadFavorites();
    });
  }
  const prevBtn = $('prev-page');
  const nextBtn = $('next-page');
  const retryBtn = $('favorites-retry');
  if (prevBtn) prevBtn.addEventListener('click', () => { if (state.page > 0) { state.page--; loadFavorites(); } });
  if (nextBtn) nextBtn.addEventListener('click', () => { if (state.page < state.totalPages - 1) { state.page++; loadFavorites(); } });
  if (retryBtn) retryBtn.addEventListener('click', loadFavorites);

  loadFavorites();
</script>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .page-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .favorites-count {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  /* 筛选栏 */
  .filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .category-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tab {
    padding: 8px 16px;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--color-card);
    color: var(--color-text-secondary);
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab:hover {
    border-color: #ff6b9d;
    color: #ff6b9d;
  }

  .tab.active {
    background: linear-gradient(135deg, #ff6b9d 0%, #e87a9f 100%);
    border-color: transparent;
    color: white;
  }

  .sort-select {
    padding: 8px 16px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-card);
    color: var(--color-text);
    font-size: 14px;
    cursor: pointer;
  }

  /* 收藏列表 */
  .favorites-container {
    min-height: 400px;
  }

  .favorites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .loading-text {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--color-text-secondary);
    padding: 60px 0;
  }

  .favorite-card {
    background: var(--color-card);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    transition: transform 0.2s ease;
  }

  .favorite-card:hover {
    transform: translateY(-4px);
  }

  .card-link {
    display: block;
  }

  .card-image-placeholder {
    position: relative;
    aspect-ratio: 16 / 7;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #ffd9e3 0%, #ffeef3 60%, #e8eefc 100%);
    font-size: 28px;
    font-weight: 700;
    color: rgba(232, 122, 159, 0.85);
  }

  .category-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    font-size: 12px;
    color: var(--color-text);
  }

  .card-content {
    padding: 20px;
  }

  .card-title {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.4;
  }

  .card-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .card-title a:hover {
    color: #ff6b9d;
  }

  .card-excerpt {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 12px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    gap: 16px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .meta-item {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid var(--color-border);
  }

  .favorited-at {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .btn-unfavorite {
    width: 32px;
    height: 32px;
    border: none;
    background: #fee2e2;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .btn-unfavorite svg {
    width: 16px;
    height: 16px;
    color: #dc2626;
  }

  .btn-unfavorite:hover {
    background: #dc2626;
  }

  .btn-unfavorite:hover svg {
    color: white;
  }

  /* 空状态 / 错误态 */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    text-align: center;
    background: var(--color-card);
    border-radius: 16px;
  }

  .empty-icon {
    width: 80px;
    height: 80px;
    color: #ff6b9d;
    margin-bottom: 16px;
    opacity: 0.5;
  }

  .empty-text {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 8px 0;
  }

  .empty-hint {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0 0 24px 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
    text-decoration: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #ff6b9d 0%, #e87a9f 100%);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 107, 157, 0.3);
  }

  /* 分页 */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
  }

  .page-btn {
    padding: 8px 16px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-card);
    color: var(--color-text);
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .page-btn:hover:not(:disabled) {
    border-color: #ff6b9d;
    color: #ff6b9d;
  }

  .page-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .page-info {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .favorites-grid {
      grid-template-columns: 1fr;
    }

    .filter-bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
