---
import UserCenterLayout from '../../layouts/UserCenterLayout.astro';

// 模拟：是否配置了SMTP
const smtpConfigured = true;
---

<UserCenterLayout title="修改密码 - 用户中心" activeMenu="password">
  <div class="page-header">
    <h1 class="page-title">修改密码</h1>
  </div>

  <div class="password-container">
    <div class="security-tips">
      <h3 class="tips-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        安全提示
      </h3>
      <ul class="tips-list">
        <li>密码长度至少8位，建议包含字母、数字和特殊字符</li>
        <li>不要使用与其他网站相同的密码</li>
        <li>定期更换密码可以提高账户安全性</li>
        <li>开启邮箱验证可以更好地保护您的账户</li>
      </ul>
    </div>

    <form class="password-form" id="passwordForm">
      <!-- 旧密码 -->
      <div class="form-group">
        <label class="form-label">
          旧密码
          <span class="required">*</span>
        </label>
        <div class="input-wrapper">
          <input 
            type="password" 
            name="oldPassword" 
            class="form-input" 
            placeholder="请输入当前密码"
            required
            minlength="6"
          />
          <button type="button" class="toggle-password" onclick="togglePassword(this)">
            <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>

      {smtpConfigured && (
        <!-- 邮箱验证码 -->
        <div class="form-group">
          <label class="form-label">
            邮箱验证码
            <span class="required">*</span>
          </label>
          <div class="verify-wrapper">
            <input 
              type="text" 
              name="verifyCode" 
              class="form-input" 
              placeholder="请输入验证码"
              required
              maxlength="6"
            />
            <button type="button" class="btn-send-code" id="sendCodeBtn" onclick="sendVerifyCode()">
              获取验证码
            </button>
          </div>
          <p class="form-hint">验证码将发送到您的注册邮箱：31871368***@qq.com</p>
        </div>
      )}

      <!-- 新密码 -->
      <div class="form-group">
        <label class="form-label">
          新密码
          <span class="required">*</span>
        </label>
        <div class="input-wrapper">
          <input 
            type="password" 
            name="newPassword" 
            class="form-input" 
            placeholder="请输入新密码"
            required
            minlength="8"
            id="newPassword"
          />
          <button type="button" class="toggle-password" onclick="togglePassword(this)">
            <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
        <!-- 密码强度指示器 -->
        <div class="password-strength" id="passwordStrength">
          <div class="strength-bar">
            <div class="strength-fill" id="strengthFill"></div>
          </div>
          <span class="strength-text" id="strengthText">密码强度：请输入密码</span>
        </div>
      </div>

      <!-- 确认新密码 -->
      <div class="form-group">
        <label class="form-label">
          确认新密码
          <span class="required">*</span>
        </label>
        <div class="input-wrapper">
          <input 
            type="password" 
            name="confirmPassword" 
            class="form-input" 
            placeholder="请再次输入新密码"
            required
            minlength="8"
            id="confirmPassword"
          />
          <button type="button" class="toggle-password" onclick="togglePassword(this)">
            <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
        <p class="form-error" id="confirmError"></p>
      </div>

      <!-- 提交按钮 -->
      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="submitBtn">
          确认修改
        </button>
        <button type="reset" class="btn btn-outline">重置</button>
      </div>
    </form>
  </div>
</UserCenterLayout>

<script>
  // 检查密码强度
  function checkPasswordStrength(password: string) {
    const fill = document.getElementById('strengthFill') as HTMLElement | null;
    const text = document.getElementById('strengthText') as HTMLElement | null;
    
    if (!fill || !text) return;
    
    if (!password) {
      fill.style.width = '0%';
      fill.className = 'strength-fill';
      text.textContent = '密码强度：请输入密码';
      return;
    }
    
    let strength = 0;
    if (password.length >= 8) strength++;
    if (password.length >= 12) strength++;
    if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
    if (/\d/.test(password)) strength++;
    if (/[^a-zA-Z0-9]/.test(password)) strength++;
    
    const levels = [
      { width: '20%', class: 'weak', text: '密码强度：弱' },
      { width: '40%', class: 'weak', text: '密码强度：弱' },
      { width: '60%', class: 'medium', text: '密码强度：中' },
      { width: '80%', class: 'medium', text: '密码强度：中' },
      { width: '100%', class: 'strong', text: '密码强度：强' },
    ];
    
    const level = levels[Math.min(strength, 4)];
    fill.style.width = level.width;
    fill.className = `strength-fill ${level.class}`;
    text.textContent = level.text;
  }

  // 表单验证
  const passwordForm = document.getElementById('passwordForm') as HTMLFormElement | null;
  passwordForm?.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const newPasswordInput = document.getElementById('newPassword') as HTMLInputElement | null;
    const confirmPasswordInput = document.getElementById('confirmPassword') as HTMLInputElement | null;
    const confirmError = document.getElementById('confirmError') as HTMLElement | null;
    
    if (!newPasswordInput || !confirmPasswordInput) return;
    
    const newPassword = newPasswordInput.value;
    const confirmPassword = confirmPasswordInput.value;
    
    if (newPassword !== confirmPassword) {
      if (confirmError) confirmError.textContent = '两次输入的密码不一致';
      return;
    }
    
    if (confirmError) confirmError.textContent = '';
    
    // 模拟提交
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
    if (!submitBtn) return;
    
    submitBtn.disabled = true;
    submitBtn.textContent = '修改中...';
    
    setTimeout(() => {
      alert('密码修改成功！请使用新密码重新登录');
      submitBtn.disabled = false;
      submitBtn.textContent = '确认修改';
      passwordForm.reset();
      
      const fill = document.getElementById('strengthFill') as HTMLElement | null;
      const text = document.getElementById('strengthText') as HTMLElement | null;
      if (fill) fill.style.width = '0%';
      if (text) text.textContent = '密码强度：请输入密码';
    }, 1500);
  });

  // 确认密码输入时清除错误
  const confirmPasswordEl = document.getElementById('confirmPassword');
  confirmPasswordEl?.addEventListener('input', function() {
    const confirmError = document.getElementById('confirmError');
    if (confirmError) confirmError.textContent = '';
  });
  
  // 新密码输入时检查强度
  const newPasswordEl = document.getElementById('newPassword');
  newPasswordEl?.addEventListener('input', function(e) {
    const target = e.target as HTMLInputElement;
    checkPasswordStrength(target.value);
  });
</script>

<style>
  .page-header {
    margin-bottom: 24px;
  }

  .page-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .password-container {
    background: var(--color-card);
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  /* 安全提示 */
  .security-tips {
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 32px;
  }

  .tips-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 600;
    color: #92400e;
    margin: 0 0 12px 0;
  }

  .tips-title svg {
    width: 20px;
    height: 20px;
  }

  .tips-list {
    margin: 0;
    padding-left: 20px;
    color: #a16207;
    font-size: 14px;
    line-height: 1.8;
  }

  .tips-list li {
    margin-bottom: 4px;
  }

  /* 表单 */
  .password-form {
    max-width: 480px;
  }

  .form-group {
    margin-bottom: 24px;
  }

  .form-label {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 8px;
  }

  .required {
    color: #dc2626;
    margin-left: 4px;
  }

  .input-wrapper {
    position: relative;
  }

  .form-input {
    width: 100%;
    padding: 12px 44px 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-size: 14px;
    background: var(--color-bg);
    color: var(--color-text);
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .form-input:focus {
    outline: none;
    border-color: #ff6b9d;
    box-shadow: 0 0 0 3px rgba(255, 107, 157, 0.1);
  }

  .toggle-password {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    border: none;
    background: none;
    cursor: pointer;
    padding: 0;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toggle-password:hover {
    color: var(--color-text);
  }

  .eye-icon {
    width: 18px;
    height: 18px;
  }

  /* 验证码 */
  .verify-wrapper {
    display: flex;
    gap: 12px;
  }

  .verify-wrapper .form-input {
    flex: 1;
  }

  .btn-send-code {
    padding: 12px 20px;
    background: linear-gradient(135deg, #ff6b9d 0%, #e87a9f 100%);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-send-code:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 107, 157, 0.3);
  }

  .btn-send-code:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-hint {
    font-size: 12px;
    color: var(--color-text-secondary);
    margin: 8px 0 0 0;
  }

  .form-error {
    font-size: 12px;
    color: #dc2626;
    margin: 8px 0 0 0;
    min-height: 18px;
  }

  /* 密码强度 */
  .password-strength {
    margin-top: 12px;
  }

  .strength-bar {
    height: 4px;
    background: var(--color-bg-secondary);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 6px;
  }

  .strength-fill {
    height: 100%;
    border-radius: 2px;
    transition: all 0.3s ease;
    width: 0%;
  }

  .strength-fill.weak {
    background: #dc2626;
  }

  .strength-fill.medium {
    background: #f59e0b;
  }

  .strength-fill.strong {
    background: #16a34a;
  }

  .strength-text {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  /* 按钮 */
  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 12px 32px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #ff6b9d 0%, #e87a9f 100%);
    color: white;
  }

  .btn-primary:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 107, 157, 0.3);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .btn-outline:hover {
    border-color: #ff6b9d;
    color: #ff6b9d;
  }

  @media (max-width: 768px) {
    .password-container {
      padding: 20px;
    }

    .verify-wrapper {
      flex-direction: column;
    }

    .btn-send-code {
      width: 100%;
    }

    .form-actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>
