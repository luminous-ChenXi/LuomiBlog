---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { API_BASE_URL } from '../../config/api';

export const prerender = false;

const page = parseInt(Astro.url.searchParams.get('page') || '0');
const size = 12;

let articles = [];
let totalPages = 0;
let totalElements = 0;
let backendAvailable = false;

try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 8000);
  const response = await fetch(`${API_BASE_URL}/api/articles?page=${page}&size=${size}`, {
    signal: controller.signal
  });
  clearTimeout(timeoutId);

  if (response.ok) {
    const result = await response.json();
    if (result.code === 200 && result.data) {
      backendAvailable = true;
      const data = result.data;
      articles = (data.content || []).map((a: any) => ({
        title: a.title,
        summary: a.summary || a.description || '',
        date: (a.publishedAt || a.createdAt || '').split('T')[0],
        category: a.category?.name || a.categoryName || '未分类',
        tags: a.tags || [],
        slug: a.slug,
        views: a.viewCount || 0,
        comments: a.commentCount || 0,
        likes: a.likeCount || 0,
        cover: a.coverImage,
        author: a.authorName || (a.author?.nickname || a.author?.username) || '辰汐',
        readTime: Math.max(1, Math.ceil((a.content?.split(/\s+/).length || 300) / 300)),
      }));
      totalPages = data.totalPages || 0;
      totalElements = data.totalElements || 0;
    }
  }
} catch {
  console.info('[Articles] 后端不可用，使用文件系统数据');
}

if (!backendAvailable) {
  const allPosts = await getCollection('blog');
  const sortedPosts = allPosts.sort((a, b) => {
    const dateA = new Date(a.data.pubDate).getTime();
    const dateB = new Date(b.data.pubDate).getTime();
    return dateB - dateA;
  });

  articles = sortedPosts.map(post => {
    const wordCount = post.body?.split(/\s+/).length || 0;
    return {
      title: post.data.title,
      summary: post.data.description,
      date: new Date(post.data.pubDate).toISOString().split('T')[0],
      category: post.data.category || '未分类',
      tags: post.data.tags || [],
      slug: post.slug,
      views: post.data.views || 0,
      comments: post.data.comments || 0,
      likes: post.data.likes || 0,
      cover: post.data.cover,
      author: post.data.author || '辰汐',
      readTime: Math.ceil(wordCount / 300),
    };
  });

  totalElements = articles.length;
  totalPages = Math.ceil(totalElements / size);
  articles = articles.slice(page * size, (page + 1) * size);
}
---

<Layout title="全部文章 - LuomiBlog" description="浏览全部博客文章">
  <Header />
  <main class="articles-page">
    <div class="articles-container">
      <div class="page-header">
        <div class="header-left">
          <div class="header-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" x2="8" y1="13" y2="13"/>
              <line x1="16" x2="8" y1="17" y2="17"/>
              <line x1="10" x2="8" y1="9" y2="9"/>
            </svg>
          </div>
          <div class="header-text">
            <h1 class="page-title">全部文章</h1>
            <p class="page-subtitle">共 {totalElements} 篇文章</p>
          </div>
        </div>
        <a href="/" class="back-home">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          返回首页
        </a>
      </div>

      {articles.length > 0 ? (
        <div class="articles-grid">
          {articles.map((article: any) => (
            <ArticleCard {...article} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          <h3>暂无文章</h3>
          <p>还没有发布任何文章，敬请期待</p>
        </div>
      )}

      {totalPages > 1 && (
        <nav class="pagination">
          {page > 0 && (
            <a href={`/articles?page=${page - 1}`} class="page-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
              </svg>
              上一页
            </a>
          )}
          <span class="page-info">第 {page + 1} / {totalPages} 页</span>
          {page < totalPages - 1 && (
            <a href={`/articles?page=${page + 1}`} class="page-btn">
              下一页
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </a>
          )}
        </nav>
      )}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .articles-page {
    min-height: calc(100vh - 200px);
    background: var(--color-bg);
    padding: 100px 0 80px;
  }

  .articles-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 48px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .header-icon {
    width: 52px;
    height: 52px;
    background: var(--gradient-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: var(--shadow-brand);
  }

  .header-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .page-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .back-home {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--color-card);
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .back-home:hover {
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }

  .back-home svg {
    transition: transform var(--transition-base);
  }

  .back-home:hover svg {
    transform: translateX(-4px);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    animation: fadeInUp 0.5s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100px 20px;
    color: var(--color-text-tertiary);
    gap: 16px;
    text-align: center;
  }

  .empty-state svg {
    opacity: 0.4;
  }

  .empty-state h3 {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .empty-state p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--color-card);
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .page-btn:hover {
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }

  .page-info {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 968px) {
    .articles-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .page-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .page-title {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .articles-container {
      padding: 0 16px;
    }
  }
</style>
