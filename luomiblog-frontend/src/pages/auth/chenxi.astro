---
import Layout from '../../layouts/Layout.astro';

// 辰汐通行证 OAuth 回调页：纯静态壳，授权码换会话的逻辑在客户端脚本中完成
export const prerender = true;
---

<Layout title="辰汐通行证登录 - 辰汐博客">
  <div class="chenxi-callback">
    <div class="callback-card">
      <div class="card-logo">CX</div>
      <h1 class="card-title">辰汐通行证登录</h1>

      <!-- 加载状态 -->
      <div class="state-loading" id="stateLoading">
        <span class="loading-spinner"></span>
        <p class="state-text">正在通过辰汐通行证登录，请稍候…</p>
      </div>

      <!-- 错误状态 -->
      <div class="state-error" id="stateError" hidden>
        <svg class="error-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" x2="12" y1="8" y2="12"/>
          <line x1="12" x2="12.01" y1="16" y2="16"/>
        </svg>
        <p class="state-text" id="errorText">登录失败</p>
        <a class="back-link" href="/">返回首页重新登录</a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { api } from '../../utils/api';
  import { setAuth } from '../../stores/user';
  import { consumeOAuthState } from '../../utils/chenxi';

  const loading = document.getElementById('stateLoading') as HTMLElement | null;
  const errorBox = document.getElementById('stateError') as HTMLElement | null;
  const errorText = document.getElementById('errorText') as HTMLElement | null;

  function showError(message: string) {
    if (loading) loading.hidden = true;
    if (errorBox) errorBox.hidden = false;
    if (errorText) errorText.textContent = message;
  }

  async function handleCallback() {
    const params = new URLSearchParams(window.location.search);

    // 通行证直接返回错误（如用户拒绝授权）
    if (params.get('error')) {
      showError(params.get('error_description') || '通行证授权失败，请重新登录');
      return;
    }

    // 校验 state（防 CSRF）并取回 PKCE 中间态（一次性，读取即清除）
    const oauthState = consumeOAuthState(params.get('state'));
    if (!oauthState) {
      showError('登录状态无效或已过期，请重新登录');
      return;
    }

    const code = params.get('code');
    if (!code) {
      showError('未收到授权码，请重新登录');
      return;
    }

    try {
      // 授权码 + code_verifier 换取本站会话，响应结构与登录接口一致，直接复用 setAuth
      const auth = await api.chenxi.exchange({
        code,
        codeVerifier: oauthState.verifier
      });
      setAuth(auth);
      location.replace('/');
    } catch (error) {
      showError(error instanceof Error && error.message ? error.message : '登录失败，请稍后重试');
    }
  }

  handleCallback();
</script>

<style>
  .chenxi-callback {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .callback-card {
    width: 100%;
    max-width: 380px;
    padding: 3rem 2rem;
    border-radius: 24px;
    background: var(--color-card, white);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    text-align: center;
  }

  .card-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto 1.25rem;
    border-radius: 20px;
    background: linear-gradient(135deg, #F9A8C8 0%, #E87A9F 100%);
    color: white;
    font-size: 1.5rem;
    font-weight: 800;
    box-shadow: 0 8px 24px rgba(232, 122, 159, 0.35);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text, #1a1a2e);
    margin: 0 0 2rem;
  }

  .state-loading,
  .state-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .loading-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba(249, 168, 200, 0.3);
    border-top-color: #E87A9F;
    border-radius: 50%;
    animation: chenxi-spin 0.8s linear infinite;
  }

  @keyframes chenxi-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .state-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary, #6b7280);
    margin: 0;
    line-height: 1.6;
  }

  .error-icon {
    width: 36px;
    height: 36px;
    color: #ef4444;
  }

  .state-error .state-text {
    color: #b91c1c;
  }

  .back-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: #E87A9F;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #d9688f;
  }

  [data-theme="dark"] .callback-card {
    background: #1a1a2e;
  }

  [data-theme="dark"] .card-title {
    color: #e0e0e0;
  }

  [data-theme="dark"] .state-text {
    color: #a0a0b0;
  }
</style>
