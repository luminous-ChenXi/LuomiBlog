---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { API_BASE_URL } from '../../config/api';
---

<AdminLayout title="系统设置">
  <div class="settings-page" id="settings-page">
    <!-- 页面头部 -->
    <header class="admin-section-header">
      <p class="admin-section-subtitle">settings</p>
      <h1 class="admin-section-title">系统设置</h1>
      <p class="admin-section-description">
        站长开关（注册邮箱验证 / 登录两步验证）、SMTP 邮件服务与用户 2FA 管理。
      </p>
    </header>

    <!-- 站长开关 -->
    <div class="glass-panel setting-section">
      <h3 class="section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        站长开关
      </h3>
      <div class="toggle-list">
        <div class="toggle-item">
          <div class="toggle-info">
            <span class="toggle-label">注册邮箱验证</span>
            <span class="toggle-desc">开启后，新用户注册需先完成邮箱验证（6 位验证码或激活链接）才能登录</span>
            <span id="smtp-warning" class="toggle-warning" style="display:none;">
              开启前需先配置下方 SMTP，否则新用户将收不到验证邮件
            </span>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="switch-email-verify" />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div class="toggle-item">
          <div class="toggle-info">
            <span class="toggle-label">登录两步验证（2FA / TOTP）</span>
            <span class="toggle-desc">开启后，所有用户登录需输入认证器 6 位验证码；未绑定用户登录时进入强制绑定流程</span>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="switch-totp" />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>
      <p id="switches-message" class="form-message" style="display:none;"></p>
    </div>

    <!-- SMTP 配置 -->
    <div class="glass-panel setting-section">
      <div class="section-header">
        <h3 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          SMTP 邮件服务
        </h3>
        <span id="smtp-status" class="smtp-status">检测中…</span>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">SMTP 服务器</label>
          <input type="text" id="smtp-host" class="admin-input" placeholder="如：smtp.qq.com" />
        </div>
        <div class="form-group">
          <label class="form-label">端口</label>
          <input type="number" id="smtp-port" class="admin-input" placeholder="587" />
        </div>
        <div class="form-group">
          <label class="form-label">邮箱账号（登录用户名）</label>
          <input type="text" id="smtp-username" class="admin-input" placeholder="your@email.com" />
        </div>
        <div class="form-group">
          <label class="form-label">密码 / 授权码</label>
          <input type="password" id="smtp-password" class="admin-input" placeholder="留空表示沿用已保存的密码" />
          <span id="smtp-password-hint" class="form-hint"></span>
        </div>
        <div class="form-group">
          <label class="form-label">发件人地址</label>
          <input type="email" id="smtp-from" class="admin-input" placeholder="noreply@yourdomain.com" />
        </div>
        <div class="form-group">
          <label class="form-label">加密方式</label>
          <label class="toggle-switch smtp-ssl-switch">
            <input type="checkbox" id="smtp-ssl" checked />
            <span class="toggle-slider"></span>
          </label>
          <span class="form-hint" id="smtp-ssl-label">SSL/TLS（465 端口常用）</span>
        </div>
      </div>
      <p class="form-hint password-mask-hint">安全提示：已保存的密码不会回传浏览器，仅显示"已设置"标记。</p>
      <div class="form-actions">
        <div class="test-group">
          <input type="email" id="smtp-test-to" class="admin-input test-to-input" placeholder="测试收件邮箱" />
          <button class="admin-btn admin-btn-secondary" id="btn-test-smtp">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            发送测试邮件
          </button>
        </div>
        <button class="admin-btn admin-btn-primary" id="btn-save-smtp">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          保存 SMTP 配置
        </button>
      </div>
      <p id="smtp-message" class="form-message" style="display:none;"></p>
    </div>

    <!-- 2FA 管理 -->
    <div class="glass-panel setting-section">
      <h3 class="section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        用户两步验证管理
      </h3>
      <p class="section-desc">用户丢失认证器无法登录时，可重置其 2FA 绑定；该用户下次登录将重新进入绑定流程。</p>
      <div class="user-search-row">
        <input type="text" id="user-search" class="admin-input" placeholder="输入用户名/邮箱搜索用户" />
        <button class="admin-btn admin-btn-secondary" id="btn-search-users">搜索</button>
      </div>
      <div class="user-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>用户名</th>
              <th>邮箱</th>
              <th>角色</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody id="user-tbody">
            <tr><td colspan="5" class="table-empty">输入关键词搜索用户</td></tr>
          </tbody>
        </table>
      </div>
      <p id="reset2fa-message" class="form-message" style="display:none;"></p>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ API_BASE: API_BASE_URL }}>
  // 所有设置接口仅 ADMIN 可访问（后端 /api/admin/** 统一鉴权）
  const $ = (id) => document.getElementById(id);
  const showMessage = (el, text, ok) => {
    if (!el) return;
    el.textContent = text;
    el.style.display = text ? 'block' : 'none';
    el.classList.toggle('message-ok', !!ok);
    el.classList.toggle('message-err', !ok);
  };

  async function apiFetch(path, options = {}) {
    const token = localStorage.getItem('token');
    const headers = { 'Content-Type': 'application/json', ...(options.headers || {}) };
    if (token) headers['Authorization'] = 'Bearer ' + token;
    const resp = await fetch(API_BASE + path, { ...options, headers });
    const body = await resp.json().catch(() => ({}));
    if (body.code !== 200) throw new Error(body.message || ('请求失败 (' + resp.status + ')'));
    return body.data;
  }

  let smtpPasswordSet = false;

  async function loadSettings() {
    try {
      const data = await apiFetch('/api/admin/settings');
      $('switch-email-verify').checked = data.registrationEmailVerifyRequired;
      $('switch-totp').checked = data.loginTotpRequired;
      $('smtp-host').value = data.smtp?.host || '';
      $('smtp-port').value = data.smtp?.port ?? 587;
      $('smtp-username').value = data.smtp?.username || '';
      $('smtp-from').value = data.smtp?.from || '';
      $('smtp-ssl').checked = data.smtp?.ssl ?? true;
      smtpPasswordSet = !!data.smtp?.passwordSet;
      $('smtp-password-hint').textContent = smtpPasswordSet ? '已设置（不回显）' : '未设置';
      updateSmtpStatus(data.smtpConfigured);
      updateSmtpWarning(data.smtpConfigured);
    } catch (error) {
      showMessage($('switches-message'), '加载设置失败：' + error.message, false);
    }
  }

  function updateSmtpStatus(configured) {
    const el = $('smtp-status');
    el.textContent = configured ? '已配置' : '未配置';
    el.classList.toggle('status-on', !!configured);
    el.classList.toggle('status-off', !configured);
  }

  function updateSmtpWarning(configured) {
    $('smtp-warning').style.display = (!configured && $('switch-email-verify').checked) ? 'block' : 'none';
  }

  async function saveSwitches() {
    try {
      const data = await apiFetch('/api/admin/settings/switches', {
        method: 'PUT',
        body: JSON.stringify({
          registrationEmailVerifyRequired: $('switch-email-verify').checked,
          loginTotpRequired: $('switch-totp').checked
        })
      });
      $('switch-email-verify').checked = data.registrationEmailVerifyRequired;
      $('switch-totp').checked = data.loginTotpRequired;
      updateSmtpWarning(data.smtpConfigured);
      showMessage($('switches-message'), data.warning || '开关已保存', !data.warning);
    } catch (error) {
      showMessage($('switches-message'), '保存失败：' + error.message, false);
    }
  }

  async function saveSmtp() {
    try {
      const password = $('smtp-password').value;
      const data = await apiFetch('/api/admin/settings/smtp', {
        method: 'PUT',
        body: JSON.stringify({
          host: $('smtp-host').value.trim(),
          port: Number($('smtp-port').value) || 587,
          username: $('smtp-username').value.trim(),
          password: password || undefined,
          ssl: $('smtp-ssl').checked,
          from: $('smtp-from').value.trim()
        })
      });
      smtpPasswordSet = !!data.smtp?.passwordSet;
      $('smtp-password-hint').textContent = smtpPasswordSet ? '已设置（不回显）' : '未设置';
      $('smtp-password').value = '';
      updateSmtpStatus(data.smtpConfigured);
      updateSmtpWarning(data.smtpConfigured);
      showMessage($('smtp-message'), 'SMTP 配置已保存', true);
    } catch (error) {
      showMessage($('smtp-message'), '保存失败：' + error.message, false);
    }
  }

  async function testSmtp() {
    const to = $('smtp-test-to').value.trim();
    if (!to) { showMessage($('smtp-message'), '请先填写测试收件邮箱', false); return; }
    const btn = $('btn-test-smtp');
    btn.disabled = true;
    try {
      const data = await apiFetch('/api/admin/settings/smtp/test', {
        method: 'POST',
        body: JSON.stringify({ to })
      });
      showMessage($('smtp-message'), data.message || '测试邮件已发送', true);
    } catch (error) {
      showMessage($('smtp-message'), '测试发送失败：' + error.message, false);
    } finally {
      btn.disabled = false;
    }
  }

  async function searchUsers() {
    const keyword = $('user-search').value.trim();
    const tbody = $('user-tbody');
    tbody.innerHTML = '<tr><td colspan="5" class="table-empty">搜索中…</td></tr>';
    try {
      const data = await apiFetch('/api/admin/users?page=0&size=10' + (keyword ? '&search=' + encodeURIComponent(keyword) : ''));
      const users = data.content || [];
      if (users.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="table-empty">未找到用户</td></tr>';
        return;
      }
      tbody.innerHTML = users.map(u => (
        '<tr>' +
        '<td>' + u.id + '</td>' +
        '<td>' + escapeHtml(u.username || '') + '</td>' +
        '<td>' + escapeHtml(u.email || '-') + '</td>' +
        '<td>' + escapeHtml(u.roleName || u.role || '-') + '</td>' +
        '<td><button class="admin-btn admin-btn-secondary btn-reset-2fa" data-id="' + u.id + '" data-name="' + escapeHtml(u.username || '') + '">重置 2FA</button></td>' +
        '</tr>'
      )).join('');
      tbody.querySelectorAll('.btn-reset-2fa').forEach(btn => {
        btn.addEventListener('click', () => reset2fa(Number(btn.dataset.id), btn.dataset.name));
      });
    } catch (error) {
      tbody.innerHTML = '<tr><td colspan="5" class="table-empty">搜索失败：' + escapeHtml(error.message) + '</td></tr>';
    }
  }

  async function reset2fa(id, name) {
    if (!confirm('确认重置用户「' + name + '」的两步验证绑定？该用户下次登录将重新进入绑定流程。')) return;
    try {
      await apiFetch('/api/admin/users/' + id + '/reset-2fa', { method: 'POST' });
      showMessage($('reset2fa-message'), '已重置用户「' + name + '」的 2FA 绑定', true);
    } catch (error) {
      showMessage($('reset2fa-message'), '重置失败：' + error.message, false);
    }
  }

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  // 事件绑定
  $('switch-email-verify').addEventListener('change', saveSwitches);
  $('switch-totp').addEventListener('change', saveSwitches);
  $('btn-save-smtp').addEventListener('click', saveSmtp);
  $('btn-test-smtp').addEventListener('click', testSmtp);
  $('btn-search-users').addEventListener('click', searchUsers);
  $('user-search').addEventListener('keydown', (e) => { if (e.key === 'Enter') searchUsers(); });

  loadSettings();
</script>

<style>
  .settings-page {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .setting-section {
    padding: 28px;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--admin-text);
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--admin-card-border);
  }

  .section-title svg {
    color: var(--admin-primary);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .section-header .section-title {
    flex: 1;
  }

  .section-desc {
    margin: -12px 0 16px;
    font-size: 0.875rem;
    color: var(--admin-text-secondary);
  }

  .smtp-status {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
  }

  .smtp-status.status-on {
    color: #10b981;
    background: rgba(16, 185, 129, 0.12);
  }

  .smtp-status.status-off {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.12);
  }

  /* 开关列表 */
  .toggle-list {
    display: flex;
    flex-direction: column;
  }

  .toggle-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--admin-card-border);
  }

  .toggle-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .toggle-item:first-child {
    padding-top: 0;
  }

  .toggle-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .toggle-label {
    font-weight: 500;
    color: var(--admin-text);
  }

  .toggle-desc {
    font-size: 0.8125rem;
    color: var(--admin-text-secondary);
  }

  .toggle-warning {
    display: block;
    font-size: 0.8125rem;
    color: #f59e0b;
  }

  /* 开关样式 */
  .toggle-switch {
    position: relative;
    width: 52px;
    height: 28px;
    flex-shrink: 0;
    cursor: pointer;
  }

  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    transition: all 0.3s ease;
  }

  .toggle-slider::before {
    content: '';
    position: absolute;
    height: 22px;
    width: 22px;
    left: 3px;
    bottom: 3px;
    background: white;
    border-radius: 50%;
    transition: all 0.3s ease;
  }

  .toggle-switch input:checked + .toggle-slider {
    background: var(--admin-primary);
  }

  .toggle-switch input:checked + .toggle-slider::before {
    transform: translateX(24px);
  }

  /* 表单 */
  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 8px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--admin-text);
  }

  .form-hint {
    font-size: 0.75rem;
    color: var(--admin-text-muted);
  }

  .smtp-ssl-switch {
    align-self: flex-start;
  }

  .password-mask-hint {
    margin: 8px 0 0;
  }

  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 16px;
  }

  .test-group {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .test-to-input {
    width: 240px;
  }

  .form-message {
    margin: 12px 0 0;
    font-size: 0.8125rem;
    padding: 8px 12px;
    border-radius: 8px;
  }

  .form-message.message-ok {
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
  }

  .form-message.message-err {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
  }

  /* 用户表格 */
  .user-search-row {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }

  .user-search-row .admin-input {
    max-width: 320px;
  }

  .user-table-wrap {
    overflow-x: auto;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .admin-table th,
  .admin-table td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--admin-card-border);
    color: var(--admin-text);
  }

  .admin-table th {
    font-weight: 600;
    color: var(--admin-text-secondary);
    font-size: 0.8125rem;
  }

  .table-empty {
    text-align: center;
    color: var(--admin-text-muted);
  }

  @media (max-width: 640px) {
    .form-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .test-group {
      flex-direction: column;
      align-items: stretch;
    }

    .test-to-input {
      width: 100%;
    }
  }
</style>
