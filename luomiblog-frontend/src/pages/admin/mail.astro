---
import AdminLayout from '../../layouts/AdminLayout.astro';

const smtpConfig = {
  host: 'smtpdm.aliyun.com',
  port: 465,
  username: 'chenxi@luminouschenxi.com',
  password: '',
  encryption: 'ssl',
  fromEmail: 'chenxi@luminouschenxi.com',
  fromName: '辰汐小站',
  enabled: true,
};

const templates = [
  {
    id: 1,
    name: '注册验证邮件',
    type: 'register',
    subject: '欢迎注册辰汐小站 - 请验证您的邮箱',
    variables: ['username', 'verifyLink'],
  },
  {
    id: 2,
    name: '密码重置邮件',
    type: 'reset',
    subject: '密码重置请求 - 辰汐小站',
    variables: ['username', 'resetLink'],
  },
  {
    id: 3,
    name: '评论通知邮件',
    type: 'notification',
    subject: '您收到一条新评论 - 辰汐小站',
    variables: ['username', 'articleTitle', 'commentContent'],
  },
];

const encryptionOptions = [
  { value: 'ssl', label: 'SSL' },
  { value: 'tls', label: 'TLS' },
  { value: 'none', label: '不加密' },
];
---

<AdminLayout title="邮箱设置">
  <div class="mail-page">
    <!-- 页面头部 -->
    <header class="admin-section-header">
      <p class="admin-section-subtitle">messaging</p>
      <h1 class="admin-section-title">邮箱设置</h1>
      <p class="admin-section-description">
        配置 SMTP 服务器和邮件模板，用于发送系统通知和用户邮件。
      </p>
    </header>

    <!-- SMTP 配置 -->
    <div class="glass-panel setting-section">
      <div class="section-header">
        <h3 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          SMTP 配置
        </h3>
        <label class="toggle-switch">
          <input type="checkbox" checked={smtpConfig.enabled} />
          <span class="toggle-slider"></span>
        </label>
      </div>

      <div class="config-grid">
        <div class="config-form">
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">SMTP 服务器</label>
              <input type="text" class="admin-input" value={smtpConfig.host} />
            </div>
            <div class="form-group">
              <label class="form-label">端口</label>
              <input type="number" class="admin-input" value={smtpConfig.port} />
            </div>
            <div class="form-group">
              <label class="form-label">邮箱账号</label>
              <input type="text" class="admin-input" value={smtpConfig.username} />
            </div>
            <div class="form-group">
              <label class="form-label">邮箱密码</label>
              <input type="password" class="admin-input" value={smtpConfig.password} placeholder="留空则沿用原密码" />
            </div>
            <div class="form-group">
              <label class="form-label">加密方式</label>
              <select class="admin-input">
                {encryptionOptions.map(opt => (
                  <option value={opt.value} selected={smtpConfig.encryption === opt.value}>{opt.label}</option>
                ))}
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">发件人邮箱</label>
              <input type="email" class="admin-input" value={smtpConfig.fromEmail} />
            </div>
            <div class="form-group">
              <label class="form-label">发件人名称</label>
              <input type="text" class="admin-input" value={smtpConfig.fromName} />
            </div>
          </div>

          <div class="form-actions">
            <button class="admin-btn admin-btn-secondary">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              发送测试邮件
            </button>
            <button class="admin-btn admin-btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              保存配置
            </button>
          </div>
        </div>

        <div class="config-help">
          <h4 class="help-title">配置示例</h4>
          <div class="help-content">
            <div class="help-item">
              <span class="help-label">SMTP 服务器</span>
              <code>smtpdm.aliyun.com</code>
            </div>
            <div class="help-item">
              <span class="help-label">端口</span>
              <code>465</code>
            </div>
            <div class="help-item">
              <span class="help-label">加密方式</span>
              <code>SSL</code>
            </div>
            <div class="help-item">
              <span class="help-label">发件人邮箱</span>
              <code>chenxi@luminouschenxi.com</code>
            </div>
          </div>
          <p class="help-tip">提示：密码通常为邮箱授权码，若无修改请留空。</p>
        </div>
      </div>
    </div>

    <!-- 邮件模板 -->
    <div class="glass-panel setting-section">
      <div class="section-header">
        <h3 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          邮件模板
        </h3>
        <button class="admin-btn admin-btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          新建模板
        </button>
      </div>

      <div class="templates-list">
        {templates.map((template) => (
          <div class="template-card">
            <div class="template-header">
              <div class="template-info">
                <h4 class="template-name">{template.name}</h4>
                <span class={`template-type type-${template.type}`}>
                  {template.type === 'register' && '注册'}
                  {template.type === 'reset' && '重置'}
                  {template.type === 'notification' && '通知'}
                </span>
              </div>
              <div class="template-actions">
                <button class="btn-icon" title="编辑">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                </button>
                <button class="btn-icon" title="测试">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4 20-7z"/></svg>
                </button>
                <button class="btn-icon btn-danger" title="删除">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                </button>
              </div>
            </div>
            <div class="template-subject">
              <span class="subject-label">主题：</span>
              <span class="subject-text">{template.subject}</span>
            </div>
            <div class="template-variables">
              <span class="variables-label">可用变量：</span>
              <div class="variables-list">
                {template.variables.map((variable) => (
                  <code class="variable-tag">{`{${variable}}`}</code>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .mail-page {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* 设置区块 */
  .setting-section {
    padding: 28px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--admin-card-border);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--admin-text);
    margin: 0;
  }

  .section-title svg {
    color: var(--admin-primary);
  }

  /* 配置网格 */
  .config-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 32px;
  }

  @media (max-width: 1024px) {
    .config-grid {
      grid-template-columns: 1fr;
    }
  }

  /* 表单 */
  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--admin-text);
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--admin-card-border);
  }

  /* 帮助面板 */
  .config-help {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--admin-card-border);
    border-radius: 16px;
    padding: 24px;
  }

  .help-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--admin-text);
    margin-bottom: 16px;
  }

  .help-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 16px;
  }

  .help-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
  }

  .help-label {
    color: var(--admin-text-secondary);
  }

  .help-item code {
    background: rgba(255, 255, 255, 0.05);
    padding: 4px 10px;
    border-radius: 6px;
    color: var(--admin-primary);
    font-family: 'Fira Code', monospace;
    font-size: 0.8125rem;
  }

  .help-tip {
    font-size: 0.8125rem;
    color: var(--admin-text-muted);
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--admin-card-border);
  }

  /* 开关样式 */
  .toggle-switch {
    position: relative;
    width: 52px;
    height: 28px;
    cursor: pointer;
  }

  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    transition: all 0.3s ease;
  }

  .toggle-slider::before {
    content: '';
    position: absolute;
    height: 22px;
    width: 22px;
    left: 3px;
    bottom: 3px;
    background: white;
    border-radius: 50%;
    transition: all 0.3s ease;
  }

  .toggle-switch input:checked + .toggle-slider {
    background: var(--admin-primary);
  }

  .toggle-switch input:checked + .toggle-slider::before {
    transform: translateX(24px);
  }

  /* 模板列表 */
  .templates-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .template-card {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--admin-card-border);
    border-radius: 16px;
    padding: 20px;
    transition: all 0.2s ease;
  }

  .template-card:hover {
    border-color: rgba(255, 107, 157, 0.2);
  }

  .template-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .template-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .template-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--admin-text);
    margin: 0;
  }

  .template-type {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .template-type.type-register {
    background: rgba(16, 185, 129, 0.15);
    color: var(--admin-success);
  }

  .template-type.type-reset {
    background: rgba(245, 158, 11, 0.15);
    color: var(--admin-warning);
  }

  .template-type.type-notification {
    background: rgba(59, 130, 246, 0.15);
    color: var(--admin-info);
  }

  .template-actions {
    display: flex;
    gap: 8px;
  }

  .btn-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--admin-card-border);
    background: rgba(255, 255, 255, 0.05);
    color: var(--admin-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-icon:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--admin-text);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .btn-icon.btn-danger:hover {
    background: rgba(239, 68, 68, 0.15);
    color: var(--admin-danger);
    border-color: rgba(239, 68, 68, 0.3);
  }

  .template-subject {
    display: flex;
    gap: 8px;
    font-size: 0.875rem;
    margin-bottom: 12px;
  }

  .subject-label {
    color: var(--admin-text-muted);
  }

  .subject-text {
    color: var(--admin-text-secondary);
  }

  .template-variables {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.8125rem;
  }

  .variables-label {
    color: var(--admin-text-muted);
    flex-shrink: 0;
  }

  .variables-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .variable-tag {
    background: rgba(255, 107, 157, 0.1);
    border: 1px solid rgba(255, 107, 157, 0.2);
    padding: 2px 8px;
    border-radius: 4px;
    color: var(--admin-primary);
    font-family: 'Fira Code', monospace;
    font-size: 0.75rem;
  }
</style>
