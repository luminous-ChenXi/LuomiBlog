---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { API_BASE_URL } from '../../../config/api';
import { getCollection, getEntry } from 'astro:content';

// 获取所有文章用于生成静态路径
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
  }));
}

// 获取当前文章
const { slug } = Astro.params;
const post = await getEntry('blog', slug as string);

// 如果文章不存在，返回 404
if (!post) {
  return Astro.redirect('/admin/articles');
}
---

<AdminLayout title={`编辑文章 - ${post.data.title}`}>
  <div class="article-edit-page" data-slug={slug}>
    <!-- 同步状态提示 -->
    <div id="sync-status-banner" class="sync-banner hidden">
      <div class="sync-banner-content">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
          <line x1="12" x2="12" y1="9" y2="13"/>
          <line x1="12" x2="12.01" y1="17" y2="17"/>
        </svg>
        <span id="sync-status-text">该文章未同步到数据库</span>
        <button id="btn-sync-now" class="btn-sync">立即同步</button>
        <button id="btn-dismiss" class="btn-dismiss">×</button>
      </div>
    </div>

    <!-- 页面头部 -->
    <header class="admin-section-header">
      <div class="header-actions">
        <a href="/admin/articles" class="btn-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          返回列表
        </a>
        <div class="header-title-group">
          <p class="admin-section-subtitle">content</p>
          <h1 class="admin-section-title">编辑文章</h1>
        </div>
      </div>
      <div class="header-buttons">
        <button class="admin-btn admin-btn-secondary" onclick="previewArticle()">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          预览
        </button>
        <button class="admin-btn admin-btn-primary" onclick="saveArticle()">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
            <polyline points="17 21 17 13 7 13 7 21"/>
            <polyline points="7 3 7 8 15 8"/>
          </svg>
          保存修改
        </button>
      </div>
    </header>

    <div class="editor-layout">
      <!-- 左侧编辑区 -->
      <div class="editor-main">
        <div class="glass-panel editor-panel">
          <div class="form-group">
            <label class="form-label">文章标题</label>
            <input type="text" class="admin-input title-input" id="title" value={post.data.title} />
          </div>

          <div class="form-group">
            <label class="form-label">Slug (URL标识)</label>
            <input type="text" class="admin-input" id="slug" value={slug} readonly />
            <span class="form-hint">Slug 确定后尽量不要修改，会影响 SEO</span>
          </div>

          <div class="form-group">
            <label class="form-label">文章摘要</label>
            <textarea class="admin-input summary-input" id="summary" rows="3">{post.data.description}</textarea>
          </div>

          <div class="form-group">
            <label class="form-label">文章内容 (Markdown)</label>
            <div class="editor-toolbar">
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('**', '**')" title="加粗">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('*', '*')" title="斜体">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('# ', '')" title="标题">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12h12"/><path d="M6 20V4"/><path d="M18 20V4"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('- ', '')" title="列表">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('```\n', '\n```')" title="代码块">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('> ', '')" title="引用">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('[', '](url)')" title="链接">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('![alt](', ')')" title="图片">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </button>
            </div>
            <textarea class="admin-input content-input" id="content" rows="25"></textarea>
          </div>
        </div>
      </div>

      <!-- 右侧设置区 -->
      <div class="editor-sidebar">
        <div class="glass-panel settings-panel">
          <h3 class="panel-title">文章设置</h3>

          <div class="form-group">
            <label class="form-label">发布状态</label>
            <select class="admin-input" id="status">
              <option value="draft">草稿</option>
              <option value="published">已发布</option>
              <option value="archived">已归档</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">分类</label>
            <select class="admin-input" id="category">
              <option value="">选择分类</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">标签</label>
            <input type="text" class="admin-input" id="tags" value={post.data.tags?.join(', ')} />
            <span class="form-hint">用逗号分隔</span>
          </div>

          <div class="form-group">
            <label class="form-label">封面图片</label>
            <input type="text" class="admin-input" id="cover" value={post.data.cover} />
          </div>

          <div class="form-group">
            <label class="form-label">作者</label>
            <input type="text" class="admin-input" id="author" value={post.data.author} />
          </div>

          <div class="form-group">
            <label class="form-label">发布日期</label>
            <input type="datetime-local" class="admin-input" id="pubDate" />
          </div>

          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="allowComments" checked />
              <span>允许评论</span>
            </label>
          </div>

          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="allowSuggestions" />
              <span>允许访客建议</span>
            </label>
          </div>

          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="isTop" />
              <span>置顶文章</span>
            </label>
          </div>

          <div class="form-actions">
            <button class="admin-btn admin-btn-danger" onclick="deleteArticle()">删除文章</button>
          </div>
        </div>

        <div class="glass-panel info-panel">
          <h3 class="panel-title">文章信息</h3>
          <div class="info-item">
            <span class="info-label">文件路径</span>
            <span class="info-value" id="file-path">src/content/blog/{slug}.md</span>
          </div>
          <div class="info-item">
            <span class="info-label">数据库状态</span>
            <span class="info-value" id="db-status">检查中...</span>
          </div>
          <div class="info-item">
            <span class="info-label">最后修改</span>
            <span class="info-value" id="last-modified">-</span>
          </div>
          <div class="info-item">
            <span class="info-label">字数统计</span>
            <span class="info-value" id="word-count">-</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 同步确认弹窗 -->
  <div id="sync-modal" class="modal hidden">
    <div class="modal-overlay" onclick="closeSyncModal()"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h3>同步文章到数据库</h3>
        <button class="btn-close" onclick="closeSyncModal()">×</button>
      </div>
      <div class="modal-body">
        <p>该文章当前仅在文件系统中，尚未同步到数据库。</p>
        <p>同步后，文章将在前台展示，并支持评论、点赞等功能。</p>
        <div class="sync-options">
          <label class="radio-label">
            <input type="radio" name="sync-action" value="publish" checked />
            <span>同步并立即发布</span>
          </label>
          <label class="radio-label">
            <input type="radio" name="sync-action" value="draft" />
            <span>同步为草稿</span>
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button class="admin-btn admin-btn-secondary" onclick="closeSyncModal()">取消</button>
        <button class="admin-btn admin-btn-primary" onclick="confirmSync()">确认同步</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ API_BASE_URL, slug, post }}>
  // 文章内容（从文件读取）
  let articleContent = '';
  
  // 获取Token
  function getToken() {
    return localStorage.getItem('token') || sessionStorage.getItem('token');
  }

  // 初始化
  document.addEventListener('DOMContentLoaded', async () => {
    // 加载文章内容
    await loadArticleContent();
    
    // 加载分类
    await loadCategories();
    
    // 检查同步状态
    await checkSyncStatus();
    
    // 设置发布日期
    setupPubDate();
  });

  // 加载文章内容
  async function loadArticleContent() {
    try {
      const response = await fetch(`/src/content/blog/${slug}.md`);
      if (response.ok) {
        const text = await response.text();
        // 提取 frontmatter 后的内容
        const contentMatch = text.match(/^---\n[\s\S]*?\n---\n([\s\S]*)$/);
        articleContent = contentMatch ? contentMatch[1].trim() : text;
        document.getElementById('content').value = articleContent;
        updateWordCount();
      }
    } catch (error) {
      console.error('加载文章内容失败:', error);
      // 使用 post.body 作为备用
      document.getElementById('content').value = post.body || '';
    }
  }

  // 加载分类
  async function loadCategories() {
    try {
      const response = await fetch(`${API_BASE_URL}/api/categories`, {
        headers: { 'Authorization': `Bearer ${getToken()}` }
      });

      if (!response.ok) return;

      const result = await response.json();
      if (result.code === 200) {
        const select = document.getElementById('category');
        result.data.forEach(cat => {
          const option = document.createElement('option');
          option.value = cat.id;
          option.textContent = cat.name;
          if (cat.name === post.data.category) {
            option.selected = true;
          }
          select.appendChild(option);
        });
      }
    } catch (error) {
      console.error('加载分类失败:', error);
    }
  }

  // 检查同步状态
  async function checkSyncStatus() {
    try {
      const response = await fetch(`${API_BASE_URL}/api/articles/slug/${slug}`, {
        headers: { 'Authorization': `Bearer ${getToken()}` }
      });

      const banner = document.getElementById('sync-status-banner');
      const dbStatus = document.getElementById('db-status');

      if (response.status === 404) {
        // 文章未同步
        banner.classList.remove('hidden');
        dbStatus.textContent = '未同步';
        dbStatus.className = 'info-value status-unsynced';
      } else if (response.ok) {
        const result = await response.json();
        if (result.code === 200) {
          dbStatus.textContent = '已同步';
          dbStatus.className = 'info-value status-synced';
          // 填充数据库数据
          fillDatabaseData(result.data);
        }
      }
    } catch (error) {
      console.error('检查同步状态失败:', error);
      document.getElementById('db-status').textContent = '检查失败';
    }
  }

  // 填充数据库数据
  function fillDatabaseData(data) {
    document.getElementById('status').value = data.status || 'draft';
    document.getElementById('allowComments').checked = data.allowComments !== false;
    document.getElementById('allowSuggestions').checked = data.allowSuggestions === true;
    document.getElementById('isTop').checked = data.top === true;
    document.getElementById('last-modified').textContent = new Date(data.updatedAt).toLocaleString();
  }

  // 设置发布日期
  function setupPubDate() {
    const pubDateInput = document.getElementById('pubDate');
    if (post.data.pubDate) {
      const date = new Date(post.data.pubDate);
      const formatted = date.toISOString().slice(0, 16);
      pubDateInput.value = formatted;
    }
  }

  // 插入Markdown
  function insertMarkdown(before, after) {
    const textarea = document.getElementById('content');
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const text = textarea.value;
    const selected = text.substring(start, end);

    textarea.value = text.substring(0, start) + before + selected + after + text.substring(end);
    textarea.focus();
    textarea.selectionStart = start + before.length;
    textarea.selectionEnd = start + before.length + selected.length;
    updateWordCount();
  }

  // 更新字数统计
  function updateWordCount() {
    const content = document.getElementById('content').value;
    const count = content.length;
    document.getElementById('word-count').textContent = count + ' 字';
  }

  // 监听内容变化
  document.getElementById('content')?.addEventListener('input', updateWordCount);

  // 预览文章
  function previewArticle() {
    window.open(`/article/${slug}`, '_blank');
  }

  // 保存文章
  async function saveArticle() {
    const article = {
      title: document.getElementById('title').value,
      slug: slug,
      summary: document.getElementById('summary').value,
      content: document.getElementById('content').value,
      categoryId: document.getElementById('category').value || null,
      tags: document.getElementById('tags').value.split(',').map(t => t.trim()).filter(t => t),
      coverImage: document.getElementById('cover').value,
      status: document.getElementById('status').value,
      allowComments: document.getElementById('allowComments').checked,
      allowSuggestions: document.getElementById('allowSuggestions').checked,
      top: document.getElementById('isTop').checked,
      language: 'zh'
    };

    try {
      // 先检查文章是否存在
      const checkResponse = await fetch(`${API_BASE_URL}/api/articles/slug/${slug}`, {
        headers: { 'Authorization': `Bearer ${getToken()}` }
      });

      let response;
      if (checkResponse.status === 404) {
        // 创建新文章
        response = await fetch(`${API_BASE_URL}/api/articles`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${getToken()}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(article)
        });
      } else {
        // 更新现有文章
        const existing = await checkResponse.json();
        response = await fetch(`${API_BASE_URL}/api/articles/${existing.data.id}`, {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${getToken()}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(article)
        });
      }

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.message || '保存失败');
      }

      alert('保存成功！');
      await checkSyncStatus();
    } catch (error) {
      console.error('保存文章失败:', error);
      alert('保存失败: ' + error.message);
    }
  }

  // 删除文章
  async function deleteArticle() {
    if (!confirm('确定要删除这篇文章吗？此操作不可恢复！')) {
      return;
    }

    try {
      const response = await fetch(`${API_BASE_URL}/api/articles/slug/${slug}`, {
        headers: { 'Authorization': `Bearer ${getToken()}` }
      });

      if (response.ok) {
        const result = await response.json();
        if (result.code === 200) {
          const deleteResponse = await fetch(`${API_BASE_URL}/api/admin/articles/${result.data.id}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${getToken()}` }
          });

          if (deleteResponse.ok) {
            alert('删除成功！');
            window.location.href = '/admin/articles';
            return;
          }
        }
      }
      
      // 如果数据库中没有，只是删除本地文件提示
      alert('文章已从数据库删除（如存在）');
      window.location.href = '/admin/articles';
    } catch (error) {
      console.error('删除文章失败:', error);
      alert('删除失败: ' + error.message);
    }
  }

  // 显示同步弹窗
  document.getElementById('btn-sync-now')?.addEventListener('click', () => {
    document.getElementById('sync-modal').classList.remove('hidden');
  });

  // 关闭同步弹窗
  function closeSyncModal() {
    document.getElementById('sync-modal').classList.add('hidden');
  }

  // 确认同步
  async function confirmSync() {
    const action = document.querySelector('input[name="sync-action"]:checked')?.value || 'draft';
    
    const article = {
      title: document.getElementById('title').value,
      slug: slug,
      summary: document.getElementById('summary').value,
      content: document.getElementById('content').value,
      categoryId: document.getElementById('category').value || null,
      tags: document.getElementById('tags').value.split(',').map(t => t.trim()).filter(t => t),
      coverImage: document.getElementById('cover').value,
      status: action === 'publish' ? 'published' : 'draft',
      allowComments: document.getElementById('allowComments').checked,
      allowSuggestions: document.getElementById('allowSuggestions').checked,
      language: 'zh'
    };

    try {
      const response = await fetch(`${API_BASE_URL}/api/articles`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${getToken()}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(article)
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.message || '同步失败');
      }

      alert('同步成功！');
      closeSyncModal();
      await checkSyncStatus();
      document.getElementById('sync-status-banner').classList.add('hidden');
    } catch (error) {
      console.error('同步文章失败:', error);
      alert('同步失败: ' + error.message);
    }
  }

  // 关闭提示横幅
  document.getElementById('btn-dismiss')?.addEventListener('click', () => {
    document.getElementById('sync-status-banner').classList.add('hidden');
  });
</script>

<style>
  .article-edit-page {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* 同步状态横幅 */
  .sync-banner {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(245, 158, 11, 0.05) 100%);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 12px;
    padding: 16px 20px;
  }

  .sync-banner.hidden {
    display: none;
  }

  .sync-banner-content {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #f59e0b;
  }

  .btn-sync {
    margin-left: auto;
    padding: 8px 16px;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
