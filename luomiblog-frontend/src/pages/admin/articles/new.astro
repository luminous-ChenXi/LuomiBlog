---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { API_BASE_URL } from '../../../config/api';
---

<AdminLayout title="写文章">
  <div class="article-editor-page">
    <!-- 页面头部 -->
    <header class="admin-section-header">
      <p class="admin-section-subtitle">content</p>
      <h1 class="admin-section-title">写文章</h1>
      <p class="admin-section-description">创建新的博客文章，支持 Markdown 格式。</p>
    </header>

    <div class="editor-layout">
      <!-- 左侧编辑区 -->
      <div class="editor-main">
        <div class="glass-panel editor-panel">
          <div class="form-group">
            <label class="form-label">文章标题</label>
            <input type="text" class="admin-input title-input" id="title" placeholder="请输入文章标题..." />
          </div>

          <div class="form-group">
            <label class="form-label">Slug (URL标识)</label>
            <input type="text" class="admin-input" id="slug" placeholder="article-slug" />
            <span class="form-hint">用于生成文章URL，如：my-first-article</span>
          </div>

          <div class="form-group">
            <label class="form-label">文章摘要</label>
            <textarea class="admin-input summary-input" id="summary" rows="3" placeholder="请输入文章摘要..."></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">文章内容 (Markdown)</label>
            <div class="editor-toolbar">
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('**', '**')" title="加粗">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('*', '*')" title="斜体">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('# ', '')" title="标题">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12h12"/><path d="M6 20V4"/><path d="M18 20V4"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('- ', '')" title="列表">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('```\n', '\n```')" title="代码块">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('> ', '')" title="引用">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('[', '](url)')" title="链接">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="insertMarkdown('![alt](', ')')" title="图片">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </button>
            </div>
            <textarea class="admin-input content-input" id="content" rows="20" placeholder="请输入 Markdown 格式的文章内容..."></textarea>
          </div>
        </div>
      </div>

      <!-- 右侧设置区 -->
      <div class="editor-sidebar">
        <div class="glass-panel settings-panel">
          <h3 class="panel-title">发布设置</h3>

          <div class="form-group">
            <label class="form-label">文章状态</label>
            <select class="admin-input" id="status">
              <option value="draft">草稿</option>
              <option value="published">立即发布</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">分类</label>
            <select class="admin-input" id="category">
              <option value="">选择分类</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">标签</label>
            <input type="text" class="admin-input" id="tags" placeholder="用逗号分隔，如：Java, Spring" />
          </div>

          <div class="form-group">
            <label class="form-label">封面图片</label>
            <input type="text" class="admin-input" id="cover" placeholder="图片URL" />
          </div>

          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="allowComments" checked />
              <span>允许评论</span>
            </label>
          </div>

          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="allowSuggestions" />
              <span>允许访客建议</span>
            </label>
          </div>

          <div class="form-actions">
            <button class="admin-btn admin-btn-secondary" onclick="saveDraft()">保存草稿</button>
            <button class="admin-btn admin-btn-primary" onclick="publishArticle()">发布文章</button>
          </div>
        </div>

        <div class="glass-panel tips-panel">
          <h3 class="panel-title">写作提示</h3>
          <ul class="tips-list">
            <li>使用 Markdown 格式编写内容</li>
            <li>文章标题应简洁明了</li>
            <li>摘要会显示在文章列表中</li>
            <li>Slug 确定后尽量不要修改</li>
            <li>定期保存草稿防止丢失</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ API_BASE_URL }}>
  // 获取Token
  function getToken() {
    return localStorage.getItem('token') || sessionStorage.getItem('token');
  }

  // 初始化
  document.addEventListener('DOMContentLoaded', () => {
    loadCategories();
    setupAutoSave();
    loadDraft();
  });

  // 加载分类
  async function loadCategories() {
    try {
      const response = await fetch(`${API_BASE_URL}/api/categories`, {
        headers: { 'Authorization': `Bearer ${getToken()}` }
      });

      if (!response.ok) return;

      const result = await response.json();
      if (result.code === 200) {
        const select = document.getElementById('category');
        result.data.forEach(cat => {
          const option = document.createElement('option');
          option.value = cat.id;
          option.textContent = cat.name;
          select.appendChild(option);
        });
      }
    } catch (error) {
      console.error('加载分类失败:', error);
    }
  }

  // 插入Markdown
  function insertMarkdown(before, after) {
    const textarea = document.getElementById('content');
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const text = textarea.value;
    const selected = text.substring(start, end);

    textarea.value = text.substring(0, start) + before + selected + after + text.substring(end);
    textarea.focus();
    textarea.selectionStart = start + before.length;
    textarea.selectionEnd = start + before.length + selected.length;
  }

  // 自动保存草稿
  function setupAutoSave() {
    setInterval(() => {
      const draft = {
        title: document.getElementById('title').value,
        slug: document.getElementById('slug').value,
        summary: document.getElementById('summary').value,
        content: document.getElementById('content').value,
        category: document.getElementById('category').value,
        tags: document.getElementById('tags').value,
        cover: document.getElementById('cover').value,
        allowComments: document.getElementById('allowComments').checked,
        allowSuggestions: document.getElementById('allowSuggestions').checked,
        savedAt: new Date().toISOString()
      };
      localStorage.setItem('article_draft', JSON.stringify(draft));
    }, 30000);
  }

  // 加载草稿
  function loadDraft() {
    const draft = localStorage.getItem('article_draft');
    if (!draft) return;

    try {
      const data = JSON.parse(draft);
      if (confirm('检测到未发布的草稿，是否恢复？')) {
        document.getElementById('title').value = data.title || '';
        document.getElementById('slug').value = data.slug || '';
        document.getElementById('summary').value = data.summary || '';
        document.getElementById('content').value = data.content || '';
        document.getElementById('category').value = data.category || '';
        document.getElementById('tags').value = data.tags || '';
        document.getElementById('cover').value = data.cover || '';
        document.getElementById('allowComments').checked = data.allowComments !== false;
        document.getElementById('allowSuggestions').checked = data.allowSuggestions === true;
      }
    } catch (e) {
      console.error('加载草稿失败:', e);
    }
  }

  // 保存草稿
  async function saveDraft() {
    await submitArticle('draft', false);
  }

  // 发布文章
  async function publishArticle() {
    await submitArticle('published', true);
  }

  // 提交文章
  async function submitArticle(status, clearDraft) {
    const title = document.getElementById('title').value.trim();
    if (!title) {
      alert('请输入文章标题');
      return;
    }

    const content = document.getElementById('content').value.trim();
    if (!content) {
      alert('请输入文章内容');
      return;
    }

    const article = {
      title: title,
      slug: document.getElementById('slug').value.trim() || generateSlug(title),
      summary: document.getElementById('summary').value.trim(),
      content: content,
      categoryId: document.getElementById('category').value || null,
      tags: document.getElementById('tags').value.split(',').map(t => t.trim()).filter(t => t),
      coverImage: document.getElementById('cover').value.trim(),
      status: status,
      allowComments: document.getElementById('allowComments').checked,
      allowSuggestions: document.getElementById('allowSuggestions').checked,
      language: 'zh'
    };

    try {
      const response = await fetch(`${API_BASE_URL}/api/articles`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${getToken()}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(article)
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.message || '提交失败');
      }

      const result = await response.json();

      if (clearDraft) {
        localStorage.removeItem('article_draft');
      }

      alert(status === 'published' ? '文章发布成功！' : '草稿保存成功！');
      window.location.href = '/admin/articles';
    } catch (error) {
      console.error('提交文章失败:', error);
      alert('提交失败: ' + error.message);
    }
  }

  // 生成Slug
  function generateSlug(title) {
    return title.toLowerCase()
      .replace(/[^\w\u4e00-\u9fa5]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }
</script>

<style>
  .article-editor-page {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .editor-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 24px;
  }

  .editor-main {
    min-width: 0;
  }

  .editor-panel {
    padding: 24px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group:last-child {
    margin-bottom: 0;
  }

  .form-label {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    margin-bottom: 8px;
  }

  .form-hint {
    display: block;
    font-size: 12px;
    color: var(--admin-text-muted);
    margin-top: 4px;
  }

  .title-input {
    font-size: 20px;
    font-weight: 600;
    padding: 16px;
  }

  .summary-input {
    resize: vertical;
    min-height: 80px;
  }

  .content-input {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 14px;
    line-height: 1.8;
    resize: vertical;
    min-height: 400px;
  }

  .editor-toolbar {
    display: flex;
    gap: 4px;
    padding: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
  }

  .toolbar-btn {
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    color: var(--admin-text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .toolbar-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .content-input {
    border-radius: 0 0 8px 8px;
  }

  /* 侧边栏 */
  .editor-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .settings-panel,
  .tips-panel {
    padding: 20px;
  }

  .panel-title {
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    margin: 0 0 16px 0;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-size: 14px;
    color: var(--admin-text-muted);
  }

  .checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--admin-primary);
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .form-actions .admin-btn {
    flex: 1;
  }

  .tips-list {
    margin: 0;
    padding-left: 18px;
    font-size: 13px;
    color: var(--admin-text-muted);
    line-height: 1.8;
  }

  .tips-list li {
    margin-bottom: 8px;
  }

  /* 响应式 */
  @media (max-width: 1024px) {
    .editor-layout {
      grid-template-columns: 1fr;
    }

    .editor-sidebar {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .settings-panel,
    .tips-panel {
      flex: 1;
      min-width: 300px;
    }
  }

  @media (max-width: 768px) {
    .editor-sidebar {
      flex-direction: column;
    }

    .settings-panel,
    .tips-panel {
      min-width: auto;
    }
  }
</style>
