---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { API_BASE_URL } from '../../config/api';
---

<AdminLayout title="文章管理">
  <div class="articles-page" id="articles-page">
    <!-- 同步状态提示 -->
    <div id="sync-alert" class="sync-alert hidden">
      <div class="sync-alert-content">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
        <span id="sync-alert-text">检测到文件系统有新文章，建议同步</span>
        <button class="btn-sync-now" onclick="triggerSync()">立即同步</button>
        <button class="btn-close" onclick="dismissSyncAlert()">×</button>
      </div>
    </div>

    <!-- 页面头部 -->
    <header class="admin-section-header">
      <p class="admin-section-subtitle">content</p>
      <h1 class="admin-section-title">文章管理</h1>
      <p class="admin-section-description">
        管理博客文章，支持从文件系统自动同步，处理冲突和版本控制。
      </p>
    </header>

    <!-- 统计卡片 -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon blue">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <div class="stat-info">
          <span class="stat-value" id="stat-total">0</span>
          <span class="stat-label">文章总数</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon green">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        </div>
        <div class="stat-info">
          <span class="stat-value" id="stat-published">0</span>
          <span class="stat-label">已发布</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon yellow">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-info">
          <span class="stat-value" id="stat-draft">0</span>
          <span class="stat-label">草稿</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon red">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
        </div>
        <div class="stat-info">
          <span class="stat-value" id="stat-conflicts">0</span>
          <span class="stat-label">待处理冲突</span>
        </div>
      </div>
    </div>

    <!-- 工具栏 -->
    <div class="glass-panel toolbar">
      <div class="toolbar-left">
        <div class="search-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" class="admin-input" id="search-input" placeholder="搜索文章标题..." />
        </div>
        <select class="admin-input filter-select" id="category-filter">
          <option value="">全部分类</option>
        </select>
        <select class="admin-input filter-select" id="status-filter">
          <option value="">全部状态</option>
          <option value="published">已发布</option>
          <option value="draft">草稿</option>
          <option value="archived">已归档</option>
        </select>
      </div>
      <div class="toolbar-right">
        <button class="admin-btn admin-btn-secondary" onclick="checkSyncStatus()">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
          检查同步
        </button>
        <button class="admin-btn admin-btn-primary" onclick="triggerSync()">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
          同步文件
        </button>
        <a href="/admin/articles/new" class="admin-btn admin-btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          写文章
        </a>
      </div>
    </div>

    <!-- 文章列表 -->
    <div class="glass-panel table-container">
      <table class="admin-table articles-table">
        <thead>
          <tr>
            <th class="col-checkbox">
              <input type="checkbox" class="checkbox" id="select-all" />
            </th>
            <th class="col-title">
              <span class="th-content">标题</span>
            </th>
            <th class="col-created">
              <span class="th-content">创建时间</span>
            </th>
            <th class="col-views">
              <span class="th-content">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </span>
            </th>
            <th class="col-likes">
              <span class="th-content">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              </span>
            </th>
            <th class="col-category">
              <span class="th-content">分类</span>
            </th>
            <th class="col-more"></th>
          </tr>
        </thead>
        <tbody id="articles-tbody">
          <!-- 动态加载 -->
        </tbody>
      </table>
      <div id="empty-state" class="empty-state hidden">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
        <p>暂无文章</p>
        <span>点击"写文章"或"同步文件"来添加文章</span>
      </div>
    </div>

    <!-- 分页 -->
    <div class="glass-panel pagination-panel" id="pagination-panel">
      <div class="pagination-info">
        <span>共 <strong id="pagination-total">0</strong> 篇文章</span>
        <span>第 <strong id="pagination-current">1</strong> / <strong id="pagination-pages">1</strong> 页</span>
      </div>
      <div class="pagination-controls" id="pagination-controls">
        <!-- 动态生成 -->
      </div>
      <div class="page-size">
        <span>每页</span>
        <select class="admin-input" id="page-size">
          <option value="10">10</option>
          <option value="20" selected>20</option>
          <option value="50">50</option>
        </select>
        <span>条</span>
      </div>
    </div>
  </div>

  <!-- 冲突解决弹窗 -->
  <div id="conflict-modal" class="modal hidden">
    <div class="modal-overlay" onclick="closeConflictModal()"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h3>解决冲突</h3>
        <button class="btn-close" onclick="closeConflictModal()">×</button>
      </div>
      <div class="modal-body">
        <div class="conflict-info">
          <p class="conflict-title" id="conflict-article-title"></p>
          <p class="conflict-desc">文件和数据库版本都被修改，请选择保留哪个版本：</p>
        </div>
        <div class="conflict-options">
          <div class="conflict-option" onclick="resolveConflict('USE_FILE')">
            <div class="option-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div class="option-content">
              <h4>使用文件版本</h4>
              <p>保留文件系统中的最新内容，覆盖数据库</p>
            </div>
          </div>
          <div class="conflict-option" onclick="resolveConflict('USE_DB')">
            <div class="option-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
            </div>
            <div class="option-content">
              <h4>使用数据库版本</h4>
              <p>保留数据库中的内容，忽略文件修改</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 全局下拉菜单 -->
  <div id="global-more-menu" class="more-menu hidden">
    <button class="more-menu-item" id="menu-edit">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
      编辑
    </button>
    <button class="more-menu-item" id="menu-view">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
      查看
    </button>
    <button class="more-menu-item" id="menu-duplicate">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      创建副本
    </button>
    <div class="more-menu-divider"></div>
    <button class="more-menu-item danger" id="menu-delete">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
      删除
    </button>
  </div>
</AdminLayout>

<script define:vars={{ API_BASE_URL }}>
  // 状态管理
  let currentPage = 0;
  let pageSize = 20;
  let totalPages = 1;
  let articles = [];
  let categories = [];
  let currentConflictArticleId = null;

  // 获取Token
  function getToken() {
    return localStorage.getItem('token') || sessionStorage.getItem('token');
  }

  // 初始化
  document.addEventListener('DOMContentLoaded', () => {
    loadArticles();
    loadArticleStats();
    checkSyncStatus();
    setupEventListeners();
  });

  // 设置事件监听
  function setupEventListeners() {
    document.getElementById('search-input')?.addEventListener('input', debounce(() => {
      currentPage = 0;
      loadArticles();
    }, 300));

    document.getElementById('category-filter')?.addEventListener('change', () => {
      currentPage = 0;
      loadArticles();
    });

    document.getElementById('status-filter')?.addEventListener('change', () => {
      currentPage = 0;
      loadArticles();
    });

    document.getElementById('page-size')?.addEventListener('change', (e) => {
      pageSize = parseInt(e.target.value);
      currentPage = 0;
      loadArticles();
    });

    document.getElementById('select-all')?.addEventListener('change', (e) => {
      document.querySelectorAll('.article-checkbox').forEach(cb => {
        cb.checked = e.target.checked;
      });
    });
  }

  // 防抖函数
  function debounce(fn, delay) {
    let timer = null;
    return function(...args) {
      clearTimeout(timer);
      timer = setTimeout(() => fn.apply(this, args), delay);
    };
  }

  // 加载文章列表
  async function loadArticles() {
    try {
      const token = getToken();
      if (!token) {
        showNotification('请先登录', 'error');
        window.location.href = '/?login=1';
        return;
      }

      const search = document.getElementById('search-input')?.value || '';
      const category = document.getElementById('category-filter')?.value || '';
      const status = document.getElementById('status-filter')?.value || '';

      const params = new URLSearchParams({
        page: currentPage.toString(),
        size: pageSize.toString()
      });
      if (search) params.append('search', search);
      if (category) params.append('category', category);
      if (status) params.append('status', status);

      const response = await fetch(`${API_BASE_URL}/api/admin/articles?${params}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (response.status === 403) {
        showNotification('登录已过期，请重新登录', 'error');
        localStorage.removeItem('token');
        sessionStorage.removeItem('token');
        window.location.href = '/?login=1';
        return;
      }

      if (!response.ok) throw new Error('加载失败');

      const result = await response.json();
      if (result.code === 200) {
        articles = result.data.content || [];
        totalPages = result.data.totalPages || 1;
        updateArticlesTable();
        updatePagination(result.data);
        updateStats(result.data.totalElements || 0);
      }
    } catch (error) {
      console.error('加载文章失败:', error);
      showNotification('加载文章失败', 'error');
    }
  }

  // 更新文章表格
  function updateArticlesTable() {
    const tbody = document.getElementById('articles-tbody');
    const emptyState = document.getElementById('empty-state');

    if (!articles.length) {
      tbody.innerHTML = '';
      emptyState?.classList.remove('hidden');
      return;
    }

    emptyState?.classList.add('hidden');

    tbody.innerHTML = articles.map(article => {
      const statusMap = {
        published: { label: '已发布', class: 'admin-badge-success' },
        draft: { label: '草稿', class: 'admin-badge-warning' },
        archived: { label: '已归档', class: 'admin-badge-info' }
      };
      const status = statusMap[article.status] || { label: article.status, class: '' };

      const hasConflict = article.hasConflict;
      const formatDate = (dateStr) => {
        if (!dateStr) return '-';
        const date = new Date(dateStr);
        return date.toLocaleString('zh-CN', { 
          year: 'numeric', 
          month: '2-digit', 
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit'
        });
      };

      return `
        <tr class="${hasConflict ? 'has-conflict' : ''}">
          <td class="col-checkbox">
            <input type="checkbox" class="checkbox article-checkbox" value="${article.id}" />
          </td>
          <td class="col-title">
            <div class="title-cell">
              <svg class="doc-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="M9 15l3 3 3-3"/></svg>
              <span class="article-title">${article.title}</span>
            </div>
          </td>
          <td class="col-created">
            <span class="cell-text">${formatDate(article.createdAt)}</span>
          </td>
          <td class="col-views">
            <span class="cell-text stat-text">${article.viewCount || 0}</span>
          </td>
          <td class="col-likes">
            <span class="cell-text stat-text">${article.likeCount || 0}</span>
          </td>
          <td class="col-category">
            ${article.category ? `<span class="category-badge">${article.category.name}</span>` : '<span class="cell-text">未分类</span>'}
          </td>
          <td class="col-more">
            <div class="more-btn" role="button" tabindex="0" onclick="toggleMoreMenu(${article.id}, event)" onkeydown="if(event.key==='Enter'||event.key===' ')toggleMoreMenu(${article.id}, event)">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  // 更新分页
  function updatePagination(data) {
    document.getElementById('pagination-total').textContent = data.totalElements || 0;
    document.getElementById('pagination-current').textContent = currentPage + 1;
    document.getElementById('pagination-pages').textContent = totalPages;

    const controls = document.getElementById('pagination-controls');
    let html = `
      <button class="btn-page" ${currentPage === 0 ? 'disabled' : ''} onclick="goToPage(${currentPage - 1})">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
    `;

    for (let i = 0; i < totalPages; i++) {
      if (i === 0 || i === totalPages - 1 || (i >= currentPage - 1 && i <= currentPage + 1)) {
        html += `<button class="btn-page ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i + 1}</button>`;
      } else if (i === currentPage - 2 || i === currentPage + 2) {
        html += `<span class="page-ellipsis">...</span>`;
      }
    }

    html += `
      <button class="btn-page" ${currentPage >= totalPages - 1 ? 'disabled' : ''} onclick="goToPage(${currentPage + 1})">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    `;

    controls.innerHTML = html;
  }

  // 更新统计
  function updateStats(total) {
    document.getElementById('stat-total').textContent = total;
  }

  // 加载文章统计
  async function loadArticleStats() {
    try {
      const token = getToken();
      if (!token) return;

      const response = await fetch(`${API_BASE_URL}/api/admin/articles/stats`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (response.status === 403) {
        console.log('Token expired or invalid');
        return;
      }

      if (!response.ok) throw new Error('加载统计失败');

      const result = await response.json();
      if (result.code === 200) {
        const stats = result.data;
        document.getElementById('stat-total').textContent = stats.total || 0;
        document.getElementById('stat-published').textContent = stats.published || 0;
        document.getElementById('stat-draft').textContent = stats.draft || 0;
      }
    } catch (error) {
      console.error('加载文章统计失败:', error);
    }
  }

  // 跳转到指定页
  function goToPage(page) {
    if (page < 0 || page >= totalPages) return;
    currentPage = page;
    loadArticles();
  }

  // 检查同步状态
  async function checkSyncStatus() {
    try {
      const token = getToken();
      if (!token) return;

      const response = await fetch(`${API_BASE_URL}/api/admin/articles/sync/check`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (response.status === 403) {
        console.log('Token expired or invalid');
        return;
      }

      if (!response.ok) return;

      const result = await response.json();
      if (result.code === 200 && result.data.syncNeeded) {
        document.getElementById('sync-alert')?.classList.remove('hidden');
        document.getElementById('sync-alert-text').textContent = result.data.message;
      }

      // 检查冲突
      const conflictResponse = await fetch(`${API_BASE_URL}/api/admin/articles/sync/conflicts`, {
        headers: { 'Authorization': `Bearer ${getToken()}` }
      });

      if (conflictResponse.ok) {
        const conflictResult = await conflictResponse.json();
        if (conflictResult.code === 200) {
          document.getElementById('stat-conflicts').textContent = conflictResult.data.count || 0;
        }
      }
    } catch (error) {
      console.error('检查同步状态失败:', error);
    }
  }

  // 触发同步
  async function triggerSync() {
    try {
      const response = await fetch(`${API_BASE_URL}/api/admin/articles/sync/trigger`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${getToken()}` }
      });

      if (!response.ok) throw new Error('同步失败');

      const result = await response.json();
      showNotification(result.message || '同步已启动', 'success');
      dismissSyncAlert();

      // 延迟刷新
      setTimeout(() => {
        loadArticles();
        checkSyncStatus();
      }, 2000);
    } catch (error) {
      console.error('触发同步失败:', error);
      showNotification('同步失败', 'error');
    }
  }

  // 关闭同步提示
  function dismissSyncAlert() {
    document.getElementById('sync-alert')?.classList.add('hidden');
  }

  // 删除文章
  async function deleteArticle(id) {
    if (!confirm('确定要删除这篇文章吗？此操作不可恢复。')) return;

    try {
      const response = await fetch(`${API_BASE_URL}/api/articles/${id}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${getToken()}` }
      });

      if (!response.ok) throw new Error('删除失败');

      showNotification('删除成功', 'success');
      loadArticles();
    } catch (error) {
      console.error('删除文章失败:', error);
      showNotification('删除失败', 'error');
    }
  }

  // 打开冲突弹窗
  function openConflictModal(articleId, title) {
    currentConflictArticleId = articleId;
    document.getElementById('conflict-article-title').textContent = title;
    document.getElementById('conflict-modal')?.classList.remove('hidden');
  }

  // 关闭冲突弹窗
  function closeConflictModal() {
    document.getElementById('conflict-modal')?.classList.add('hidden');
    currentConflictArticleId = null;
  }

  // 解决冲突
  async function resolveConflict(resolution) {
    if (!currentConflictArticleId) return;

    try {
      const response = await fetch(`${API_BASE_URL}/api/admin/articles/sync/resolve/${currentConflictArticleId}`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${getToken()}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ resolution })
      });

      if (!response.ok) throw new Error('解决冲突失败');

      showNotification('冲突已解决', 'success');
      closeConflictModal();
      loadArticles();
    } catch (error) {
      console.error('解决冲突失败:', error);
      showNotification('解决冲突失败', 'error');
    }
  }

  // 格式化日期
  function formatDate(dateStr) {
    if (!dateStr) return '-';
    const date = new Date(dateStr);
    return date.toLocaleDateString('zh-CN');
  }

  // Lucide 图标 SVG
  const lucideIcons = {
    success: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
    error: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>',
    warning: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
    info: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>',
    rocket: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>',
    trash: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>',
    file: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>'
  };

  // 显示通知
  function showNotification(message, type = 'info') {
    // 人性化提示消息映射
    const humanizedMessages = {
      'success': {
        '同步已启动': { text: '同步已启动，正在扫描文件系统...', icon: 'rocket' },
        '同步成功': { text: '同步完成！文章已更新', icon: 'success' },
        '删除成功': { text: '文章已删除', icon: 'trash' },
        '冲突已解决': { text: '冲突已解决', icon: 'success' },
        '副本创建成功': { text: '副本创建成功', icon: 'file' },
        'success': { text: '操作成功完成', icon: 'success' }
      },
      'error': {
        '同步失败': { text: '同步失败，请检查网络连接或稍后重试', icon: 'error' },
        '删除失败': { text: '删除失败，请稍后重试', icon: 'error' },
        'error': { text: '操作失败，请稍后重试', icon: 'error' }
      },
      'info': {
        'info': { text: message, icon: 'info' }
      },
      'warning': {
        'warning': { text: message, icon: 'warning' }
      }
    };

    // 获取人性化消息
    let displayMessage = message;
    let iconKey = type;
    if (humanizedMessages[type] && humanizedMessages[type][message]) {
      displayMessage = humanizedMessages[type][message].text;
      iconKey = humanizedMessages[type][message].icon;
    }

    // 使用Element Plus或其他通知组件
    if (window.ElMessage) {
      window.ElMessage[type](displayMessage);
    } else {
      // 创建自定义通知元素
      const notification = document.createElement('div');
      notification.className = `custom-notification custom-notification-${type}`;
      notification.innerHTML = `
        <div class="notification-content">
          <span class="notification-icon">${lucideIcons[iconKey] || lucideIcons[type]}</span>
          <span class="notification-message">${displayMessage}</span>
        </div>
      `;
      document.body.appendChild(notification);
      
      // 动画显示
      setTimeout(() => notification.classList.add('show'), 10);
      
      // 3秒后自动移除
      setTimeout(() => {
        notification.classList.remove('show');
        setTimeout(() => notification.remove(), 300);
      }, 3000);
    }
  }

  // 当前打开的菜单关联的文章ID
  let currentMenuArticleId = null;

  // 切换更多菜单
  function toggleMoreMenu(articleId, event) {
    event.stopPropagation();
    
    const menu = document.getElementById('global-more-menu');
    const btn = event.currentTarget;
    
    // 如果点击的是同一个按钮，则关闭菜单
    if (currentMenuArticleId === articleId && !menu.classList.contains('hidden')) {
      closeAllMenus();
      return;
    }
    
    currentMenuArticleId = articleId;
    
    // 获取按钮位置
    const rect = btn.getBoundingClientRect();
    
    // 设置菜单位置（在按钮下方，右对齐）
    menu.style.position = 'fixed';
    menu.style.top = `${rect.bottom + 4}px`;
    menu.style.left = `${rect.right - 200}px`; // 菜单宽度200px，右对齐
    menu.style.zIndex = '9999';
    
    // 显示菜单
    menu.classList.remove('hidden');
    
    // 绑定菜单项点击事件
    document.getElementById('menu-edit').onclick = () => editArticle(articleId);
    document.getElementById('menu-view').onclick = () => viewArticle(articleId);
    document.getElementById('menu-duplicate').onclick = () => duplicateArticle(articleId);
    document.getElementById('menu-delete').onclick = () => deleteArticle(articleId);
  }

  // 关闭所有菜单
  function closeAllMenus() {
    const menu = document.getElementById('global-more-menu');
    menu.classList.add('hidden');
    currentMenuArticleId = null;
  }

  // 编辑文章
  function editArticle(id) {
    closeAllMenus();
    // 从文章数据中获取 slug（使用 == 进行类型转换比较）
    const article = articles.find(a => a.id == id);
    if (article && article.slug) {
      window.location.href = `/admin/articles/${encodeURIComponent(article.slug)}`;
    } else {
      // 如果没有 slug，使用 id 作为备选
      window.location.href = `/admin/articles/${encodeURIComponent(id)}`;
    }
  }

  // 查看文章
  function viewArticle(id) {
    closeAllMenus();
    window.open(`/articles/${id}`, '_blank');
  }

  // 创建副本
  async function duplicateArticle(id) {
    closeAllMenus();
    if (!confirm('确定要创建这篇文章的副本吗？')) return;

    try {
      const response = await fetch(`${API_BASE_URL}/api/admin/articles/${id}/duplicate`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${getToken()}` }
      });

      if (!response.ok) throw new Error('创建副本失败');

      showNotification('副本创建成功', 'success');
      loadArticles();
    } catch (error) {
      console.error('创建副本失败:', error);
      showNotification('创建副本失败', 'error');
    }
  }

  // 点击外部关闭菜单
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.more-btn') && !e.target.closest('.more-menu')) {
      closeAllMenus();
    }
  });
  
  // 滚动时关闭菜单
  window.addEventListener('scroll', closeAllMenus, true);
  window.addEventListener('resize', closeAllMenus);

  // 将函数挂载到 window 对象，使 HTML onclick 可以访问
  window.triggerSync = triggerSync;
  window.checkSyncStatus = checkSyncStatus;
  window.dismissSyncAlert = dismissSyncAlert;
  window.deleteArticle = deleteArticle;
  window.openConflictModal = openConflictModal;
  window.closeConflictModal = closeConflictModal;
  window.resolveConflict = resolveConflict;
  window.goToPage = goToPage;
  window.toggleMoreMenu = toggleMoreMenu;
  window.closeAllMenus = closeAllMenus;
  window.editArticle = editArticle;
  window.viewArticle = viewArticle;
  window.duplicateArticle = duplicateArticle;
</script>

