# 生产环境配置示例
# 部署时复制此文件为 .env.production 并修改以下配置

# API 配置 - 部署时改为实际的后端地址
# 如果前端和后端部署在同一域名下，使用相对路径 /api
# 如果前端和后端分开部署，使用完整的后端地址如 https://api.yourdomain.com
PUBLIC_API_URL=/api

# 站点配置
PUBLIC_SITE_URL=https://yourdomain.com
PUBLIC_SITE_NAME=LuomiBlog
PUBLIC_SITE_DESCRIPTION=AI-powered knowledge base blog

# AI 配置
PUBLIC_AI_ENABLED=true
PUBLIC_AI_MAX_QUESTIONS_PER_MINUTE=5

# 功能开关
PUBLIC_COMMENTS_ENABLED=true
PUBLIC_LIKES_ENABLED=true
PUBLIC_SHARE_ENABLED=true
