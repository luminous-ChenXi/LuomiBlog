# ============================================================
# LuomiBlog 后端环境变量模板
# 说明：Spring Boot 不直接读取 .env 文件——本地开发通过 IDE 运行配置或
# export 注入，生产通过部署面板/容器的环境变量注入。所有变量在
# application.yml 中均有安全默认值，不配置任何内容时行为与默认一致。
# 完整说明见 docs/chenxi-integration.md 配置总表。
# ============================================================

# ---- 辰汐通行证登录（标准 OIDC 授权码 + PKCE，公共客户端，无任何密钥）----
# 总开关（默认 false；关闭时本地账号登录行为与未集成时完全一致）
CHENXI_ENABLED=false
# 主站通行证 issuer（OIDC 签发方地址，启用前必填，如 https://passport.example.com）
CHENXI_ISSUER=
# 在通行证侧注册的客户端 ID（公共客户端只有 ID 没有密钥，如 luomiblog-web）
CHENXI_CLIENT_ID=
# 授权回调地址（必须与通行证侧注册的 redirect_uri 逐字符一致，如 http://localhost:4321/auth/chenxi）
CHENXI_REDIRECT_URI=
# 授权范围（逗号分隔，后端统一规范化为空格分隔再下发）
CHENXI_SCOPES=openid,profile
# 本站会话令牌不活动过期天数（滑动刷新：活跃使用自动续期）
CHENXI_ACCESS_TOKEN_DAYS=30
# 辰汐通行证注册页地址（留空时由 issuer 推导为 {issuer}/register，供登录界面注册引导使用）
CHENXI_REGISTER_URL=

# ---- 正版授权校验（N2 占位骨架，保持注释占位）----
# CHENXI_LICENSE_ENABLED=false
# CHENXI_LICENSE_VERIFY_URL=
# CHENXI_LICENSE_CACHE_DAYS=7
# CHENXI_LICENSE_OFFLINE_GRACE_DAYS=3

# ---- 统计上报（N2 占位骨架，保持注释占位）----
# CHENXI_STATS_ENABLED=false
# CHENXI_STATS_REPORT_URL=

# ---- 配置治理（可按环境覆盖，不配置时与 application.yml 默认值一致）----
# JPA DDL 模式（默认 update 维持现状；生产建议 validate，
# 避免 Hibernate 抢建表与 db/schema.sql 双源竞争——见 BUGLIST BUG-086）
JPA_DDL_AUTO=update
# Swagger/OpenAPI 文档匿名放行（默认 true 维持现状；生产建议 false）
SWAGGER_PERMIT_ALL=true
